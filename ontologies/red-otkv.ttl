
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ont: <http://example.org/ontology#> .

<http://example.org/ontology> a owl:Ontology ;
    rdfs:comment "An ontology to assess and analyze the impact of market-moving events, the parties involved, and their subsequent effects. This version has been refactored for clarity and consistency." .

#################################################################
#    Annotation Properties
#################################################################

# Annotation properties are implicitly declared by their use. No custom annotation properties were defined in this ontology.

#################################################################
#    Object Properties
#################################################################

ont:acquires a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the act of one company purchasing another company or its assets, a significant market event." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:affects a owl:ObjectProperty ;
    rdfs:comment "Indicates that an event, condition, factor, or problem has a direct and significant influence on an entity or outcome. Synthesized from 'affects' and 'impacts'." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CausalFactor
            ont:Problem
            ont:Situation
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Agent
            ont:CampaignEffectiveness
            ont:MarketingBudget
        )
    ] ;
    owl:inverseOf ont:isAffectedBy .

ont:affectsCompany a owl:ObjectProperty ;
    rdfs:comment "Indicates that a trend or event has a direct influence or impact on a specific business enterprise." ;
    rdfs:domain ont:Trend ;
    rdfs:range ont:Company ;
    rdfs:subPropertyOf ont:affects .

ont:aimsToCreateMarketplaceFor a owl:ObjectProperty ;
    rdfs:comment "Specifies a category of items (e.g., goods, ideas) that a business strategy intends to facilitate the exchange of." ;
    rdfs:domain ont:BusinessStrategy ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Good
            ont:Idea
            ont:Opportunity
            ont:Service
        )
    ] .

ont:aimsToMaintain a owl:ObjectProperty ;
    rdfs:comment "Indicates that a strategic action is intended to preserve a specific market standing or advantage." ;
    rdfs:domain ont:BusinessStrategy ;
    rdfs:range ont:MarketPosition .

ont:aimsToStop a owl:ObjectProperty ;
    rdfs:comment "Represents the objective of a legal action to prevent a specific event, such as a merger, from proceeding." ;
    rdfs:domain ont:LegalAction ;
    rdfs:range ont:Merger .

ont:alleges a owl:ObjectProperty ;
    rdfs:comment "Represents the act of asserting a claim or accusation within a legal complaint that has not yet been proven." ;
    rdfs:domain ont:LawsuitFiling ;
    rdfs:range ont:Type .

ont:allegesSubstance a owl:ObjectProperty ;
    rdfs:comment "Represents the assertion made in a legal claim, typically regarding the presence of a harmful element." ;
    rdfs:domain ont:ClassActionLawsuit ;
    rdfs:range ont:ChemicalSubstance .

ont:announces a owl:ObjectProperty ;
    rdfs:comment "The act of a company making a formal public declaration about an event, such as a promotion or organizational change." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Event .

ont:appoints a owl:ObjectProperty ;
    rdfs:comment "Represents the act of assigning a person to a specific leadership role as a direct consequence of a corporate event." ;
    rdfs:domain ont:CorporateEvent ;
    rdfs:range ont:Person .

ont:approves a owl:ObjectProperty ;
    rdfs:comment "Signifies the act of giving official permission or sanction for a proposed market-moving event." ;
    rdfs:domain ont:RegulatoryApproval ;
    rdfs:range ont:Acquisition .

ont:barsCommunicationFrom a owl:ObjectProperty ;
    rdfs:comment "Legally prohibits or restricts an entity from engaging in contact or correspondence." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:GovernmentAgency .

ont:benefits a owl:ObjectProperty ;
    rdfs:comment "Indicates that a particular market trend, economic condition, or outcome has a positive financial or strategic effect on an entity." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:EconomicTrend
            ont:WealthCreation
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Person
        )
    ] .

ont:calculates a owl:ObjectProperty ;
    rdfs:comment "The act of determining a value or standard through a formal testing or computational procedure." ;
    rdfs:domain ont:GovernmentAgency ;
    rdfs:range ont:Allegation .

ont:canBeLeveragedFor a owl:ObjectProperty ;
    rdfs:comment "Indicates that a tool or technology can be utilized to carry out a specific activity or achieve a particular outcome." ;
    rdfs:domain ont:Technology ;
    rdfs:range ont:Problem .

ont:canSubmit a owl:ObjectProperty ;
    rdfs:comment "Denotes the eligibility or ability to file a specific type of official document." ;
    rdfs:domain ont:Role ;
    rdfs:range ont:Document .

ont:causes a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates a direct causal progression where one event, action, or state results in a subsequent outcome or entity's success. Canonical property for causality, replacing 'leadsTo'." ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ont:isCausedBy .

ont:challenges a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:comment "Represents the act of formally disputing or opposing an official action or decision." ;
    rdfs:domain ont:LegalAction ;
    rdfs:range ont:Event .

ont:collaboratesWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates a joint effort or partnership to achieve a common goal, such as producing a report." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Agent .

ont:competesIn a owl:ObjectProperty ;
    rdfs:comment "Indicates participation in a specific sporting event or competition." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:SportingEvent .

ont:concerns a owl:ObjectProperty ;
    rdfs:comment "Indicates the subject matter or the entities affected by a legal action or ruling." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:EntityTypeRole .

ont:concernsRelationshipType a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject matter pertains to a specific kind of interaction or association between entities." ;
    rdfs:domain ont:GuidanceIssuance ;
    rdfs:range ont:FintechCompany ;
    rdfs:subPropertyOf ont:pertainsTo .

ont:concernsServiceType a owl:ObjectProperty ;
    rdfs:comment "Specifies the category of professional service that is the subject of a business agreement." ;
    rdfs:domain ont:BusinessDeal ;
    rdfs:range ont:Service .

ont:conducts a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity was the agent or actor responsible for carrying out a specific event, such as a round of layoffs." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Layoff .

ont:contains a owl:ObjectProperty ;
    rdfs:comment "Indicates that a document or filing includes specific information, arguments, or data within it." ;
    rdfs:domain ont:Document ;
    rdfs:range ont:AbstractConcept .

ont:containsEntityType a owl:ObjectProperty ;
    rdfs:comment "Indicates that a geographical area is characterized by the presence of a certain class of places, such as rural areas." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range ont:Place .

ont:contributesTo a owl:ObjectProperty ;
    rdfs:comment "Represents the act of providing expertise, writing, or research for inclusion in a collective work." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Publication ;
    owl:inverseOf ont:hasContributor .

ont:creditsWithTurnaroundOf a owl:ObjectProperty ;
    rdfs:comment "Represents the attribution of a successful brand or business revitalization to an individual's leadership, a key factor in assessing their impact." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Brand .

ont:developsProductType a owl:ObjectProperty ;
    rdfs:comment "Indicates the creation and marketing of a general category of products, which is a core business activity impacting market position." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Product .

ont:didEmploy a owl:ObjectProperty ;
    rdfs:comment "Represents a past employment relationship where an organization employed an individual. The inverse of wasEmployedBy." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Person ;
    owl:inverseOf ont:wasEmployedBy .

ont:directs a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual with creative control and responsibility for guiding the making of a film." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Film .

ont:doesNotOffer a owl:ObjectProperty ;
    rdfs:comment "Signifies the explicit lack of a particular product or service." ;
    rdfs:domain ont:Bank ;
    rdfs:range ont:Cryptocurrency .

ont:employs a owl:ObjectProperty ;
    rdfs:comment "Signifies the relationship where an organization provides a job to an individual." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Person ;
    owl:inverseOf ont:isEmployedBy .

ont:encountersProblemWith a owl:ObjectProperty ;
    rdfs:comment "Signifies that an action or process faced an obstacle or conflict with an external entity or its rules." ;
    rdfs:domain ont:Rebranding ;
    rdfs:range ont:DigitalDistributionPlatform .

ont:establishesRole a owl:ObjectProperty ;
    rdfs:comment "Signifies the creation of a specific function or position as a direct result of a legal agreement or action." ;
    rdfs:domain ont:LegalSettlement ;
    rdfs:range ont:Role .

ont:executes a owl:ObjectProperty ;
    rdfs:comment "Represents the completion of a planned financial action or transaction." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:FinancialTransaction .

ont:experiences a owl:ObjectProperty ;
    rdfs:comment "Signifies that a person or entity underwent a particular event, condition or change in their life or operations." ;
    rdfs:domain ont:Agent ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Metric
            ont:Situation
        )
    ] .

ont:filesDisputeAgainst a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the formal initiation of a legal or regulatory complaint by one party against another." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company ;
    owl:inverseOf ont:hasDefendant .

ont:follows a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that one event occurred sequentially after another, suggesting a potential causal or temporal link." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Event ;
    owl:inverseOf ont:precedes .

ont:formerlyHoldsRole a owl:ObjectProperty ;
    rdfs:comment "Indicates a professional position that an individual occupied in the past. Canonical property for past roles, replacing 'hasFormerRole' and 'previouslyHoldsRole'." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Role .

ont:focusOf a owl:ObjectProperty ;
    rdfs:comment "Inverse of isFocusedOn. Indicates that an entity is the focus of a particular action or event." ;
    rdfs:domain owl:Thing ;
    rdfs:range ont:Event ;
    owl:inverseOf ont:isFocusedOn .

ont:founds a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the act of establishing or creating an organization. Canonical property for founding, replacing 'creates', 'coFounds', 'isFounderOf', etc." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Organization .

ont:funds a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the act of providing money generated from one activity to support or finance another, often illicit, activity." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Crime
            ont:Problem
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:OrganizedCrime
            ont:TangibleCrime
        )
    ] .

ont:graduatesFrom a owl:ObjectProperty ;
    rdfs:comment "Specifies the educational institution from which a person received a degree." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:AcademicInstitution .

ont:hadKeynoteSpeaker a owl:ObjectProperty ;
    rdfs:comment "Identifies the main or featured speaker at an event." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Person .

ont:hadNoImpactOn a owl:ObjectProperty ;
    rdfs:comment "Indicates that a specific event or action did not cause any discernible change in a particular outcome or metric." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:RiderAppInstall .

ont:hasAcquired a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the company that is being purchased or taken over in an acquisition." ;
    rdfs:domain ont:Acquisition ;
    rdfs:range ont:Company ;
    owl:inverseOf ont:isTargetOfAcquisition .

ont:hasAcquirer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the person or entity that gains control or is purchasing in a corporate takeover or acquisition." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Acquisition
            ont:CorporateTakeover
        )
    ] ;
    rdfs:range ont:Agent ;
    owl:inverseOf ont:isAcquirerInAcquisition .

ont:hasAlumnaOf a owl:ObjectProperty ;
    rdfs:comment "Signifies that an individual has graduated from or formerly attended an educational institution." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:AcademicInstitution .

ont:hasAppointee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the individual who is the subject of an appointment to a role." ;
    rdfs:domain ont:Appointment ;
    rdfs:range ont:Person ;
    rdfs:subPropertyOf ont:hasParticipant .

ont:hasAppointmentEvent a owl:ObjectProperty ;
    rdfs:comment "Signifies that a significant leadership hiring event has occurred." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Appointment .

ont:hasApprover a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the official entity that granted permission or authorization for an action." ;
    rdfs:domain ont:Approval ;
    rdfs:range ont:RegulatoryBody .

ont:hasArrestee a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual who has been taken into legal custody." ;
    rdfs:domain ont:Arrest ;
    rdfs:range ont:Person .

ont:hasArtist a owl:ObjectProperty ;
    rdfs:comment "Identifies the performing individual or group associated with a creative work or event." ;
    rdfs:domain ont:ConcertTour ;
    rdfs:range ont:Person .

ont:hasAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the tangible or intangible property that is possessed." ;
    rdfs:domain ont:Ownership ;
    rdfs:range ont:SportsTeam .

ont:hasAssetType a owl:ObjectProperty ;
    rdfs:comment "Indicates ownership or control of a specific category of valuable resources or technology." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Infrastructure .

ont:hasBusinessUnit a owl:ObjectProperty ;
    rdfs:comment "Specifies a distinct operational division within a larger corporate entity." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessUnit .

ont:hasBuyer a owl:ObjectProperty ;
    rdfs:comment "Identifies the purchasing party in a corporate acquisition event." ;
    rdfs:domain ont:CorporateAcquisition ;
    rdfs:range ont:PrivateEquityFirm .

ont:hasChild a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Denotes the parental relationship of having a son or daughter." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:hasChildren a owl:ObjectProperty ;
    rdfs:comment "Denotes the parental relationship of having one or more offspring." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:GroupOfPeople .

ont:hasClient a owl:ObjectProperty ;
    rdfs:comment "Identifies the organization receiving services under a consulting agreement." ;
    rdfs:domain ont:Agreement ;
    rdfs:range ont:Organization .

ont:hasConsultant a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual providing expert services under a consulting agreement." ;
    rdfs:domain ont:Agreement ;
    rdfs:range ont:Person .

ont:hasContributor a owl:ObjectProperty ;
    rdfs:comment "Identifies an individual or entity that provided content, expertise or information to a project, publication or report." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Contribution
            ont:Publication
        )
    ] ;
    rdfs:range ont:Agent ;
    rdfs:subPropertyOf ont:hasParticipant ;
    owl:inverseOf ont:contributesTo .

ont:hasCourthouseIn a owl:ObjectProperty ;
    rdfs:comment "Specifies the city where a judge's official court is located." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:City .

ont:hasCustomer a owl:ObjectProperty ;
    rdfs:comment "Indicates a commercial relationship where one entity purchases goods or services from another." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:UtilityCompany .

ont:hasDataSource a owl:ObjectProperty ;
    rdfs:comment "Identifies the origin or provider of a specific set of data or analytics." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:FinancialMetric
            ont:UserEngagementMetric
        )
    ] ;
    rdfs:range ont:Organization .

ont:hasDefendant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the party being sued or accused in a legal dispute." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Indictment
            ont:Lawsuit
            ont:LawsuitFiling
        )
    ] ;
    rdfs:range ont:Agent ;
    rdfs:subPropertyOf ont:hasParticipant ;
    owl:inverseOf ont:filesDisputeAgainst .

ont:hasDeliberation a owl:ObjectProperty ;
    rdfs:comment "Indicates that a formal process of consideration and discussion is being undertaken." ;
    rdfs:domain ont:GovernmentBody ;
    rdfs:range ont:Deliberation .

ont:hasDepartingPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the individual who is the subject of a departure event." ;
    rdfs:domain ont:Departure ;
    rdfs:range ont:Person .

ont:hasDepartureEvent a owl:ObjectProperty ;
    rdfs:comment "Signifies that a significant leadership exit event has occurred." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Departure .

ont:hasEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the individual who is engaged in an employment relationship." ;
    rdfs:domain ont:Employment ;
    rdfs:range ont:Person ;
    owl:inverseOf ont:hasEmploymentHistory .

ont:hasEmployeeCountExcluding a owl:ObjectProperty ;
    rdfs:comment "Specifies a subsidiary or affiliate whose employees are not included in a reported total headcount." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:hasEmployer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the organization that provides employment." ;
    rdfs:domain ont:Employment ;
    rdfs:range ont:Organization .

ont:hasEmploymentHistory a owl:ObjectProperty ;
    rdfs:comment "Associates a person with their past or present period of employment." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Employment ;
    owl:inverseOf ont:hasEmployee .

ont:hasExtraditedPerson a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual who is the subject of a formal transfer between jurisdictions for legal prosecution." ;
    rdfs:domain ont:Extradition ;
    rdfs:range ont:Person .

ont:hasFeature a owl:ObjectProperty ;
    rdfs:comment "Indicates that a product or platform includes a specific functionality or component." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:DigitalWallet .

ont:hasFinancing a owl:ObjectProperty ;
    rdfs:comment "Specifies that an entity has been the recipient of a formal investment round." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:Financing .

ont:hasFinancialMetric a owl:ObjectProperty ;
    rdfs:comment "The association of a specific performance indicator with an entity or event." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Brand
            ont:Company
            ont:CorporateEvent
        )
    ] ;
    rdfs:range ont:FinancialMetric .

ont:hasFinancialReport a owl:ObjectProperty ;
    rdfs:comment "Associates a company with its formal statement of financial performance for a given period." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:FinancialReport .

ont:hasFiredPerson a owl:ObjectProperty ;
    rdfs:comment "Identifies an individual who was dismissed from their position during a corporate restructuring or firing event." ;
    rdfs:domain ont:FiringEvent ;
    rdfs:range ont:Person .

ont:hasFounder a owl:ObjectProperty ;
    rdfs:comment "Identifies an individual who was instrumental in the creation of an organization." ;
    rdfs:domain ont:Founding ;
    rdfs:range ont:Person .

ont:hasFutureRolePreference a owl:ObjectProperty ;
    rdfs:comment "Indicates a desired future professional function or position." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Role .

ont:hasGranddaughterOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the specific familial relationship of being the daughter of one's child." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:hasHearing a owl:ObjectProperty ;
    rdfs:comment "Specifies a formal legal proceeding associated with a legal action." ;
    rdfs:domain ont:LegalSettlement ;
    rdfs:range ont:LegalHearing .

ont:hasInvestor a owl:ObjectProperty ;
    rdfs:comment "Identifies an entity that has provided capital during a financing event." ;
    rdfs:domain ont:Financing ;
    rdfs:range ont:InvestmentFirm .

ont:hasNewIdentity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Indicates the new name or form that an entity assumes following a change event like a rebranding." ;
    rdfs:domain ont:Rebranding ;
    rdfs:range ont:SocialMediaPlatform .

ont:hasObstacleRelatedTo a owl:ObjectProperty ;
    rdfs:comment "Identifies a specific group or issue that presents a challenge or complication to the implementation of a policy." ;
    rdfs:domain ont:GovernmentProgram ;
    rdfs:range ont:Demonym .

ont:hasOversightOf a owl:ObjectProperty ;
    rdfs:comment "Indicates responsibility for supervising or managing a specific corporate function or area of practice." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:AbstractConcept .

ont:hasOwner a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the individual or entity that has legal possession." ;
    rdfs:domain ont:Ownership ;
    rdfs:range ont:Person ;
    owl:inverseOf ont:hasOwnership .

ont:hasOwnership a owl:ObjectProperty ;
    rdfs:comment "Indicates the state of possessing a significant asset." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Ownership ;
    owl:inverseOf ont:hasOwner .

ont:hasParticipant a owl:ObjectProperty ;
    rdfs:comment "Identifies a key individual, company or party actively involved in a business deal, transaction or event. Canonical property for participation, replacing 'involvedParty', 'involvesCompany', etc." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:FundingRound
        )
    ] ;
    rdfs:range ont:Agent .

ont:hasPartner a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates a formal business relationship or alliance for mutual benefit, such as for advertising or retail distribution." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Organization .

ont:hasPerformanceMetric a owl:ObjectProperty ;
    rdfs:comment "Links an entity to a specific measure of its operational success or activity." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:PerformanceMetric .

ont:hasPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Associates a specific individual with an event concerning them, like a resignation." ;
    rdfs:domain ont:Resignation ;
    rdfs:range ont:Person .

ont:hasPlaintiff a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the party that initiates a lawsuit or formal complaint in a legal dispute." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range ont:Agent .

ont:hasPlaintiffRole a owl:ObjectProperty ;
    rdfs:comment "Specifies the official legal capacity of the party initiating a lawsuit." ;
    rdfs:domain ont:LegalProceeding ;
    rdfs:range ont:Role .

ont:hasPlaintiffType a owl:ObjectProperty ;
    rdfs:comment "Specifies the general classification of the party initiating a lawsuit." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Lawsuit
            ont:LawsuitFiling
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:DemographicGroup
            ont:Fan
        )
    ] .

ont:hasPositionIn a owl:ObjectProperty ;
    rdfs:comment "Signifies ownership of a financial stake, such as stock, in a particular company." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:hasPotentialDefendant a owl:ObjectProperty ;
    rdfs:comment "Identifies the party that is the target of a prospective or anticipated lawsuit." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range ont:Company ;
    rdfs:subPropertyOf ont:isFocusedOn .

ont:hasPotentialImpactOn a owl:ObjectProperty ;
    rdfs:comment "Indicates that an event or action could influence or affect a particular program, policy, or entity." ;
    rdfs:domain ont:Indictment ;
    rdfs:range ont:GovernmentProgram .

ont:hasPotentialPlaintiff a owl:ObjectProperty ;
    rdfs:comment "Identifies the party that is considering or expected to initiate a lawsuit." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range ont:GovernmentAgency .

ont:hasPotentialRisk a owl:ObjectProperty ;
    rdfs:comment "Associates a technology or process with a possible danger or adverse outcome." ;
    rdfs:domain ont:Technology ;
    rdfs:range ont:Hazard .

ont:hasRule a owl:ObjectProperty ;
    rdfs:comment "Associates a platform with a specific regulation or guideline it enforces." ;
    rdfs:domain ont:DigitalDistributionPlatform ;
    rdfs:range ont:PlatformRule .

ont:hasStatedConcern a owl:ObjectProperty ;
    rdfs:comment "Links an investigation to a specific market category or type of entity where potential negative impacts are a concern." ;
    rdfs:domain ont:Investigation ;
    rdfs:range owl:Thing .

ont:hasStore a owl:ObjectProperty ;
    rdfs:comment "Indicates the presence of a specific retail establishment within a geographic location." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range ont:RetailEstablishment .

ont:hasSubsidiary a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that one company is owned or controlled by another parent company." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company ;
    rdfs:subPropertyOf ont:owns ;
    owl:inverseOf ont:isSubsidiaryOf .

ont:hasUser a owl:ObjectProperty ;
    rdfs:comment "Indicates that an organization utilizes a specific product or service for its operations." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:hasUserEngagementMetric a owl:ObjectProperty ;
    rdfs:comment "Associates a company or product with a specific indicator of user activity and interaction." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:UserEngagementMetric .

ont:hasVicePresidentOf a owl:ObjectProperty ;
    rdfs:comment "Designates a person holding a senior executive rank below the president or CEO in a company." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Company .

ont:highlights a owl:ObjectProperty ;
    rdfs:comment "The act of bringing special attention to or emphasizing a particular subject or finding." ;
    rdfs:domain ont:Report ;
    rdfs:range ont:Algorithm .

ont:holdsRole a owl:ObjectProperty ;
    rdfs:comment "Indicates the current or past occupancy of a formal position or title. Canonical property for holding a role, replacing 'holdsPosition' and 'hasRole'." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Role ;
    owl:inverseOf ont:roleHeldBy .

ont:holdsRoleAt a owl:ObjectProperty ;
    rdfs:comment "Specifies the organization where a particular role is held." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:NationalGoverningBody ;
    rdfs:subPropertyOf ont:holdsRole .

ont:identifiesIssue a owl:ObjectProperty ;
    rdfs:comment "Represents the act of recognizing and pointing out a specific problem or challenge." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Problem .

ont:implements a owl:ObjectProperty ;
    rdfs:comment "Indicates that a company is putting a specific business plan or strategy into action." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessStrategy .

ont:includes a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that a broader trend, concept or event encompasses a more specific one as a component." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Trend
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:WorkModel
        )
    ] ;
    rdfs:subPropertyOf ont:isPartOf .

ont:includesBrand a owl:ObjectProperty , owl:IrreflexiveProperty , owl:TransitiveProperty ;
    rdfs:comment "Indicates that a larger brand portfolio contains a specific, smaller brand line." ;
    rdfs:domain ont:Brand ;
    rdfs:range ont:Brand .

ont:includesCharge a owl:ObjectProperty ;
    rdfs:comment "Specifies a formal accusation of a crime contained within a legal document like an indictment." ;
    rdfs:domain ont:Indictment ;
    rdfs:range ont:CriminalCharge .

ont:includesIndex a owl:ObjectProperty ;
    rdfs:comment "Signifies that a broader market's performance incorporates the results of a specific stock index." ;
    rdfs:domain ont:MarketMovement ;
    rdfs:range ont:StockIndex .

ont:initiates a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the act of starting or causing a formal process, such as a product recall or a regulatory review." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Person
            ont:RegulatoryBody
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:GovernmentHearing
            ont:Investigation
            ont:ProductRecall
        )
    ] .

ont:investigates a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the act of conducting a formal inquiry into a specific event or transaction." ;
    rdfs:domain ont:Investigation ;
    rdfs:range ont:Merger .

ont:investsIn a owl:ObjectProperty ;
    rdfs:comment "Represents the act of committing financial resources to develop a specific area or asset class." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:CyclingInfrastructure .

ont:involvesAcquirer a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the company that is purchasing or taking over another company." ;
    rdfs:domain ont:Merger ;
    rdfs:range ont:Company .

ont:involvesEntityType a owl:ObjectProperty ;
    rdfs:comment "Specifies a general category of participant involved in a scheme or event." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range ont:CoConspirator .

ont:involvesFraudulentUseOf a owl:ObjectProperty ;
    rdfs:comment "Indicates the misuse or misrepresentation of a specific document or instrument as part of a criminal scheme." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range ont:Visa .

ont:involvesObject a owl:ObjectProperty ;
    rdfs:comment "Identifies a physical or digital object that is a central component of an event." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:InformationEntity .

ont:involvesTarget a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the company that is being purchased or taken over." ;
    rdfs:domain ont:Merger ;
    rdfs:range ont:Company .

ont:involvedTour a owl:ObjectProperty ;
    rdfs:comment "Associates a specific event with the concert series it relates to." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:ConcertTour .

ont:isASolutionFor a owl:ObjectProperty ;
    rdfs:comment "Indicates that a product, standard, or methodology is designed to address or mitigate a specific problem." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Publication
            ont:Solution
        )
    ] ;
    rdfs:range ont:Problem ;
    owl:inverseOf ont:isAddressedBy .

ont:isATypeOf a owl:ObjectProperty ;
    rdfs:comment "Represents a classification or categorization used to understand an entity's role in the market." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:AdFraudTechnique
            ont:Company
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:FortuneFiveHundredCompany
            ont:OnlineBikeRetailer
            ont:Problem
        )
    ] .

ont:isATopDragOn a owl:ObjectProperty ;
    rdfs:comment "Identifies a specific entity whose poor performance was a primary contributor to a negative market movement." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:MarketMovement .

ont:isAbout a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject matter or central theme is a particular person, event, or topic." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Allegation
            ont:Film
            ont:Observation
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:EconomicTrend
            ont:Person
        )
    ] .

ont:isAcquirerInAcquisition a owl:ObjectProperty ;
    rdfs:comment "Indicates which acquisition a company is the actor of. Renamed from isAcquirerIn for clarity." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Acquisition ;
    owl:inverseOf ont:hasAcquirer .

ont:isActionOf a owl:ObjectProperty ;
    rdfs:comment "Attributes a specific action or policy change to the entity that enacted it." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:FinancialConcept
        )
    ] ;
    rdfs:range ont:Agent .

ont:isAddressedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that a problem or issue is the subject of a particular solution, guide, or initiative." ;
    rdfs:domain ont:Problem ;
    rdfs:range ont:Publication ;
    owl:inverseOf ont:isASolutionFor .

ont:isAffectedBy a owl:ObjectProperty ;
    rdfs:comment "Shows that a metric or entity's state was influenced by a particular event or condition." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Agent
            ont:Company
            ont:UserEngagementMetric
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:FundingRound
            ont:MarketCondition
            ont:Situation
        )
    ] ;
    owl:inverseOf ont:affects .

ont:isAffiliatedWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents a professional connection or association with an organization, such as a school, company, or media outlet." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Organization
            ont:Person
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Organization
            ont:Podcast
        )
    ] .

ont:isAnalysisBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity responsible for conducting a detailed examination or study." ;
    rdfs:domain ont:Deliberation ;
    rdfs:range ont:GovernmentAgency .

ont:isAppointmentBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the organization responsible for making an appointment." ;
    rdfs:domain ont:Appointment ;
    rdfs:range ont:NationalGoverningBody .

ont:isApprovalBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the governing or regulatory authority that has granted permission." ;
    rdfs:domain ont:RegulatoryApproval ;
    rdfs:range ont:RegulatoryBody .

ont:isApprovalFor a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity that is the recipient of a formal permission or authorization." ;
    rdfs:domain ont:RegulatoryApproval ;
    rdfs:range ont:InvestmentBank .

ont:isAssessmentOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that a piece of analysis or commentary is focused on a specific market event." ;
    rdfs:domain ont:Assessment ;
    rdfs:range ont:Event ;
    owl:inverseOf ont:providesAssessment .

ont:isAssociatedWith a owl:ObjectProperty ;
    rdfs:comment "A general relationship indicating a connection or affiliation, such as an executive's past leadership role at a company." ;
    rdfs:domain ont:Agent ;
    rdfs:range owl:Thing .

ont:isAuditorFor a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:comment "Designates the official role of an external firm in examining and verifying a company's financial accounts." ;
    rdfs:domain ont:AccountingFirm ;
    rdfs:range ont:Company .

ont:isBasedOn a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that an event or action is founded upon or motivated by a preceding claim or assertion." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:AbstractConcept .

ont:isBeneficiaryOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity gains advantage or value from a particular technology or market trend." ;
    rdfs:domain ont:Company ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:CloudTechnology
            ont:GenerativeArtificialIntelligence
        )
    ] .

ont:isBroughtBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual or entity that initiated a formal proceeding, such as a legal challenge." ;
    rdfs:domain ont:LegalAction ;
    rdfs:range ont:Agent .

ont:isBuilding a owl:ObjectProperty ;
    rdfs:comment "Signifies the act of constructing a physical facility, such as a factory." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:Factory .

ont:isCausedBy a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Identifies the root reason, factor or contaminant that triggered a market-moving event like a recall or lawsuit. Inverse of the canonical 'causes' property." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:EconomicTrend
            ont:ProductRecall
            ont:Situation
            ont:Trend
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Bacteria
            ont:CausalFactor
            ont:ChemicalSubstance
            ont:EconomicConcept
            ont:Event
            ont:Policy
        )
    ] ;
    owl:inverseOf ont:causes .

ont:isCenteredOn a owl:ObjectProperty ;
    rdfs:comment "Identifies a core functional pillar or type of interactivity (e.g., audio, video) that is fundamental to a business strategy." ;
    rdfs:domain ont:BusinessStrategy ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Audio
            ont:Banking
            ont:Messaging
            ont:Payment
            ont:Video
        )
    ] .

ont:isCeoOf a owl:ObjectProperty , owl:InverseFunctionalProperty , owl:FunctionalProperty ;
    rdfs:comment "Denotes the position of being the Chief Executive Officer for a specific organization." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Company .

ont:isCitedIn a owl:ObjectProperty ;
    rdfs:comment "Indicates that a piece of information, like a public statement, is being used as supporting evidence or context in a legal document." ;
    rdfs:domain ont:Communication ;
    rdfs:range ont:LawsuitFiling .

ont:isComparedTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents the act of drawing a parallel or contrast between two entities for the purpose of market analysis." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:isCompetitorOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates a state of rivalry where entities vie for the same market share, advertising revenue, or customer attention." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:isComposedOf a owl:ObjectProperty ;
    rdfs:comment "Indicates the constituent members or elements that make up a group." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Group
            ont:OrganizationalBody
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:EliteAthlete
            ont:Person
        )
    ] ;
    owl:inverseOf ont:isMemberOf .

ont:isConductedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the organization or body responsible for carrying out an action or process." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Agent .

ont:isConsequenceOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that an event or action is a direct result or subsequent impact of a prior market-moving event." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Event ;
    rdfs:subPropertyOf ont:follows .

ont:isConsidering a owl:ObjectProperty ;
    rdfs:comment "Represents the state of deliberating or contemplating a future course of action." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Event .

ont:isConnectedBy a owl:ObjectProperty ;
    rdfs:comment "Specifies the infrastructure that links two geographical locations." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range ont:Infrastructure .

ont:isConnectedTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents a physical or logistical link between two geographical locations." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range ont:GeopoliticalEntity .

ont:isCoreTechnologyFor a owl:ObjectProperty ;
    rdfs:comment "Identifies the fundamental enabling technology upon which a product or system is based." ;
    rdfs:domain ont:Technology ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Facility
            ont:Product
        )
    ] .

ont:isCoveredBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that an event is the subject of reporting, analysis, or discussion by a media entity." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Podcast .

ont:isCtoOf a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    rdfs:comment "Specifies that a person holds the position of Chief Technology Officer at an organization." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:InvestmentFirm ;
    rdfs:subPropertyOf ont:holdsRole .

ont:isDecisionOf a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity responsible for making a strategic organizational change." ;
    rdfs:domain ont:OrganizationalChange ;
    rdfs:range ont:Organization .

ont:isDefendantIn a owl:ObjectProperty ;
    rdfs:comment "Identifies the party being sued or accused in a legal action." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:GovernmentBody
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:ClassActionLawsuit
            ont:Lawsuit
        )
    ] .

ont:isDevelopedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates the organization responsible for the research, design, and creation of a technology." ;
    rdfs:domain ont:Technology ;
    rdfs:range ont:Startup .

ont:isDirectedAgainstType a owl:ObjectProperty ;
    rdfs:comment "Specifies the general category of victims or targets of an allegation or action." ;
    rdfs:domain ont:Allegation ;
    rdfs:range ont:Advertiser .

ont:isDivisionOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Indicates that a business unit is a component of a larger parent corporation." ;
    rdfs:domain ont:CompanyDivision ;
    rdfs:range ont:Company .

ont:isDrivenBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the key individual or force responsible for initiating and directing a major event or strategic shift." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Rebranding
        )
    ] ;
    rdfs:range ont:Person .

ont:isDueTo a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates the direct cause or preceding legal action that resulted in an event." ;
    rdfs:domain ont:Arrest ;
    rdfs:range ont:Extradition .

ont:isEarnedBy a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:comment "Specifies the individual who receives a salary as compensation for their work." ;
    rdfs:domain ont:Salary ;
    rdfs:range ont:Person .

ont:isEmployedBy a owl:ObjectProperty ;
    rdfs:comment "Signifies the formal, ongoing professional relationship of working for a specific organization. Canonical property for employment, replacing 'worksFor'." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Organization ;
    owl:inverseOf ont:employs .

ont:isEstimatedBy a owl:ObjectProperty ;
    rdfs:comment "Credits the source organization that produced a particular financial or market forecast or valuation." ;
    rdfs:domain ont:Metric ;
    rdfs:range ont:Organization .

ont:isEventOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Associates a specific occurrence, like an earnings report, with the company it pertains to." ;
    rdfs:domain ont:EarningsReport ;
    rdfs:range ont:Company .

ont:isExpectedAfter a owl:ObjectProperty ;
    rdfs:comment "Represents an anticipation that one event will occur following another, based on analysis or reporting." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Event ;
    rdfs:subPropertyOf ont:follows .

ont:isExtraditionTo a owl:ObjectProperty ;
    rdfs:comment "Specifies the destination jurisdiction to which a person is being legally transferred for trial." ;
    rdfs:domain ont:Extradition ;
    rdfs:range ont:JudicialDistrict .

ont:isFacilityOf a owl:ObjectProperty ;
    rdfs:comment "Denotes that a physical plant or location is operated by a specific company." ;
    rdfs:domain ont:Facility ;
    rdfs:range ont:Company .

ont:isFactorIn a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that one event or initiative was a contributing cause or reason for another subsequent market-moving event." ;
    rdfs:domain ont:BusinessInitiative ;
    rdfs:range ont:Departure .

ont:isFiledIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the legal venue or jurisdiction where a lawsuit has been formally initiated." ;
    rdfs:domain ont:LegalProceeding ;
    rdfs:range ont:Court .

ont:isFiledWith a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the official body or authority to which a document has been formally submitted." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Lawsuit
            ont:LegalDocument
        )
    ] ;
    rdfs:range ont:RegulatoryBody .

ont:isFocusedOn a owl:ObjectProperty ;
    rdfs:comment "Specifies the primary subject, entity, topic, or location that is the focus of an action, event, or inquiry. Canonical property, replacing 'hasTarget', 'targets', and 'isSubjectOf'." ;
    rdfs:domain ont:Event ;
    rdfs:range owl:Thing ;
    owl:inverseOf ont:focusOf .

ont:isForecastFor a owl:ObjectProperty ;
    rdfs:comment "Links a projected financial figure to the company to which it applies." ;
    rdfs:domain ont:FinancialForecast ;
    rdfs:range ont:Company .

ont:isFormerCeoOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that an individual previously held the chief executive position at a company, establishing their expertise." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Company .

ont:isFoundingOf a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:comment "Indicates that an event represents the establishment or creation of a specific company." ;
    rdfs:domain ont:Founding ;
    rdfs:range ont:Company .

ont:isFrom a owl:ObjectProperty ;
    rdfs:comment "Identifies the country of origin or nationality." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Country .

ont:isFueledBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that a trend or phenomenon is intensified or driven by a particular factor." ;
    rdfs:domain ont:EconomicSituation ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:EconomicPolicy
            ont:ForeignInvestment
        )
    ] .

ont:isFutureOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Suggests that one model or concept is expected to evolve from or replace another over time." ;
    rdfs:domain ont:WorkModel ;
    rdfs:range ont:WorkModel .

ont:isGrantedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the authority or body that conferred a permission or approval." ;
    rdfs:domain ont:RegulatoryApproval ;
    rdfs:range ont:RegulatoryAgency .

ont:isGreaterThan a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents a comparative state where one metric's value exceeds another's from a different time period." ;
    rdfs:domain ont:GrowthMetric ;
    rdfs:range ont:GrowthMetric .

ont:isHearingFor a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the legal case that is the subject of a court proceeding." ;
    rdfs:domain ont:CourtHearing ;
    rdfs:range ont:Lawsuit ;
    owl:inverseOf ont:isSubjectOfHearing .

ont:isHeldAt a owl:ObjectProperty ;
    rdfs:comment "Specifies the venue or institution where an event, such as a court hearing, takes place." ;
    rdfs:domain ont:CourtHearing ;
    rdfs:range ont:Court .

ont:isIllustratedBy a owl:ObjectProperty ;
    rdfs:comment "Connects a general trend, factor, or concept to a specific, concrete example that demonstrates it." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:AbstractConcept
            ont:AdFraudTechnique
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Example
            owl:Thing
        )
    ] .

ont:isImplementedOn a owl:ObjectProperty ;
    rdfs:comment "Indicates the successful application or execution of a change on a specific platform." ;
    rdfs:domain ont:Rebranding ;
    rdfs:range ont:DigitalDistributionPlatform .

ont:isIntendedFor a owl:ObjectProperty ;
    rdfs:comment "Specifies the target audience or recipient group for a publication, guidance, or action." ;
    rdfs:domain ont:PublicationEvent ;
    rdfs:range ont:Agent .

ont:isInvestigationOf a owl:ObjectProperty ;
    rdfs:comment "Specifies the subject or target of a formal inquiry into wrongdoing." ;
    rdfs:domain ont:Investigation ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Allegation
            ont:Company
        )
    ] .

ont:isInvestorIn a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity has provided capital to another entity in exchange for an ownership stake." ;
    rdfs:domain ont:InvestmentFirm ;
    rdfs:range ont:Company .

ont:isIssuedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual or authority that formally delivered a ruling, directive or order." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:GuidanceIssuance
            ont:Indictment
            ont:LegalRuling
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:GovernmentAgency
            ont:Person
            ont:Role
        )
    ] .

ont:isLawsuitAgainst a owl:ObjectProperty ;
    rdfs:comment "Identifies the defendant party in a legal proceeding." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range ont:Company .

ont:isLedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the principal individual, group or entity guiding an organization, effort or market." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:CriminalScheme
            ont:Measurement
            ont:Organization
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Family
            ont:Person
            ont:State
        )
    ] .

ont:isLessThan a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents a comparative relationship where one financial report's metrics are quantitatively smaller than another's." ;
    rdfs:domain ont:FinancialReport ;
    rdfs:range ont:FinancialReport .

ont:isLocatedAbove a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Describes a physical positioning where one establishment is situated on a higher floor than another." ;
    rdfs:domain ont:BusinessPremises ;
    rdfs:range ont:BusinessPremises .

ont:isLocatedIn a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Specifies the geographical containment of one entity within a larger area." ;
    rdfs:domain owl:Thing ;
    rdfs:range ont:Place ;
    owl:inverseOf ont:locationOf .

ont:isMemberOf a owl:ObjectProperty ;
    rdfs:comment "Signifies affiliation or belonging to a particular group, organization, or committee." ;
    rdfs:domain ont:Person ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Community
            ont:Court
            ont:OrganizationalBody
            ont:Organization
            ont:SportsTeam
        )
    ] ;
    owl:inverseOf ont:isComposedOf .

ont:isMemberOfParty a owl:ObjectProperty ;
    rdfs:comment "Associates a political figure with their political party affiliation." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:PoliticalRole .

ont:isMentionedIn a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity is referenced or named within the context of a legal proceeding or document." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:SocialMediaPlatform
        )
    ] ;
    rdfs:range ont:Lawsuit .

ont:isMergerOf a owl:ObjectProperty ;
    rdfs:comment "Identifies one of the original companies that combined to form a new, single entity." ;
    rdfs:domain ont:Merger ;
    rdfs:range ont:Company .

ont:isNotRivalOf a owl:ObjectProperty ;
    rdfs:comment "Explicitly states that two entities do not operate in direct competition, often because they serve different market needs." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Technology ;
    owl:propertyDisjointWith ont:isRivalOf .

ont:isObservedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity, typically an analyst or firm, has noted or reported on a particular trend or indicator." ;
    rdfs:domain ont:Indicator ;
    rdfs:range ont:AdvisoryFirm .

ont:isOccurringIn a owl:ObjectProperty ;
    rdfs:comment "Specifies the city or location where a crisis or event is taking place." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Situation
        )
    ] ;
    rdfs:range ont:Place .

ont:isOperatedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the organization responsible for managing and executing a program." ;
    rdfs:domain ont:Plan ;
    rdfs:range ont:Organization .

ont:isOwnerOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that a person owns a product." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Product ;
    owl:inverseOf ont:isOwnedBy .

ont:isOwnedBy a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Signifies that one entity has legal ownership and control over another." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:BusinessLocation
            ont:Company
            ont:Organization
            ont:SocialMediaPlatform
        )
    ] ;
    rdfs:range ont:Agent ;
    rdfs:subPropertyOf ont:isAssociatedWith ;
    owl:inverseOf ont:owns .

ont:isPaidBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual responsible for making a payment." ;
    rdfs:domain ont:Payment ;
    rdfs:range ont:Person .

ont:isPartOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:TransitiveProperty ;
    rdfs:comment "Indicates that an entity is a component of a larger organization or legal process." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Employment
            ont:GovernmentAgency
            ont:GovernmentBody
            ont:LegalRuling
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Government
            ont:GovernmentBody
            ont:Lawsuit
            ont:OrganizationalUnit
        )
    ] .

ont:isPaymentFrom a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the organization that is the source of a monetary or stock-based compensation." ;
    rdfs:domain ont:CompensationMetric ;
    rdfs:range ont:Company .

ont:isPaymentTo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the individual who is the recipient of a monetary or stock-based compensation." ;
    rdfs:domain ont:CompensationMetric ;
    rdfs:range ont:Person .

ont:isPerformingWellFor a owl:ObjectProperty ;
    rdfs:comment "Indicates that a specific demographic segment is contributing positively to a company's business results." ;
    rdfs:domain ont:DemographicGroup ;
    rdfs:range ont:Company .

ont:isPerpetratedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the group or type of actor responsible for carrying out a negative or illicit act." ;
    rdfs:domain ont:Problem ;
    rdfs:range ont:CybercrimeGang .

ont:isPlanOf a owl:ObjectProperty ;
    rdfs:comment "Attributes a strategic plan to the organization that created it." ;
    rdfs:domain ont:Plan ;
    rdfs:range ont:Organization .

ont:isPlannedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the party or entity that is organizing or intending to carry out a future action." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Agent .

ont:isPoweredBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the core technology that enables or underpins a business strategy or product vision." ;
    rdfs:domain ont:BusinessStrategy ;
    rdfs:range ont:Technology .

ont:isPrecededBy a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that a historical event occurred before another event, providing context for the current situation." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Event .

ont:isProductOf a owl:ObjectProperty ;
    rdfs:comment "Associates a commercial offering with the company that develops and markets it." ;
    rdfs:domain ont:Product ;
    rdfs:range ont:Company .

ont:isProducedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates the entity responsible for creating and distributing content, such as a podcast." ;
    rdfs:domain ont:Podcast ;
    rdfs:range ont:Company .

ont:isProvidedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity that is the source of a resource, such as data or financial incentive." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Data
            ont:Incentive
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:State
        )
    ] ;
    owl:inverseOf ont:receivesIncentive .

ont:isPublishedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the media organization responsible for issuing a report, article or other written work." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Document
            ont:PublicationEvent
            ont:Report
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Organization
            ont:Publication
        )
    ] .

ont:isReaffirmationBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual who is confirming a prior statement." ;
    rdfs:domain ont:Reaffirmation ;
    rdfs:range ont:Person .

ont:isReferencedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that a person or work cites or draws upon another source of information." ;
    rdfs:domain ont:Publication ;
    rdfs:range ont:Person .

ont:isRelatedTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates a general corporate affiliation or thematic connection between two entities or events." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Indictment
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:CriminalScheme
        )
    ] .

ont:isRelatedToProductType a owl:ObjectProperty ;
    rdfs:comment "Associates an event, such as a lawsuit or recall, with the general category of goods it concerns." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Product .

ont:isReplacedBy a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Denotes that a term or concept has been superseded by a new one." ;
    rdfs:domain ont:Term ;
    rdfs:range ont:Term .

ont:isReportedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the source, typically a media organization, that has publicly disclosed information about an event or trend." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:FinancialMetric
        )
    ] ;
    rdfs:range ont:Organization .

ont:isRequestedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the nation or authority that formally asked for a legal action, such as an extradition." ;
    rdfs:domain ont:Extradition ;
    rdfs:range ont:Country .

ont:isResignationFrom a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the company from which a person is resigning." ;
    rdfs:domain ont:Resignation ;
    rdfs:range ont:Company .

ont:isResignationOfRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the professional position being vacated through a resignation." ;
    rdfs:domain ont:Resignation ;
    rdfs:range ont:Role .

ont:isResidentOf a owl:ObjectProperty ;
    rdfs:comment "Specifies the city or town where a person lives." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:GeopoliticalEntity ;
    rdfs:subPropertyOf ont:isAssociatedWith .

ont:isResponseTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that a communication or action was made as a direct reply to another person's statement." ;
    rdfs:domain ont:Communication ;
    rdfs:range ont:Person .

ont:isRivalOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates a state of competition between two entities within the same market." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:isRoleOf a owl:ObjectProperty ;
    rdfs:comment "Defines the underlying entity or group that is fulfilling a specific function or position." ;
    rdfs:domain ont:Role ;
    rdfs:range ont:Agent .

ont:isRulingOn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Connects a legal decision to the specific lawsuit it addresses." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:LawsuitFiling .

ont:isSameAs a owl:ObjectProperty , owl:ReflexiveProperty , owl:TransitiveProperty , owl:SymmetricProperty ;
    rdfs:comment "Establishes an equivalence between two concepts or groups, indicating they represent the same underlying entity or demographic." ;
    rdfs:domain ont:DemographicGroup ;
    rdfs:range ont:DemographicGroup .

ont:isSaleOf a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:comment "Identifies the company or asset that was sold in a corporate acquisition." ;
    rdfs:domain ont:CorporateAcquisition ;
    rdfs:range ont:Company .

ont:isShoppingAtType a owl:ObjectProperty ;
    rdfs:comment "Describes the behavior of a demographic group patronizing a certain category of business." ;
    rdfs:domain ont:DemographicGroup ;
    rdfs:range ont:DiscountRetailer .

ont:isSiblingOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents the real-world family relationship of having one or both parents in common." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:isSimilarTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Indicates that two events or legal actions share common characteristics, allegations, or themes." ;
    rdfs:domain ont:Event ;
    rdfs:range ont:Event .

ont:isSourceOfGrowthFor a owl:ObjectProperty ;
    rdfs:comment "Pinpoints a specific demographic as a key driver of increased business or revenue for a company." ;
    rdfs:domain ont:DemographicGroup ;
    rdfs:range ont:Company ;
    rdfs:subPropertyOf ont:isPerformingWellFor .

ont:isSpoofOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the fraudulent misrepresentation of one entity as another." ;
    rdfs:domain ont:Example ;
    rdfs:range ont:Website .

ont:isSpouseOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents the real-world relationship of being legally married." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:isStatementBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the party responsible for issuing a public communication." ;
    rdfs:domain ont:Statement ;
    rdfs:range ont:Company .

ont:isStrategyOf a owl:ObjectProperty ;
    rdfs:comment "Links a plan of action to the person or entity that conceived and executed it." ;
    rdfs:domain ont:BusinessStrategy ;
    rdfs:range ont:Person .

ont:isSubjectOfHearing a owl:ObjectProperty ;
    rdfs:comment "Indicates that a legal case is the subject of a court proceeding." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range ont:CourtHearing ;
    owl:inverseOf ont:isHearingFor .

ont:isSubsidiaryOf a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Denotes a relationship where one company is controlled by another, known as the parent company." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company ;
    rdfs:subPropertyOf ont:isOwnedBy ;
    owl:inverseOf ont:hasSubsidiary .

ont:isSupportedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates that an assertion, trend, or finding is backed by evidence, data, or expert opinion from a source." ;
    rdfs:domain ont:CausalFactor ;
    rdfs:range ont:Agent .

ont:isTargetOfAcquisition a owl:ObjectProperty ;
    rdfs:comment "Indicates which acquisition a company is the subject of. Renamed from isAcquiredBy for clarity." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Acquisition ;
    owl:inverseOf ont:hasAcquired .

ont:launches a owl:ObjectProperty ;
    rdfs:comment "Represents the act of formally introducing a new strategic plan or project to the market." ;
    rdfs:domain ont:Brand ;
    rdfs:range ont:BusinessInitiative .

ont:lacksPositionIn a owl:ObjectProperty ;
    rdfs:comment "Signifies the explicit absence of an ownership stake in a particular company, often disclosed for transparency." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Company .

ont:limitsAbilityOf a owl:ObjectProperty ;
    rdfs:comment "Represents a restriction placed upon the actions or authority of an entity." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:GovernmentBody .

ont:locationOf a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:comment "The inverse of isLocatedIn. Specifies that a place contains another place." ;
    rdfs:domain ont:Place ;
    rdfs:range ont:Place ;
    owl:inverseOf ont:isLocatedIn .

ont:makesInvestment a owl:ObjectProperty ;
    rdfs:comment "Represents the act of a company purchasing a specific financial asset." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Investment .

ont:measures a owl:ObjectProperty ;
    rdfs:comment "Identifies the organization or entity responsible for quantifying and reporting on a particular metric or issue." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Metric .

ont:occursAt a owl:ObjectProperty ;
    rdfs:comment "Specifies the physical location, venue or larger event where an event or activity took place." ;
    rdfs:domain ont:Event ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Building
            ont:Event
        )
    ] .

ont:omitsTopic a owl:ObjectProperty ;
    rdfs:comment "Signifies the notable exclusion of a particular subject from a document or discussion." ;
    rdfs:domain ont:GuidanceIssuance ;
    rdfs:range ont:Cryptocurrency .

ont:operates a owl:ObjectProperty ;
    rdfs:comment "Indicates that a company is actively engaged in a particular business model or type of platform." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessModel .

ont:operatesIn a owl:ObjectProperty ;
    rdfs:comment "Specifies the type of physical location from which a scheme or business is conducted." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range ont:BusinessLocation .

ont:ordersPaymentBy a owl:ObjectProperty ;
    rdfs:comment "Specifies the party that a legal ruling has mandated to pay damages." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:Company .

ont:organizes a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity responsible for planning and executing an event." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Event .

ont:overseesPracticeArea a owl:ObjectProperty ;
    rdfs:comment "Denotes direct managerial responsibility for a specific professional or legal domain." ;
    rdfs:domain ont:Employment ;
    rdfs:range ont:Domain ;
    rdfs:subPropertyOf ont:hasOversightOf .

ont:owns a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the corporate relationship where one company has control over another or owns a product or brand." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Company
            ont:Family
            ont:Person
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Brand
            ont:Company
            ont:Product
            ont:ProductSuite
        )
    ] ;
    rdfs:subPropertyOf ont:isAssociatedWith ;
    owl:inverseOf ont:isOwnedBy .

ont:participatesIn a owl:ObjectProperty ;
    rdfs:comment "Indicates that a person took an active part in an event, such as a court hearing." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:CourtHearing .

ont:pertainsTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject matter is related to or concerns a specific topic or asset class." ;
    rdfs:domain ont:RegulatoryApproval ;
    rdfs:range ont:DigitalAsset .

ont:pivotsAwayFrom a owl:ObjectProperty ;
    rdfs:comment "Represents a strategic business decision to abandon one technological approach in favor of another." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:Technology .

ont:potentiallyAccesses a owl:ObjectProperty ;
    rdfs:comment "Indicates that a country or its citizens are eligible or may become eligible to participate in a program." ;
    rdfs:domain ont:Country ;
    rdfs:range ont:GovernmentProgram .

ont:precedes a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates that one event or item occurs earlier in a sequence than another." ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ont:follows .

ont:precedesInRole a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Signifies that one person held a specific professional position before another person." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:predicts a owl:ObjectProperty ;
    rdfs:comment "Indicates that a future event or crisis was forecasted." ;
    rdfs:domain ont:Warning ;
    rdfs:range ont:Crisis .

ont:premieresAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Specifies the event or venue where a film was first publicly shown." ;
    rdfs:domain ont:Film ;
    rdfs:range ont:FilmFestival .

ont:produces a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual responsible for managing the production of a film or the act of manufacturing a product." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Organization
            ont:Person
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Film
            ont:Product
        )
    ] .

ont:producesProductType a owl:ObjectProperty ;
    rdfs:comment "The act of manufacturing or creating a general category of products." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Product ;
    rdfs:subPropertyOf ont:produces .

ont:proposes a owl:ObjectProperty ;
    rdfs:comment "Identifies the individual who suggested a particular solution or course of action." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Plan .

ont:protestsAgainst a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:comment "Represents the act of public opposition towards a specific issue or crisis." ;
    rdfs:domain ont:Protest ;
    rdfs:range ont:Situation .

ont:providesAssessment a owl:ObjectProperty ;
    rdfs:comment "Indicates the act of an expert or analyst offering their formal evaluation of an event." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Assessment ;
    owl:inverseOf ont:isAssessmentOf .

ont:providesDataFor a owl:ObjectProperty ;
    rdfs:comment "Signifies the act of supplying the underlying information or statistics used to analyze a trend or event." ;
    rdfs:domain ont:DataProvider ;
    rdfs:range ont:Trend .

ont:quantifiesIssue a owl:ObjectProperty ;
    rdfs:comment "Represents the act of measuring and expressing a problem in numerical terms." ;
    rdfs:domain ont:Agent ;
    rdfs:range ont:Problem .

ont:reaffirms a owl:ObjectProperty ;
    rdfs:comment "Indicates that a statement or action serves to confirm the validity of a previous observation." ;
    rdfs:domain ont:Reaffirmation ;
    rdfs:range ont:Observation .

ont:receivesFunding a owl:ObjectProperty ;
    rdfs:comment "Indicates that a company was the recipient of capital during a specific investment event." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:FundingRound .

ont:receivesGrant a owl:ObjectProperty ;
    rdfs:comment "Indicates that an entity was the recipient of a formal grant award." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:Grant .

ont:receivesIncentive a owl:ObjectProperty ;
    rdfs:comment "Signifies that an entity is the beneficiary of a supportive financial or policy package." ;
    rdfs:domain ont:Startup ;
    rdfs:range ont:Incentive ;
    owl:inverseOf ont:isProvidedBy .

ont:receivesOfferFrom a owl:ObjectProperty ;
    rdfs:comment "Indicates the reception of a formal business proposal." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessOffer .

ont:regulatesEntityType a owl:ObjectProperty ;
    rdfs:comment "Represents the act of supervising or controlling a general category of organizations according to established rules." ;
    rdfs:domain ont:RegulatoryAgency ;
    rdfs:range ont:FinancialInstitution .

ont:reorganizesInto a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty , owl:FunctionalProperty ;
    rdfs:comment "Represents the corporate restructuring process where a company becomes a subsidiary of a new parent or holding company." ;
    rdfs:domain ont:TechnologyFirm ;
    rdfs:range ont:HoldingCompany .

ont:replaces a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Signifies the act of taking over a position previously held by another individual." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:reportsOn a owl:ObjectProperty ;
    rdfs:comment "Signifies that a publication has published information or analysis about a specific event, issue or entity." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:NewsOrganization
            ont:Publication
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Agent
            ont:CorporateGovernanceIssue
        )
    ] .

ont:reportsPresenceOf a owl:ObjectProperty ;
    rdfs:comment "Indicates that a source has documented the existence of a particular group of people in a location." ;
    rdfs:domain ont:OnlineCommunity ;
    rdfs:range ont:Person .

ont:reportsTo a owl:ObjectProperty ;
    rdfs:comment "Represents the act of a whistleblower submitting information about alleged wrongdoing to a regulatory or law enforcement body." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:GovernmentAgency .

ont:represents a owl:ObjectProperty ;
    rdfs:comment "Indicates the act of serving as the legal advocate, agent or competitor for a party in a legal matter." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Person
            ont:Region
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:Country
            ont:GovernmentBody
            ont:State
            ont:WorkCulture
        )
    ] .

ont:residesIn a owl:ObjectProperty ;
    rdfs:comment "Specifies the dwelling or location where a person lives." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Place .

ont:resultsIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Indicates the outcome or creation of a new entity following a corporate event like a merger." ;
    rdfs:domain ont:Merger ;
    rdfs:range ont:Company .

ont:revokesAccreditationOf a owl:ObjectProperty ;
    rdfs:comment "Represents the official act of withdrawing a previously granted certification or endorsement due to failure to meet standards." ;
    rdfs:domain ont:NonprofitOrganization ;
    rdfs:range ont:Company .

ont:roleAt a owl:ObjectProperty ;
    rdfs:comment "Specifies the organization where a particular professional role is held." ;
    rdfs:domain ont:Role ;
    rdfs:range ont:Organization .

ont:roleHeldBy a owl:ObjectProperty ;
    rdfs:comment "The inverse of holdsRole. Specifies the person holding a particular role." ;
    rdfs:domain ont:Role ;
    rdfs:range ont:Person ;
    owl:inverseOf ont:holdsRole .

ont:scalesBack a owl:ObjectProperty ;
    rdfs:comment "Indicates a strategic decision to reduce or de-emphasize a particular business model or operation." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessModel .

ont:secures a owl:ObjectProperty ;
    rdfs:comment "Represents the successful acquisition of a favorable financial status or rating." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:FinancialRating .

ont:seeksToReverse a owl:ObjectProperty ;
    rdfs:comment "Represents the act of attempting to overturn or annul a prior decision or ruling through a legal process." ;
    rdfs:domain ont:GovernmentBody ;
    rdfs:range ont:LegalRuling .

ont:servesAsPresidentOf a owl:ObjectProperty ;
    rdfs:comment "Denotes a past leadership role held at a specific company or brand." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Brand ;
    rdfs:subPropertyOf ont:holdsRole .

ont:servesAsProgramDirectorFor a owl:ObjectProperty ;
    rdfs:comment "Denotes a past management role for a specific initiative or organization." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Organization ;
    rdfs:subPropertyOf ont:holdsRole .

ont:servesClientType a owl:ObjectProperty ;
    rdfs:comment "Describes the category of customer an organization provides services to." ;
    rdfs:domain ont:Organization ;
    rdfs:range ont:Client .

ont:shiftsFocusTo a owl:ObjectProperty ;
    rdfs:comment "Represents a strategic pivot or change in a company's primary business model or market approach." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:BusinessModel .

ont:sidesWith a owl:ObjectProperty ;
    rdfs:comment "Indicates that a legal ruling favors or supports the arguments of a particular party in a dispute." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:State .

ont:sponsorsRoleType a owl:ObjectProperty ;
    rdfs:comment "Represents a commercial partnership with a category of individuals, such as athletes, as a marketing strategy." ;
    rdfs:domain ont:Brand ;
    rdfs:range ont:Athlete .

ont:spinsOffEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:comment "Identifies the new, independent company created as the result of a spinoff event." ;
    rdfs:domain ont:Spinoff ;
    rdfs:range ont:Company .

ont:statesFailureOf a owl:ObjectProperty ;
    rdfs:comment "The act of formally asserting that a particular plan or strategy did not succeed." ;
    rdfs:domain ont:Argument ;
    rdfs:range ont:BusinessStrategy .

ont:statesIntentionToCompeteWith a owl:ObjectProperty ;
    rdfs:comment "The act of formally declaring a goal to challenge or rival another entity in the market." ;
    rdfs:domain ont:Argument ;
    rdfs:range ont:Product .

ont:statesIntentionToExecute a owl:ObjectProperty ;
    rdfs:comment "The act of formally declaring a plan to carry out or implement a specific strategy." ;
    rdfs:domain ont:Argument ;
    rdfs:range ont:BusinessStrategy .

ont:stopsSupplying a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Represents the cessation of providing goods or services to another business, a market event that can disrupt supply chains." ;
    rdfs:domain ont:Company ;
    rdfs:range ont:Company .

ont:supports a owl:ObjectProperty ;
    rdfs:comment "Shows that a piece of evidence, such as data, corroborates or lends credibility to an observation or claim." ;
    rdfs:domain ont:Data ;
    rdfs:range ont:Observation .

ont:targetsCompany a owl:ObjectProperty ;
    rdfs:comment "Identifies the specific organization that is the subject of a corporate action, such as layoffs." ;
    rdfs:domain ont:CorporateEvent ;
    rdfs:range ont:Company .

ont:targetsEntityType a owl:ObjectProperty ;
    rdfs:comment "Specifies the general classification of individuals or groups who are the intended victims or subjects of a scheme." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            ont:IsraeliCitizen
            ont:Noncitizen
        )
    ] .

ont:targetsLocation a owl:ObjectProperty ;
    rdfs:comment "Specifies the country that is the destination or focus of a criminal scheme." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range ont:Country .

ont:targetsRoleType a owl:ObjectProperty ;
    rdfs:comment "Specifies the category or classification of job positions affected by a corporate action." ;
    rdfs:domain ont:Layoff ;
    rdfs:range ont:Role .

ont:triggers a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Signifies that one event directly initiates another subsequent event." ;
    rdfs:domain ont:Resignation ;
    rdfs:range ont:Appointment ;
    rdfs:subPropertyOf ont:causes .

ont:usesMaterial a owl:ObjectProperty ;
    rdfs:comment "Specifies a primary physical substance required for the function or manufacturing of a technology." ;
    rdfs:domain ont:Technology ;
    rdfs:range ont:Material .

ont:violates a owl:ObjectProperty ;
    rdfs:comment "Indicates that an action is in breach of a specific law, rule, or constitutional provision." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range ont:LegalDocument .

ont:wantsToProduce a owl:ObjectProperty ;
    rdfs:comment "Expresses an intention or ambition to create a specific type of creative work in the future." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:HorrorMovie .

ont:wasDraggedByAssetType a owl:ObjectProperty ;
    rdfs:comment "Indicates that a negative market performance was significantly influenced by the poor performance of a general class of assets. Renamed from dragsByEntityType for clarity." ;
    rdfs:domain ont:MarketMovement ;
    rdfs:range ont:FinancialInstrument .

ont:wasEmployedBy a owl:ObjectProperty ;
    rdfs:comment "Indicates a past employment relationship between an individual and an organization. Canonical property for past employment." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Organization ;
    owl:inverseOf ont:didEmploy .

ont:wasRequestedBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the party that initiated a formal request. Renamed from isRequestBy for clarity." ;
    rdfs:domain ont:AuditRequest ;
    rdfs:range ont:FashionHouse .

ont:wasRequestedTo a owl:ObjectProperty ;
    rdfs:comment "Identifies the party to whom a formal request was made. Renamed from isRequestTo for clarity." ;
    rdfs:domain ont:AuditRequest ;
    rdfs:range ont:Company .

ont:wins a owl:ObjectProperty ;
    rdfs:comment "Signifies a victory in a major competitive event." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:CyclingRace .

ont:winsAgainst a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Signifies victory over an opponent in a contest, such as a presidential election." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:winsEvent a owl:ObjectProperty ;
    rdfs:comment "Signifies the achievement of victory in a specific competition." ;
    rdfs:domain ont:SportsTeam ;
    rdfs:range ont:SportingEvent .

ont:witnesses a owl:ObjectProperty ;
    rdfs:comment "Represents the act of an individual having firsthand knowledge or observation of an event or practice, particularly alleged wrongdoing." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Allegation .

ont:worksWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:comment "Represents a professional collaboration or association between individuals." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

ont:worksUnder a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:comment "Indicates a reporting relationship where one person was subordinate to another." ;
    rdfs:domain ont:Person ;
    rdfs:range ont:Person .

#################################################################
#    Datatype Properties
#################################################################

ont:hasAdSpend a owl:DatatypeProperty ;
    rdfs:comment "The amount of money a company allocates to advertising." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:decimal .

ont:hasAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of individuals impacted by a corporate event, such as a layoff." ;
    rdfs:domain ont:Layoff ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasAffectedRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The proportion of a group, such as a company's workforce, that was impacted by a corporate event." ;
    rdfs:domain ont:Layoff ;
    rdfs:range xsd:decimal .

ont:hasAge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The length of time that a person has lived, expressed in years." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasAgeAtEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The age of a person at the time a specific event, like an appointment, occurred." ;
    rdfs:domain ont:Appointment ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasAim a owl:DatatypeProperty ;
    rdfs:comment "Describes the primary goal or intended purpose of a plan or scheme." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range xsd:normalizedString .

ont:hasAllegation a owl:DatatypeProperty ;
    rdfs:comment "A specific claim or assertion of wrongdoing made against a party, which has not yet been proven in court." ;
    rdfs:domain ont:LegalProceeding ;
    rdfs:range xsd:string .

ont:hasAllegedUsagePeriod a owl:DatatypeProperty ;
    rdfs:comment "The specific time frame during which a particular practice or technology was purportedly in use." ;
    rdfs:domain ont:Algorithm ;
    rdfs:range xsd:string .

ont:hasAndroidAppVolume a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The percentage of a company's total mobile app activity that occurs on the Android platform." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:decimal .

ont:hasAnnouncementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific calendar date on which a market-moving event was made public." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasArrivalDateInLisbon a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific month and year a person began residing in Lisbon." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:gYearMonth .

ont:hasAssessmentDescription a owl:DatatypeProperty ;
    rdfs:comment "A qualitative evaluation or judgment about the nature or outcome of an event, such as its success." ;
    rdfs:domain ont:Acquisition ;
    rdfs:range xsd:string .

ont:hasAttribute a owl:DatatypeProperty ;
    rdfs:comment "A qualitative characteristic or feature of an entity." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range xsd:string .

ont:hasAttendance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of people present at an event." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasAuditStartYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year when an accounting firm began its role as auditor for a company." ;
    rdfs:domain ont:AccountingFirm ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasBasisYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific calendar year to which a set of company-wide data, like employee count, pertains." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasStartYear .

ont:hasBrandCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of distinct brands associated with a business unit or company." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:BusinessUnit
            ont:Company
        )
    ] ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasBudget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total amount of money allocated for a specific plan or project." ;
    rdfs:domain ont:HousingPlan ;
    rdfs:range xsd:decimal .

ont:hasCashReserveValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total amount of cash and cash equivalents held by a company, which was the subject of a corporate governance issue." ;
    rdfs:domain ont:CorporateGovernanceIssue ;
    rdfs:range xsd:decimal .

ont:hasCategoryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of distinct product categories offered by a business unit." ;
    rdfs:domain ont:BusinessUnit ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasChangePeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The duration over which a change in a financial metric is measured." ;
    rdfs:domain ont:FinancialMetric ;
    rdfs:range xsd:duration .

ont:hasCharacteristic a owl:DatatypeProperty ;
    rdfs:comment "A qualitative attribute describing the nature of an event, such as being unexpected." ;
    rdfs:domain ont:Resignation ;
    rdfs:range xsd:token .

ont:hasClosingValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The final value of a stock index or price at the end of a trading session." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:StockIndex
            ont:StockPriceMovement
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasComment a owl:DatatypeProperty ;
    rdfs:comment "A direct quote or summary of an opinion expressed as part of an expert assessment of a market event." ;
    rdfs:domain ont:ExpertAssessment .

ont:hasComparisonPeriod a owl:DatatypeProperty ;
    rdfs:comment "The timeframe against which a current metric is being compared, such as 'a year ago'." ;
    rdfs:domain ont:Data ;
    rdfs:range xsd:string .

ont:hasComparisonYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year used as a baseline for comparing a growth metric." ;
    rdfs:domain ont:GrowthMetric ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasConnectedBrandCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of third-party brands available on a company's platform." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasConnectedRetailerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of retail businesses that use a company's platform to source goods." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasContentValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The literal text, claim, or belief conveyed in a public communication." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Communication
            ont:Statement
        )
    ] ;
    rdfs:range xsd:normalizedString .

ont:hasCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total monetary expense required to build or acquire an asset." ;
    rdfs:domain ont:Factory ;
    rdfs:range xsd:decimal .

ont:hasCostUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The unit of measurement for which a cost is specified, such as per kilowatt-hour." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:token .

ont:hasCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The unit of money in which a financial value is expressed." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Acquisition
            ont:BusinessDeal
            ont:CorporateAcquisition
            ont:CorporateGovernanceIssue
            ont:FinancialMetric
            ont:FinancialReport
            ont:Financing
            ont:Founding
            ont:FundingRound
            ont:Grant
            ont:HousingPlan
            ont:Incentive
            ont:LegalRuling
            ont:LegalSettlement
            ont:Merger
            ont:Payment
            ont:Person
            ont:ProductChange
            ont:StockAward
            ont:StockPriceMovement
        )
    ] ;
    rdfs:range xsd:token .

ont:hasCurrentCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The current market price or manufacturing cost of a technology, typically expressed per unit of energy capacity." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:decimal .

ont:hasCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of unique customers a company has served, used as a metric of market reach." ;
    rdfs:domain ont:PerformanceMetric ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasDailyOrders a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The average number of orders processed by a company per day, a key indicator of operational volume." ;
    rdfs:domain ont:PerformanceMetric ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasDamagesAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific monetary value awarded as compensation in a legal ruling." ;
    rdfs:domain ont:LegalRuling ;
    rdfs:range xsd:decimal .

ont:hasDate a owl:DatatypeProperty ;
    rdfs:comment "The specific calendar date, or part of a date, on which an event occurred or is scheduled to occur." ;
    rdfs:domain owl:Thing .

ont:hasDateDescription a owl:DatatypeProperty ;
    rdfs:comment "A non-specific, human-readable description of when an event is scheduled to occur." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:normalizedString .

ont:hasDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific day of the week on which a market event or movement occurred." ;
    rdfs:domain ont:MarketMovement ;
    rdfs:range xsd:token .

ont:hasDeadline a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The final date by which a task, such as a regulatory decision, must be completed." ;
    rdfs:domain ont:Investigation ;
    rdfs:range xsd:date .

ont:hasDealType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The method of payment or consideration used in a corporate transaction, such as an all-stock deal." ;
    rdfs:domain ont:Merger ;
    rdfs:range xsd:token .

ont:hasDeliveryTargetYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year by which a company aims to begin delivering its first commercial products." ;
    rdfs:domain ont:Startup ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasTargetYear .

ont:hasDepartureYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a person ended their employment with a company." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "A textual explanation, summary, or characterization of an entity or event." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:BusinessStrategy
            ont:Company
            ont:ExpertAssessment
            ont:Film
            ont:LegalRuling
            ont:Person
            ont:ReportPublication
        )
    ] ;
    rdfs:range xsd:normalizedString .

ont:hasDistanceTo a owl:DatatypeProperty ;
    rdfs:comment "The numerical value representing the spatial separation between two points." ;
    rdfs:domain ont:Place ;
    rdfs:range xsd:decimal .

ont:hasDuration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The length of time that a particular state, event or employment period lasted." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:AuditRequest
            ont:Employment
            ont:FinancialTransaction
            ont:HousingPlan
            ont:OrganizationalState
            ont:Situation
        )
    ] ;
    rdfs:range xsd:duration .

ont:hasDurationAgo a owl:DatatypeProperty ;
    rdfs:comment "The amount of time that has passed since an event occurred." ;
    rdfs:domain ont:Warning .

ont:hasDurationInWorkingDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The length of a process or event, measured in business days." ;
    rdfs:domain ont:Investigation ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasElectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific date on which an individual was elected to a position." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:gYearMonth ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasElectionYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which an individual was elected to a board or position." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasEligibilityDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The cutoff date for product purchases to be included in a settlement claim." ;
    rdfs:domain ont:LegalSettlement ;
    rdfs:range xsd:date .

ont:hasEmployeeCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of people employed by an organization at a specific point in time." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasEmptyHomeCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of unoccupied residential properties in a given area." ;
    rdfs:domain ont:City ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar date on which an event concludes." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Agreement
            ont:Employment
            ont:Event
        )
    ] .

ont:hasEndValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The value of a metric at the end of a measured period, used for analyzing trends." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CompensationTrend
            ont:CorporateGovernanceIndicator
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasEndYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a policy, period, legal agreement or employment concluded." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CompensationTrend
            ont:EconomicPolicy
            ont:Employment
            ont:LegalSettlement
        )
    ] .

ont:hasEquivalentPowerFor a owl:DatatypeProperty ;
    rdfs:comment "The number of homes a given amount of energy storage could power for a specified duration." ;
    rdfs:domain ont:Measurement ;
    rdfs:range xsd:decimal .

ont:hasEstimatedValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The approximate monetary worth of a market event, such as a merger." ;
    rdfs:domain ont:Merger ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ont:hasValue .

ont:hasExchangeRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The rate at which shares of one company are converted into shares of another in an all-stock merger." ;
    rdfs:domain ont:Merger ;
    rdfs:range xsd:decimal .

ont:hasExpectedClosingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a market-moving event is anticipated to be finalized." ;
    rdfs:domain ont:Merger ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasExpectedLifespan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The anticipated operational duration of a technology under normal use." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:duration .

ont:hasExpiryPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The duration of time after which a digital asset, such as a wallet balance, becomes invalid." ;
    rdfs:domain ont:DigitalWallet ;
    rdfs:range xsd:duration .

ont:hasFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The month and year in which a legal action was formally initiated." ;
    rdfs:domain ont:LawsuitFiling ;
    rdfs:range xsd:gYearMonth ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasFilingDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The day of the week on which a legal action was formally initiated." ;
    rdfs:domain ont:LawsuitFiling ;
    rdfs:range xsd:token .

ont:hasFilingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a legal action was formally initiated." ;
    rdfs:domain ont:LawsuitFiling ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasFinancialStatus a owl:DatatypeProperty ;
    rdfs:comment "A description of an entity's financial condition at a point in time." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ont:hasStatus .

ont:hasFiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The twelve-month period that a company uses for accounting purposes and preparing financial statements." ;
    rdfs:domain ont:FinancialReport ;
    rdfs:range xsd:token .

ont:hasFormationYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a corporate entity was legally formed, possibly through a merger or restructuring." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasFoundingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a company was established." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The rate at which a recurring event or measurement occurs, such as annually." ;
    rdfs:domain ont:FinancialMetric ;
    rdfs:range xsd:token .

ont:hasFundingAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific monetary value of capital raised during a funding event." ;
    rdfs:domain ont:Founding ;
    rdfs:range xsd:decimal .

ont:hasImmigrationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The approximate time period when a person moved to a new country." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:string .

ont:hasImpactModifier a owl:DatatypeProperty ;
    rdfs:comment "A qualitative term describing the nature or scale of an effect, such as 'disproportionately'." ;
    rdfs:domain ont:Layoff ;
    rdfs:range xsd:token .

ont:hasIncomeRange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific annual monetary earnings bracket that defines a demographic group." ;
    rdfs:domain ont:DemographicGroup ;
    rdfs:range xsd:string .

ont:hasJobTitle a owl:DatatypeProperty ;
    rdfs:comment "The specific professional title or position held by an individual." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:normalizedString .

ont:hasJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The country or legal territory in which a company primarily operates or is incorporated." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:token .

ont:hasLeadTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The period of time between the present and the start of a future event, expressed in a standardized duration format." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:duration .

ont:hasLicenseSince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The time period, often a decade, from which an individual has held a racing license, indicating long-term involvement in the sport." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:string .

ont:hasLocationDescription a owl:DatatypeProperty ;
    rdfs:comment "A descriptive attribute specifying the primary location of a company's headquarters." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:normalizedString .

ont:hasLoss a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The amount by which a company's expenses exceeded its revenues during a specific financial period." ;
    rdfs:domain ont:FinancialReport ;
    rdfs:range xsd:decimal .

ont:hasMaxValueInPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The peak value a specific user engagement metric reached within a defined timeframe." ;
    rdfs:domain ont:UserEngagementMetric ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf ont:hasPeakValue .

ont:hasMaximumPenalty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The longest period of incarceration that can be imposed upon conviction for a crime." ;
    rdfs:domain ont:Indictment ;
    rdfs:range xsd:duration .

ont:hasMaximumValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The upper bound or highest possible amount of a financial figure or cost estimate." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:FinancialMetric
            ont:Incentive
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasMemberWithAge a owl:DatatypeProperty ;
    rdfs:comment "Specifies the age of a particular member within a group of people, such as a child in a family." ;
    rdfs:domain ont:GroupOfPeople ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasMethod a owl:DatatypeProperty ;
    rdfs:comment "Describes the specific technique or manner in which an action or scheme is carried out." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range xsd:normalizedString .

ont:hasMinimumEarningsRequirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The minimum monthly income required to be eligible for a specific visa or program." ;
    rdfs:domain ont:ImmigrationPolicy ;
    rdfs:range xsd:decimal .

ont:hasMinimumValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The lower bound or lowest possible amount of a financial figure or cost estimate." ;
    rdfs:domain ont:FinancialMetric ;
    rdfs:range xsd:decimal .

ont:hasModality a owl:DatatypeProperty ;
    rdfs:comment "A qualifier indicating the level of certainty or potentiality of a statement, such as 'believed', 'potential' or 'expected'." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Technology
        )
    ] ;
    rdfs:range xsd:token .

ont:hasMonth a owl:DatatypeProperty ;
    rdfs:comment "The calendar month in which an event occurred." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Lawsuit
            ont:Report
        )
    ] ;
    rdfs:range xsd:gMonth ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasNationality a owl:DatatypeProperty ;
    rdfs:comment "The official status of belonging to a particular nation." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:language .

ont:hasNormalcyReturnDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The point in time when an organization's operations began to stabilize after a period of disruption." ;
    rdfs:domain ont:NationalGoverningBody ;
    rdfs:range xsd:gYearMonth ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasObstacle a owl:DatatypeProperty ;
    rdfs:comment "Describes a specific condition or requirement that is causing difficulty or delay." ;
    rdfs:domain ont:GovernmentProgram ;
    rdfs:range xsd:normalizedString .

ont:hasOperatingCountryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The number of countries in which a company has active business operations." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasOwnershipStake a owl:DatatypeProperty ;
    rdfs:comment "The percentage of equity or voting control held in a company." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Merger
            ont:Person
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasPageCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of pages in a document." ;
    rdfs:domain ont:Document ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasPaymentAmount a owl:DatatypeProperty ;
    rdfs:comment "The monetary value of a payment made for a service." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:decimal .

ont:hasPaymentFrequency a owl:DatatypeProperty ;
    rdfs:comment "The interval at which recurring payments are made, such as per month." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:token .

ont:hasPaymentMethod a owl:DatatypeProperty ;
    rdfs:comment "Describes the specific means by which money was transferred as part of a scheme, such as cash or stored value cards." ;
    rdfs:domain ont:CriminalScheme ;
    rdfs:range xsd:token .

ont:hasPeakValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The highest recorded value for a metric, such as app downloads, often following a major market event." ;
    rdfs:domain ont:UserEngagementMetric ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasPercentageChange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The relative change in a value expressed as a percentage of the initial value." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:FinancialMetric
            ont:StockIndex
            ont:StockPriceMovement
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasPercentageIncrease a owl:DatatypeProperty ;
    rdfs:comment "The relative amount of growth, expressed as a percentage, for a specific metric." ;
    rdfs:domain ont:Data ;
    rdfs:range xsd:decimal .

ont:hasPercentageOfCeoPay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The proportion of an executive's compensation relative to the CEO's compensation in the same year, expressed as a percentage." ;
    rdfs:domain ont:CompensationMetric ;
    rdfs:range xsd:decimal .

ont:hasPercentageOfSalary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The proportion of an individual's income that is allocated to a specific expense, expressed as a percentage." ;
    rdfs:domain ont:RentPayment ;
    rdfs:range xsd:decimal .

ont:hasPerformanceStatus a owl:DatatypeProperty ;
    rdfs:comment "A qualitative description of an entity's contribution to market performance, such as being a top drag." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:token .

ont:hasPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The duration of time over which a particular metric or value was measured." ;
    rdfs:domain ont:UserEngagementMetric ;
    rdfs:range xsd:duration .

ont:hasPivotYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which a significant strategic change in a company's direction occurred." ;
    rdfs:domain ont:Startup ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasPlaintiffCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of initial named parties bringing a lawsuit against a defendant." ;
    rdfs:domain ont:LegalProceeding ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasPointChange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The absolute numerical change in the value of a stock index or price." ;
    rdfs:domain ont:StockIndex ;
    rdfs:range xsd:decimal .

ont:hasPolicyHistoryDuration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The number of years a particular government or administration has been in power and implementing policies." ;
    rdfs:domain ont:Government ;
    rdfs:range xsd:duration .

ont:hasPosition a owl:DatatypeProperty ;
    rdfs:comment "The professional title or role held by an expert, which lends credibility to their assessment." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:token .

ont:hasPositionLevel a owl:DatatypeProperty ;
    rdfs:comment "A descriptor for the rank or seniority of a role within an organization's hierarchy." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:token .

ont:hasPotentialLifespan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The theoretical or possible maximum operational duration of a technology." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:duration .

ont:hasPotentialStorageDuration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The feasible, but not necessarily typical, length of time a technology could discharge energy." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:duration .

ont:hasPotentialTimeframe a owl:DatatypeProperty ;
    rdfs:comment "A non-specific period in the future during which an event is anticipated to happen." ;
    rdfs:domain ont:Lawsuit ;
    rdfs:range xsd:normalizedString .

ont:hasPotentialTiming a owl:DatatypeProperty ;
    rdfs:comment "A non-specific timeframe during which an event is expected to occur." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:string .

ont:hasPremium a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The percentage amount by which the acquisition price per share exceeds the stock's market price prior to a merger announcement." ;
    rdfs:domain ont:Merger ;
    rdfs:range xsd:decimal .

ont:hasPremiereDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific calendar date on which a film was first publicly exhibited." ;
    rdfs:domain ont:Film ;
    rdfs:range xsd:date .

ont:hasPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The monetary value assigned to a single unit, such as the price per share in a corporate buyout or product feature." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CorporateAcquisition
            ont:ProductChange
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasProjectedGmv a owl:DatatypeProperty ;
    rdfs:comment "The forecasted total value of merchandise sold through a platform over a given period, as stated by a company representative." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:decimal .

ont:hasProjectedValue a owl:DatatypeProperty ;
    rdfs:comment "A forecasted numerical value for a future point in time." ;
    rdfs:domain ont:Problem ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasPropertyValueRequirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The minimum value of a real estate investment required to qualify for a program like a Golden Visa." ;
    rdfs:domain ont:ImmigrationPolicy ;
    rdfs:range xsd:decimal .

ont:hasPublicStatement a owl:DatatypeProperty ;
    rdfs:comment "An official comment or declaration made by a party for public record regarding a specific issue." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:string .

ont:hasPublicationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The temporal marker indicating when a document or statement was released to the public." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Person
            ont:ReportPublication
        )
    ] ;
    rdfs:range xsd:normalizedString .

ont:hasQuarter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific three-month fiscal period to which a financial report or event pertains." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:EarningsReport
            ont:FinancialMetric
        )
    ] ;
    rdfs:range xsd:token .

ont:hasQuote a owl:DatatypeProperty ;
    rdfs:comment "A verbatim statement made by a person, often in a public announcement or document." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Argument
            ont:Person
        )
    ] ;
    rdfs:range xsd:string .

ont:hasRange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The maximum distance a vehicle can travel on a single charge." ;
    rdfs:domain ont:Product ;
    rdfs:range xsd:decimal .

ont:hasRangeUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The unit of measurement for distance, such as miles or kilometers." ;
    rdfs:domain ont:Product ;
    rdfs:range xsd:token .

ont:hasRanking a owl:DatatypeProperty ;
    rdfs:comment "A formal classification or position on a recognized list, such as the Fortune 500, indicating market significance." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:token .

ont:hasRehousedFamilyCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of family units provided with new accommodation through a rehousing program." ;
    rdfs:domain ont:RehousingProgram ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasRehousedPeopleCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total number of individuals provided with new accommodation through a rehousing program." ;
    rdfs:domain ont:RehousingProgram ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasReportedCountInLisbon a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The estimated number of individuals from a specific group, like digital nomads, present in Lisbon as reported by a source." ;
    rdfs:domain ont:OnlineCommunity ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasReportedMultiplier a owl:DatatypeProperty ;
    rdfs:comment "A factor by which a quantity is multiplied, as stated in a report or study." ;
    rdfs:domain ont:Agent ;
    rdfs:range xsd:decimal .

ont:hasReportedValue a owl:DatatypeProperty ;
    rdfs:comment "A numerical value, such as a percentage or monetary worth, that has been officially stated or published." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Acquisition
            ont:Metric
            ont:Problem
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasReportingOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The sequential position in which a source reported on an event relative to others." ;
    rdfs:domain ont:MediaOrganization ;
    rdfs:range xsd:token .

ont:hasRequestedDamages a owl:DatatypeProperty ;
    rdfs:comment "The nature or amount of compensation sought by plaintiffs in a legal action, which may be specified or unspecified." ;
    rdfs:domain ont:LegalProceeding ;
    rdfs:range xsd:token .

ont:hasRequirement a owl:DatatypeProperty ;
    rdfs:comment "Specifies a necessary condition or constraint of a rule, such as a minimum character length." ;
    rdfs:domain ont:PlatformRule ;
    rdfs:range xsd:normalizedString .

ont:hasRevenue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total amount of income generated by the sale of goods or services related to a company's primary operations." ;
    rdfs:domain ont:FinancialReport ;
    rdfs:range xsd:decimal .

ont:hasRevenueGrowth a owl:DatatypeProperty ;
    rdfs:comment "A descriptor for the pace of financial expansion, such as revenue growth." ;
    rdfs:domain ont:EarningsReport ;
    rdfs:range xsd:token .

ont:hasRevocationYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year in which an official accreditation or status was withdrawn." ;
    rdfs:domain ont:NonprofitOrganization ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf ont:hasYear .

ont:hasRiskLevel a owl:DatatypeProperty ;
    rdfs:comment "A qualitative assessment of the degree of danger or harm associated with a substance or situation." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:ChemicalSubstance
            ont:MedicalCondition
        )
    ] ;
    rdfs:range xsd:token .

ont:hasRoleDescription a owl:DatatypeProperty ;
    rdfs:comment "A descriptive title for a person's function in the context of a corporate change, such as: 'new boss'." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:token .

ont:hasSocioeconomicArea a owl:DatatypeProperty ;
    rdfs:comment "A descriptor for a part of a location characterized by a particular income level." ;
    rdfs:domain ont:GeopoliticalEntity ;
    rdfs:range xsd:string .

ont:hasSpendFrequency a owl:DatatypeProperty ;
    rdfs:comment "The time period over which a specified amount of money is spent, such as per year." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:token .

ont:hasStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The specific calendar date on which an event, role, or period commenced." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Appointment
            ont:Employment
            ont:Event
            ont:Role
            ont:Situation
        )
    ] ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasStartValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The value of a metric at the beginning of a measured period, used for analyzing trends." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CompensationTrend
            ont:CorporateGovernanceIndicator
        )
    ] ;
    rdfs:range xsd:decimal .

ont:hasStartYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The calendar year marking the beginning of a period over which a trend or policy is measured." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CompensationTrend
            ont:CorporateGovernanceIndicator
            ont:EconomicPolicy
            ont:Employment
            ont:FundingRound
            ont:Situation
        )
    ] ;
    rdfs:subPropertyOf ont:hasDate .

ont:hasStatedPreference a owl:DatatypeProperty ;
    rdfs:comment "A publicly declared inclination or favored approach to handling a certain type of situation, such as a preference for litigation over settlement." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:string .

ont:hasStatedReason a owl:DatatypeProperty ;
    rdfs:comment "The justification or rationale provided for undertaking an action, such as initiating an investigation." ;
    rdfs:domain ont:Investigation ;
    rdfs:range xsd:string .

ont:hasStatus a owl:DatatypeProperty ;
    rdfs:comment "A qualitative descriptor indicating the current state, condition, or perception of an entity or event." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ont:hasStockPurchaseCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The expense incurred by a company to acquire the inventory it sold during a financial period, a key component of cost of goods sold." ;
    rdfs:domain ont:FinancialReport ;
    rdfs:range xsd:decimal .

ont:hasStorageDuration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The standard or typical length of time a storage technology can supply power at its rated output." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:duration .

ont:hasSubmissionDeadline a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The final date by which a required document must be filed to be considered valid." ;
    rdfs:domain ont:Document ;
    rdfs:range xsd:date .

ont:hasSupportingData a owl:DatatypeProperty ;
    rdfs:comment "A specific numerical figure or percentage that substantiates a claim or finding about a market trend." ;
    rdfs:domain ont:CausalFactor ;
    rdfs:range xsd:decimal .

ont:hasTargetCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The desired or projected cost for a technology that a developer aims to achieve." ;
    rdfs:domain ont:Technology ;
    rdfs:range xsd:decimal .

ont:hasTargetYear a owl:DatatypeProperty ;
    rdfs:comment "The calendar year set as the deadline for achieving a specific goal or projection." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:FinancialMetric
            ont:Goal
            ont:Problem
        )
    ] ;
    rdfs:range xsd:gYear .

ont:hasTaxRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The percentage at which an individual or corporation is taxed under a specific policy." ;
    rdfs:domain ont:ImmigrationPolicy ;
    rdfs:range xsd:decimal .

ont:hasTemporalDescription a owl:DatatypeProperty ;
    rdfs:comment "A non-specific, relative timeframe for when an event occurred, such as 'last year' or 'earlier in the year'." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:Observation
            ont:ProductRecall
        )
    ] ;
    rdfs:range xsd:normalizedString .

ont:hasTemporalStatus a owl:DatatypeProperty ;
    rdfs:comment "A qualitative description of an item's position in time, such as being the most recent or former." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Podcast
            ont:Situation
        )
    ] ;
    rdfs:range xsd:token .

ont:hasTenure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The total length of time a person has been associated with a company or role." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:duration .

ont:hasTenureAsAuditor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The duration of time that an accounting firm has served as the official auditor for a company." ;
    rdfs:domain ont:AccountingFirm ;
    rdfs:range xsd:duration .

ont:hasTenureYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The number of years a person has held a specific role or position." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:nonNegativeInteger .

ont:hasTickerSymbol a owl:DatatypeProperty , owl:InverseFunctionalProperty , owl:FunctionalProperty ;
    rdfs:comment "The unique alphabetic code used to identify a publicly traded company on a stock exchange." ;
    rdfs:domain ont:Company ;
    rdfs:range xsd:token .

ont:hasTimeReference a owl:DatatypeProperty ;
    rdfs:comment "A non-specific point or period in time relative to the present, used to contextualize an event." ;
    rdfs:domain ont:Event ;
    rdfs:range xsd:string .

ont:hasTimeframe a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The projected or expected period during which an event is anticipated to occur or a projection is made." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:Event
            ont:FinancialMetric
        )
    ] .

ont:hasTiming a owl:DatatypeProperty ;
    rdfs:comment "A non-specific description of when an event is expected to occur." ;
    rdfs:domain ont:ProductionEvent ;
    rdfs:range xsd:normalizedString .

ont:hasTouristBedRatioBase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The reference number of residents used for calculating the density of tourist accommodation." ;
    rdfs:domain ont:City ;
    rdfs:range xsd:decimal .

ont:hasTouristBedRatioValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The number of tourist beds available for a given number of residents, indicating tourism intensity." ;
    rdfs:domain ont:City ;
    rdfs:range xsd:decimal .

ont:hasType a owl:DatatypeProperty ;
    rdfs:comment "A classification that specifies the nature or methodology of a process, such as an investigation." ;
    rdfs:domain ont:Investigation ;
    rdfs:range xsd:token .

ont:hasUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The basis of a specified price or value, such as 'per share' or a standard of measurement." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:CorporateAcquisition
            ont:FinancialMetric
            ont:Measurement
        )
    ] ;
    rdfs:range xsd:token .

ont:hasVacancyDuration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The length of time a key leadership role remained unfilled, a factor in assessing corporate stability and decision-making." ;
    rdfs:domain ont:Appointment ;
    rdfs:range xsd:duration .

ont:hasValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "The numerical quantity associated with a financial transaction, valuation, or metric." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            ont:FinancialReport
            ont:FinancialTransaction
            ont:Metric
        )
    ] .

ont:hasVisualPosition a owl:DatatypeProperty ;
    rdfs:comment "Describes the physical placement of a person in a visual medium, such as on the left or right of a screen." ;
    rdfs:domain ont:Person ;
    rdfs:range xsd:token .

ont:hasYear a owl:DatatypeProperty ;
    rdfs:comment "The calendar year associated with a specific event, metric, or data point." ;
    rdfs:domain owl:Thing .

#################################################################
#    Classes
#################################################################

# --- Top-Level Classes ---

ont:AbstractConcept a owl:Class ;
    rdfs:label "Abstract Concept" ;
    rdfs:comment "Non-physical, conceptual entities (ideas, theories, plans, information, qualities, attributes, etc.)." .

ont:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "Entities capable of acting or exerting power (persons, organizations, software agents, intelligent systems, etc.)." .

ont:ConcreteEntity a owl:Class ;
    rdfs:label "Concrete Entity" ;
    rdfs:comment "Physical, tangible objects (artifacts, natural objects, locations, materials, etc.)." .

ont:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Temporal occurrences or happenings (actions, processes, states, changes, activities, etc.)." .

# --- Intermediate and Structuring Classes (Added for clarity) ---

ont:CLevelExecutive a owl:Class ;
    rdfs:comment "A top-tier executive role within an organization, typically with 'Chief' in the title, such as CEO, CFO, or CIO." ;
    rdfs:subClassOf ont:ExecutiveRole .

ont:SituationOrProcess a owl:Class ;
    rdfs:comment "An intermediate class for events that represent ongoing states, situations, or processes that unfold over a duration, rather than discrete, instantaneous occurrences." ;
    rdfs:subClassOf ont:Event .

# --- Reclassified Hierarchy ---

ont:AcademicDiscipline a owl:Class ;
    rdfs:comment "A branch of knowledge, taught and researched as part of higher education." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Allegation , ont:FinancialConcept , ont:Law , ont:Metric , ont:Role .

ont:AcademicInstitution a owl:Class ;
    rdfs:comment "An organization dedicated to higher education and research, providing expert analysis on societal issues." ;
    rdfs:subClassOf ont:EducationalInstitution .

ont:AccountingFirm a owl:Class ;
    rdfs:comment "An organization that provides professional auditing, tax, and advisory services, often engaged to verify a company's financial statements or investigate financial allegations." ;
    rdfs:subClassOf ont:Company .

ont:Acquisition a owl:Class ;
    rdfs:comment "A market-moving event where one company purchases and takes control of another company." ;
    rdfs:subClassOf ont:CorporateEvent , ont:Transaction .

ont:AdFraudTechnique a owl:Class ;
    rdfs:comment "A specific method or tactic used to illegitimately generate advertising revenue or misrepresent advertising metrics." ;
    rdfs:subClassOf ont:Technique .

ont:AdRealEstate a owl:Class ;
    rdfs:comment "The digital space available for advertising on a platform." ;
    rdfs:subClassOf ont:Platform .

ont:AdministrativeDivision a owl:Class ;
    rdfs:comment "A portion of a country or other region delineated for the purpose of administration." ;
    rdfs:subClassOf ont:Place ;
    owl:disjointWith ont:Facility .

ont:Advertiser a owl:Class ;
    rdfs:comment "A role held by a person or organization that pays to promote its products, services, or messages through various media channels." ;
    rdfs:subClassOf ont:Role ;
    owl:disjointWith ont:Marketer , ont:MediaOwner .

ont:AdvocacyGroup a owl:Class ;
    rdfs:comment "An organization whose purpose is to influence public opinion and policy regarding a specific cause or issue." ;
    rdfs:subClassOf ont:Organization .

ont:AdvisoryFirm a owl:Class ;
    rdfs:comment "An organization that provides expert guidance and recommendations to institutional investors on matters of corporate governance, including executive compensation." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:DataProvider , ont:ExecutiveSearchFirm , ont:SoftwareCompany , ont:UtilityCompany .

ont:Agreement a owl:Class ;
    rdfs:comment "A negotiated and typically legally binding arrangement between parties as to a course of action." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:AirCathode a owl:Class ;
    rdfs:comment "A type of electrode that uses oxygen from the air as a reactant." ;
    rdfs:subClassOf ont:BatteryComponent .

ont:Algorithm a owl:Class ;
    rdfs:comment "A computational process or set of rules designed to perform a specific task, such as calculating a vehicle's performance metrics." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Allegation , ont:Energy , ont:Role .

ont:Allegation a owl:Class ;
    rdfs:comment "A formal claim or assertion of wrongdoing that has not yet been proven, forming the basis of a legal action or report." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:EconomicTrend , ont:Energy , ont:FinancialConcept , ont:Law , ont:Metric , ont:Role .

ont:Analyst a owl:Class ;
    rdfs:comment "A professional who evaluates financial data and market trends to provide insights and forecasts on companies and economic conditions." ;
    rdfs:subClassOf ont:Role .

ont:AndroidApp a owl:Class ;
    rdfs:comment "A software application designed to run on the Android mobile operating system, used here to measure user engagement and market penetration." ;
    rdfs:subClassOf ont:MobileApplication .

ont:App a owl:Class ;
    rdfs:comment "A type of software product, often consumer-facing, whose performance and strategy can influence a company's market position." ;
    rdfs:subClassOf ont:Software .

ont:Apparel a owl:Class ;
    rdfs:comment "A category of consumer goods consisting of clothing and wearable accessories, relevant in the context of retail sales analysis." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:HouseholdGood .

ont:Appointment a owl:Class ;
    rdfs:comment "An event marking the formal assignment of an individual to a leadership position within a corporate or governing body." ;
    rdfs:subClassOf ont:CareerEvent ;
    owl:disjointWith ont:Departure , ont:OrganizationalEvent , ont:Pandemic , ont:Resignation , ont:SportingEvent .

ont:Approval a owl:Class ;
    rdfs:comment "The action of officially agreeing to something or accepting something as satisfactory." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:BusinessDeal , ont:CorporateEvent , ont:Movement .

ont:Apology a owl:Class ;
    rdfs:comment "A formal statement expressing regret for an offense or failure, often in a public or corporate context." ;
    rdfs:subClassOf ont:Statement .

ont:Argument a owl:Class ;
    rdfs:comment "A set of reasons or justifications presented by a party to support a specific action or position, particularly in a regulatory or legal context." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:BusinessPlan , ont:Metric , ont:Role .

ont:Arrest a owl:Class ;
    rdfs:comment "The act of seizing and taking a person into custody by legal authority in response to a criminal charge." ;
    rdfs:subClassOf ont:LegalEvent ;
    owl:disjointWith ont:Extradition , ont:Indictment .

ont:ArtificialIntelligence a owl:Class ;
    rdfs:comment "A broad field of technology and computer science focused on creating systems capable of performing tasks that normally require human intelligence, viewed here as a driver of market trends." ;
    rdfs:subClassOf ont:Technology .

ont:ArtistContract a owl:Class ;
    rdfs:comment "A formal agreement outlining the terms and conditions between a performing artist and another party, such as a promoter or venue, often related to live performances." ;
    rdfs:subClassOf ont:LegalDocument ;
    owl:disjointWith ont:ResalePolicy .

ont:Assessment a owl:Class ;
    rdfs:comment "A judgment or evaluation about the nature, ability, or quality of something or someone." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Athlete a owl:Class ;
    rdfs:comment "A professional sportsperson whose endorsement or sponsorship by a brand is a significant market event." ;
    rdfs:subClassOf ont:Role .

ont:Audio a owl:Class ;
    rdfs:comment "A category of digital content or interaction based on sound, forming a core component of a multifaceted platform." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Logo , ont:Video .

ont:AudioRecording a owl:Class ;
    rdfs:comment "A recording of sound." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:AuditRequest a owl:Class ;
    rdfs:comment "A formal demand made by a stakeholder, such as a major advertiser, for an independent examination of a company's data or business practices." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:Bacteria a owl:Class ;
    rdfs:comment "A type of single-celled microorganism, specifically one that can cause contamination in consumer products leading to recalls." ;
    rdfs:subClassOf ont:Organism .

ont:Bank a owl:Class ;
    rdfs:comment "A financial institution licensed to receive deposits and make loans, specifically one that is a key player in market events." ;
    rdfs:subClassOf ont:FinancialInstitution ;
    owl:disjointWith ont:CreditUnion , ont:FintechCompany .

ont:Banking a owl:Class ;
    rdfs:comment "A category of financial services related to managing money, credit, and other financial transactions, envisioned as a future capability of a platform." ;
    rdfs:subClassOf ont:Service ;
    owl:disjointWith ont:Messaging , ont:Payment .

ont:Bar a owl:Class ;
    rdfs:comment "A commercial establishment serving alcoholic beverages, often associated with the social life of expats and digital nomads." ;
    rdfs:subClassOf ont:BusinessPremises .

ont:Battery a owl:Class ;
    rdfs:comment "A general category for devices that store chemical energy and convert it into electrical energy." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Technology , ont:WindTurbine .

ont:BatteryComponent a owl:Class ;
    rdfs:comment "A constituent part of a battery." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Technology , ont:WindTurbine .

ont:BlackEmployee a owl:Class ;
    rdfs:comment "An employee who is of Black racial identity." ;
    rdfs:subClassOf ont:DemographicGroup .

ont:Blockchain a owl:Class ;
    rdfs:comment "A decentralized, distributed, and often public digital ledger consisting of records called blocks that is used to record transactions across many computers." ;
    rdfs:subClassOf ont:Technology .

ont:Book a owl:Class ;
    rdfs:comment "A written work, often used as a medium for sharing expertise or a personal story related to business success." ;
    rdfs:subClassOf ont:MediaProduct ;
    owl:disjointWith ont:Podcast .

ont:Borough a owl:Class ;
    rdfs:comment "A distinct administrative division of a large city, used here to specify the geographic location of a corporate office or event." ;
    rdfs:subClassOf ont:GeopoliticalEntity .

ont:Bot a owl:Class ;
    rdfs:comment "An automated software application designed to perform repetitive tasks, often used illicitly to generate fake ad traffic." ;
    rdfs:subClassOf ont:SoftwareAgent ;
    owl:disjointWith ont:Spider .

ont:Brand a owl:Class ;
    rdfs:comment "A named product line or a distinct identity created by a company to market its goods." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Company , ont:CriminalOrganization , ont:Market , ont:Metric , ont:Plan , ont:Program , ont:Role , ont:Sport .

ont:BrandingChange a owl:Class ;
    rdfs:comment "A corporate action involving the alteration of a company's public identity, such as its name or logo, to influence market perception." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:Bridge a owl:Class ;
    rdfs:comment "A large-scale infrastructure project that connects two geographical areas, relevant to urban development and commuter access." ;
    rdfs:subClassOf ont:Infrastructure .

ont:Budget a owl:Class ;
    rdfs:comment "A financial plan for a defined period, typically a year." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Example , ont:Metric , ont:Problem , ont:Role , ont:Solution , ont:Technique .

ont:Building a owl:Class ;
    rdfs:comment "A physical structure, such as a corporate office, that can be the site of a market-relevant event." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:BusinessClient a owl:Class ;
    rdfs:comment "A corporate or commercial entity that purchases satellite or telecom services." ;
    rdfs:subClassOf ont:Client ;
    owl:disjointWith ont:GovernmentClient , ont:RetailClient .

ont:BusinessDeal a owl:Class ;
    rdfs:comment "A formal agreement or transaction between two or more commercial entities, such as a partnership or service contract." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Movement .

ont:BusinessEvent a owl:DeprecatedClass ;
    rdfs:comment "This class has been deprecated in favor of its equivalent, CorporateEvent, to consolidate the event hierarchy." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Communication , ont:Investigation , ont:Lawsuit , ont:LifeMilestone , ont:PersonnelEvent ;
    owl:equivalentClass ont:CorporateEvent .

ont:BusinessExpert a owl:Class ;
    rdfs:comment "An expert with deep knowledge in business matters." ;
    rdfs:subClassOf ont:Expert .

ont:BusinessInitiative a owl:Class ;
    rdfs:comment "A significant strategic action or project undertaken by a company, such as a product launch or policy change, with potential market impact." ;
    rdfs:subClassOf ont:Plan .

ont:BusinessLocation a owl:Class ;
    rdfs:comment "A physical place, such as a retail kiosk, where commercial activities related to a scheme are conducted." ;
    rdfs:subClassOf ont:Facility .

ont:BusinessModel a owl:Class ;
    rdfs:comment "A conceptual framework that describes how a company creates, delivers, and captures value, such as 'Social Commerce' or 'B2B Wholesale'." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:BusinessOffer a owl:Class ;
    rdfs:comment "A formal proposal made by one commercial entity to another, such as an offer for a partnership or acquisition." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role , ont:WealthCreation .

ont:BusinessPlan a owl:Class ;
    rdfs:comment "A formal statement of a set of business goals, the reasons they are believed attainable, and the plan for reaching those goals." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Metric , ont:Role .

ont:BusinessPremises a owl:Class ;
    rdfs:comment "A location where a business is carried on." ;
    rdfs:subClassOf ont:Facility .

ont:BusinessSchool a owl:Class ;
    rdfs:comment "An academic institution that provides expert analysis and education on business management, leadership, and corporate events." ;
    rdfs:subClassOf ont:EducationalInstitution .

ont:BusinessStrategy a owl:Class ;
    rdfs:comment "A high-level plan outlining the long-term goals and direction of a company or product." ;
    rdfs:subClassOf ont:BusinessPlan , ont:Plan , ont:Strategy .

ont:BusinessUnit a owl:Class ;
    rdfs:comment "A specific, identifiable division or segment of a company that focuses on a particular product line or business activity." ;
    rdfs:subClassOf ont:Organization .

ont:CampaignEffectiveness a owl:Class ;
    rdfs:comment "A measure of how well an advertising initiative achieves its objectives, which is negatively impacted by ad fraud." ;
    rdfs:subClassOf ont:Metric ;
    owl:disjointWith ont:FinancialMetric .

ont:CapitalExpenditure a owl:Class ;
    rdfs:comment "Funds used by a company to acquire, upgrade, and maintain physical assets such as property, plants, buildings, technology, or equipment." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:CareerEvent a owl:Class ;
    rdfs:comment "An event related to a person's professional life, such as an appointment or departure." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Contribution , ont:ProductionEvent , ont:Transaction .

ont:CareerPath a owl:Class ;
    rdfs:comment "The conceptual progression of an individual's professional journey, particularly within the evolving technology landscape." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:CasualDining a owl:Class ;
    rdfs:comment "A category of restaurants that offers moderately priced food in a relaxed atmosphere, serving as a comparison point for consumer spending choices." ;
    rdfs:subClassOf ont:DiningEstablishment ;
    owl:disjointWith ont:FullServiceDining .

ont:CausalFactor a owl:Class ;
    rdfs:comment "An underlying reason, force, or trend that contributes to or drives a market-moving event or its impact." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Indicator , ont:Metric , ont:Role , ont:StockAward , ont:Trend .

ont:Challenge a owl:Class ;
    rdfs:comment "A significant difficulty or problem that needs to be overcome to achieve a goal." ;
    rdfs:subClassOf ont:Problem ;
    owl:disjointWith ont:Obstacle .

ont:Chatroom a owl:Class ;
    rdfs:comment "An online space for real-time text communication." ;
    rdfs:subClassOf ont:Platform .

ont:ChemicalSubstance a owl:Class ;
    rdfs:comment "A form of matter with constant chemical composition and characteristic properties, particularly one identified as a contaminant in consumer products." ;
    rdfs:subClassOf ont:Substance .

ont:ChemicalWeapon a owl:Class ;
    rdfs:comment "A toxic substance used to inflict harm, used metaphorically in this context to describe a severely damaging internal action or revelation." ;
    rdfs:subClassOf ont:Weapon .

ont:ChiefFinancialOfficer a owl:Class ;
    rdfs:comment "The senior executive responsible for managing the financial actions of a company." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:ChiefHumanResourcesOfficer , ont:ChiefInformationOfficer , ont:ChiefMarketingOfficer , ont:ChiefOperatingOfficer , ont:GeneralCounsel , ont:ItHead , ont:ManagementStar .

ont:ChiefHumanResourcesOfficer a owl:Class ;
    rdfs:comment "The senior executive responsible for overseeing all aspects of human resource management and industrial relations policies, practices, and operations for an organization." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:ChiefInformationOfficer , ont:ChiefMarketingOfficer , ont:ChiefOperatingOfficer , ont:GeneralCounsel , ont:ItHead , ont:ManagementStar .

ont:ChiefInformationOfficer a owl:Class ;
    rdfs:comment "The senior executive responsible for the management, implementation, and usability of information and computer technologies." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:ChiefMarketingOfficer , ont:ChiefOperatingOfficer , ont:GeneralCounsel , ont:ItHead , ont:ManagementStar .

ont:ChiefMarketingOfficer a owl:Class ;
    rdfs:comment "The Chief Marketing Officer, an executive role responsible for overseeing marketing initiatives within an organization." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:ChiefOperatingOfficer , ont:GeneralCounsel , ont:ItHead , ont:ManagementStar .

ont:ChiefOperatingOfficer a owl:Class ;
    rdfs:comment "The senior executive in charge of overseeing the day-to-day administrative and operational functions of a business." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:GeneralCounsel , ont:ItHead , ont:ManagementStar .

ont:CitizenshipStatus a owl:Class ;
    rdfs:comment "A legal status indicating a person's relationship to a particular nation-state." ;
    rdfs:subClassOf ont:Role ;
    owl:disjointWith ont:CoConspirator , ont:Demonym .

ont:City a owl:Class ;
    rdfs:comment "A major urban center that is a focal point for economic activity, population density, and corporate events." ;
    rdfs:subClassOf ont:Settlement ;
    owl:disjointWith ont:Country , ont:State , ont:Town .

ont:ClassActionLawsuit a owl:Class ;
    rdfs:comment "A legal proceeding where a group of people with common injuries caused by the same product or action sue a defendant as a group." ;
    rdfs:subClassOf ont:Lawsuit .

ont:Client a owl:Class ;
    rdfs:comment "A person or organization using the professional services of another." ;
    rdfs:subClassOf ont:Agent .

ont:Clothing a owl:Class ;
    rdfs:comment "Items worn to cover the body." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:CreditCard , ont:DigitalProduct , ont:Weapon .

ont:CloudComputingService a owl:Class ;
    rdfs:comment "An information technology service or resource made available to users on demand via the internet from a cloud computing provider's servers." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Workload .

ont:CloudEnvironment a owl:Class ;
    rdfs:comment "A specific deployment of cloud computing resources, either public, private, or hybrid." ;
    rdfs:subClassOf ont:CloudComputingService ;
    owl:disjointWith ont:HyperscaleCloud .

ont:CloudNativeApplication a owl:Class ;
    rdfs:comment "A type of software designed specifically to run in a cloud computing environment, leveraging services like containers and microservices." ;
    rdfs:subClassOf ont:Technology .

ont:CloudTechnology a owl:Class ;
    rdfs:comment "The overarching category of on-demand computing services, including servers, storage, and software over the internet, which is a central theme of market analysis." ;
    rdfs:subClassOf ont:Technology .

ont:CoConspirator a owl:Class ;
    rdfs:comment "An individual or entity that knowingly participates with others in a criminal plan or scheme." ;
    rdfs:subClassOf ont:Role ;
    owl:disjointWith ont:Demonym .

ont:Communication a owl:Class ;
    rdfs:comment "An act of conveying intended meanings from one entity or group to another through the use of mutually understood signs, symbols, and semiotic rules." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Investigation , ont:Lawsuit , ont:LifeMilestone .

ont:Community a owl:Class ;
    rdfs:comment "A group of people with a common characteristic or interest, viewed as a stakeholder or consumer base in market analysis." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:MediaOrganization .

ont:CommunityBank a owl:Class ;
    rdfs:comment "A depository institution that is typically locally owned and operated, focusing on the needs of the businesses and families in its community." ;
    rdfs:subClassOf ont:Bank ;
    owl:disjointWith ont:InvestmentBank , ont:MinorityDepositoryInstitution .

ont:CommunityDevelopmentFinancialInstitution a owl:Class ;
    rdfs:comment "A specialized financial institution that works in market niches that are underserved by traditional financial institutions, providing financial products and services to low-income communities." ;
    rdfs:subClassOf ont:FinancialInstitution .

ont:Company a owl:Class ;
    rdfs:comment "A commercial business enterprise involved in market activities, which can be a party to or impacted by market events." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:AdvocacyGroup , ont:CriminalOrganization , ont:DataProvider , ont:EducationalInstitution , ont:ExecutiveSearchFirm , ont:GoverningBody , ont:GovernmentAgency , ont:GovernmentBody , ont:InstitutionalInvestor , ont:InvestmentFirm , ont:MarketResearchFirm , ont:MediaOrganization , ont:MediaOutlet , ont:NewsOrganization , ont:Nonprofit , ont:OrganizationalBody , ont:Publication , ont:ResearchInstitute , ont:SmallBusiness , ont:SportsTeam , ont:UtilityCompany .

ont:CompanyDivision a owl:Class ;
    rdfs:comment "A distinct, semi-autonomous branch of a larger company, such as a regional business unit." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:RetailCompany .

ont:CompensationMetric a owl:Class ;
    rdfs:comment "A quantifiable measure related to executive or employee compensation, such as salary, bonuses, or stock awards." ;
    rdfs:subClassOf ont:FinancialMetric .

ont:CompensationTrend a owl:Class ;
    rdfs:comment "A discernible pattern or change in compensation practices over a period of time." ;
    rdfs:subClassOf ont:Trend .

ont:Compliance a owl:Class ;
    rdfs:comment "The action or fact of complying with a wish or command; adherence to rules or standards." ;
    rdfs:subClassOf ont:Domain ;
    owl:disjointWith ont:IntellectualProperty .

ont:ComplianceHotline a owl:Class ;
    rdfs:comment "An internal reporting channel for employees to anonymously raise concerns about unethical or illegal activities within a company." ;
    rdfs:subClassOf ont:Platform .

ont:Concept a owl:Class ;
    rdfs:comment "An abstract idea or theory, such as 'Supercloud', that is discussed and analyzed for its potential market impact." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:ConcertTour a owl:Class ;
    rdfs:comment "A series of live musical performances by an artist or group of artists in different cities or venues." ;
    rdfs:subClassOf ont:SocialEvent .

ont:ConnectedTV a owl:Class ;
    rdfs:comment "A television set that is connected to the internet, representing a growing channel for digital advertising and a target for ad fraud." ;
    rdfs:subClassOf ont:Product .

ont:Consumer a owl:Class ;
    rdfs:comment "An individual who purchases goods or services for personal use, representing the end-user in a B2C or B2B2C transaction." ;
    rdfs:subClassOf ont:Role .

ont:ConsumerProduct a owl:Class ;
    rdfs:comment "A product bought by final consumers for personal consumption." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:MediaProduct .

ont:ConsultingAgreement a owl:Class ;
    rdfs:comment "A formal contract where an individual provides expert advice or services to an organization for a specified period, often following a change in employment status." ;
    rdfs:subClassOf ont:Agreement .

ont:ConsultingFirm a owl:Class ;
    rdfs:comment "A professional services firm that provides expert advice and analysis to other organizations." ;
    rdfs:subClassOf ont:Company .

ont:Contract a owl:Class ;
    rdfs:comment "A legally binding agreement between parties, such as between a platform and its advertisers, outlining terms of service and payment." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Contribution a owl:Class ;
    rdfs:comment "The act of providing information or analysis that is incorporated into a larger report or news story." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:ProductionEvent , ont:Transaction .

ont:CorporateAcquisition a owl:Class ;
    rdfs:comment "The event of one company purchasing another, a significant market event that impacts valuation, ownership, and strategy." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:CorporateEvent a owl:Class ;
    rdfs:comment "A significant occurrence related to a company's operations, structure, or workforce. Consolidates former BusinessEvent class." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:LegalEvent .

ont:CorporateGovernanceIndicator a owl:Class ;
    rdfs:comment "A measurable signal or metric that reflects the state of a company's system of rules, practices, and processes by which it is directed and controlled." ;
    rdfs:subClassOf ont:Indicator .

ont:CorporateGovernanceIssue a owl:Class ;
    rdfs:comment "A significant internal problem or event related to the rules, practices, and processes by which a firm is directed and controlled, such as a dispute over access to funds." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:CorporateTakeover a owl:Class ;
    rdfs:comment "A significant market event where one entity acquires control of another company, often leading to substantial organizational and strategic impacts." ;
    rdfs:subClassOf ont:CorporateEvent ;
    owl:disjointWith ont:BrandingChange , ont:ProductChange .

ont:CostOptimization a owl:Class ;
    rdfs:comment "A business-focused process of reducing expenditures to improve financial results, often analyzed as a corporate strategy." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:Country a owl:Class ;
    rdfs:comment "A sovereign nation-state involved in or affected by international legal, political and business events." ;
    rdfs:subClassOf ont:AdministrativeDivision ;
    owl:disjointWith ont:JudicialDistrict , ont:State .

ont:Court a owl:Class ;
    rdfs:comment "An official judicial body with the authority to hear and decide legal disputes and cases." ;
    rdfs:subClassOf ont:GovernmentBody , ont:GovernmentOrganization .

ont:CourtHearing a owl:Class ;
    rdfs:comment "A formal proceeding before a judicial body to review evidence, hear arguments, and make determinations in a legal case." ;
    rdfs:subClassOf ont:LegalProceeding ;
    owl:disjointWith ont:Lawsuit .

ont:CoworkingSpace a owl:Class ;
    rdfs:comment "A shared office environment used by freelancers, remote workers, and digital nomads, often indicative of a growing expat community." ;
    rdfs:subClassOf ont:BusinessPremises .

ont:CreativeWork a owl:Class ;
    rdfs:comment "An intangible creative product, such as a film, book, or piece of music." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:CreditCard a owl:Class ;
    rdfs:comment "A payment card issued to users to enable the cardholder to pay a merchant for goods and services." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:DigitalProduct , ont:Weapon .

ont:CreditUnion a owl:Class ;
    rdfs:comment "A member-owned, not-for-profit financial cooperative that provides financial services to its members." ;
    rdfs:subClassOf ont:FinancialInstitution .

ont:Crime a owl:Class ;
    rdfs:comment "An action or omission that constitutes an offense that may be prosecuted by the state and is punishable by law." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:RiderAppInstall , ont:TechnicalIssue .

ont:CriminalCharge a owl:Class ;
    rdfs:comment "A formal accusation of a crime, serving as the basis for legal proceedings against an individual or entity." ;
    rdfs:subClassOf ont:LegalConcept ;
    owl:disjointWith ont:Visa .

ont:CriminalOrganization a owl:Class ;
    rdfs:comment "A group of individuals with a defined hierarchy, or a loosely-knit network of criminals, who work together to engage in illegal activities." ;
    rdfs:subClassOf ont:Organization .

ont:CriminalScheme a owl:Class ;
    rdfs:comment "An organized, systematic plan designed to commit illegal acts, such as visa fraud, for financial gain." ;
    rdfs:subClassOf ont:Scheme ;
    owl:disjointWith ont:GovernmentProgram .

ont:Crisis a owl:Class ;
    rdfs:comment "A time of intense difficulty, trouble, or danger." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:CrossCloudComputing a owl:Class ;
    rdfs:comment "The practice of using multiple cloud computing services in a single, heterogeneous architecture, analyzed as a market trend." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:Cryptocurrency a owl:Class ;
    rdfs:comment "A type of digital or virtual currency that uses cryptography for security, representing a new and often volatile asset class impacting financial markets." ;
    rdfs:subClassOf ont:DigitalAsset .

ont:CSRInitiative a owl:Class ;
    rdfs:comment "A corporate social responsibility program or action undertaken by a company." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Crime , ont:RiderAppInstall .

ont:Cybercrime a owl:Class ;
    rdfs:comment "Criminal activities that are carried out by means of computers or the Internet." ;
    rdfs:subClassOf ont:Crime ;
    owl:disjointWith ont:TangibleCrime .

ont:CybercrimeGang a owl:Class ;
    rdfs:comment "An organized group of individuals who collaborate to commit crimes online, often perpetrating large-scale ad fraud." ;
    rdfs:subClassOf ont:CriminalOrganization ;
    owl:disjointWith ont:OrganizedCrime .

ont:Cybersecurity a owl:Class ;
    rdfs:comment "The field concerned with protecting computer systems and networks from attack, damage, or unauthorized access, viewed as a critical area of market investment and concern." ;
    rdfs:subClassOf ont:Technology .

ont:CyclingInfrastructure a owl:Class ;
    rdfs:comment "Infrastructure specific to cycling, such as bike lanes and trails." ;
    rdfs:subClassOf ont:Infrastructure .

ont:CyclingRace a owl:Class ;
    rdfs:comment "A competitive cycling event, such as a road race in the Olympics or a multi-stage tour." ;
    rdfs:subClassOf ont:SportingEvent .

ont:Data a owl:Class ;
    rdfs:comment "A collection of specific figures or statistics, such as survey results, used to support an observation or analysis of market trends." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Publication , ont:Report .

ont:DataProvider a owl:Class ;
    rdfs:comment "An organization that collects, analyzes, and supplies data, particularly on executive compensation and corporate governance." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:ExecutiveSearchFirm , ont:SoftwareCompany , ont:UtilityCompany .

ont:DecentralizedEntity a owl:Class ;
    rdfs:comment "An organization or system that operates without a central governing body, often associated with blockchain and decentralized finance technologies." ;
    rdfs:subClassOf ont:Organization .

ont:DecentralizedFinance a owl:Class ;
    rdfs:comment "An emerging financial technology based on secure distributed ledgers similar to those used by cryptocurrencies, which aims to remove the control banks and institutions have on money, financial products, and financial services." ;
    rdfs:subClassOf ont:FinanceConcept .

ont:Deliberation a owl:Class ;
    rdfs:comment "A formal process of long and careful consideration or discussion by an official body regarding a specific issue, such as a government agency's analysis of a topic." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:PublicationEvent , ont:RegulatoryEvent .

ont:DemographicGroup a owl:Class ;
    rdfs:comment "A specific segment of a population having shared characteristics." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Metric , ont:Role , ont:SpeechAct .

ont:Demolition a owl:Class ;
    rdfs:comment "The event of tearing down buildings or housing developments, often as part of urban renewal or redevelopment projects." ;
    rdfs:subClassOf ont:RealEstateActivity .

ont:Demonym a owl:Class ;
    rdfs:comment "A term used to identify a group of people related to a particular place or ethnicity, relevant in the context of international travel policies." ;
    rdfs:subClassOf ont:DemographicGroup .

ont:Departure a owl:Class ;
    rdfs:comment "A market-moving event where a key executive or leader leaves their role, often signaling a shift in strategy or performance." ;
    rdfs:subClassOf ont:CareerEvent .

ont:Design a owl:Class ;
    rdfs:comment "A plan or drawing produced to show the look and function or workings of a building, garment, or other object before it is built or made." ;
    rdfs:subClassOf ont:AcademicDiscipline .

ont:Developer a owl:Class ;
    rdfs:comment "An individual or company involved in the construction or renovation of real estate properties." ;
    rdfs:subClassOf ont:Role .

ont:DigitalAsset a owl:Class ;
    rdfs:comment "Any representation of value that is recorded on a cryptographically-secured distributed ledger or any similar technology, impacting traditional financial markets." ;
    rdfs:subClassOf ont:Product .

ont:DigitalAssetCreationTool a owl:Class ;
    rdfs:comment "A category of software used for creating and editing digital media, such as vector graphics or images." ;
    rdfs:subClassOf ont:SoftwareTool ;
    owl:disjointWith ont:InteractiveProductDesignTool .

ont:DigitalDistributionPlatform a owl:Class ;
    rdfs:comment "An online marketplace, such as an app store, that distributes software and enforces rules on its content and presentation." ;
    rdfs:subClassOf ont:DigitalPlatform ;
    owl:disjointWith ont:SocialMediaPlatform .

ont:DigitalNomad a owl:Class ;
    rdfs:comment "An individual who works remotely while traveling, often attracted by specific visa and tax policies, and impacting local housing markets." ;
    rdfs:subClassOf ont:Professional .

ont:DigitalPlatform a owl:Class ;
    rdfs:comment "A platform that exists in a digital or online environment." ;
    rdfs:subClassOf ont:Platform .

ont:DigitalProduct a owl:Class ;
    rdfs:comment "An intangible product that exists in a digital format." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Weapon .

ont:DigitalWallet a owl:Class ;
    rdfs:comment "A software-based system that securely stores users' payment information and funds for digital transactions." ;
    rdfs:subClassOf ont:Software .

ont:DiningEstablishment a owl:Class ;
    rdfs:comment "A restaurant categorized by its style of service and cuisine." ;
    rdfs:subClassOf ont:Restaurant .

ont:DiscountRetailer a owl:Class ;
    rdfs:comment "A type of retail company that sells products at prices lower than the typical market value, often benefiting from shifts in consumer spending." ;
    rdfs:subClassOf ont:Retailer ;
    owl:disjointWith ont:GroceryStore .

ont:Discrimination a owl:Class ;
    rdfs:comment "The unjust or prejudicial treatment of different categories of people, especially on the grounds of gender." ;
    rdfs:subClassOf ont:Challenge ;
    owl:disjointWith ont:Harassment , ont:Issue .

ont:DiscriminationType a owl:Class ;
    rdfs:comment "A specific category of illegal or unfair treatment, such as on the basis of sex, race, or age, which can be the subject of a lawsuit." ;
    rdfs:subClassOf ont:Type .

ont:Diversity a owl:Class ;
    rdfs:comment "The practice or quality of including or involving people from a range of different social and ethnic backgrounds and of different genders, sexual orientations, etc., as a corporate responsibility." ;
    rdfs:subClassOf ont:TalentManagement ;
    owl:disjointWith ont:SeniorLeadershipTalentIdentification , ont:SuccessionPlanning .

ont:Doctor a owl:Class ;
    rdfs:comment "A medical professional, representing a class of essential workers who may be priced out of urban housing markets." ;
    rdfs:subClassOf ont:Role .

ont:Document a owl:Class ;
    rdfs:comment "A piece of written, printed, or electronic matter that provides information or evidence or that serves as an official record." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:UserGeneratedContent .

ont:Domain a owl:Class ;
    rdfs:comment "A specified sphere of activity or knowledge." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role , ont:Strategy .

ont:DrugUser a owl:Class ;
    rdfs:comment "An individual who consumes illicit substances, sometimes associated with social problems in neglected or marginalized urban areas." ;
    rdfs:subClassOf ont:Role .

ont:DryShampoo a owl:Class ;
    rdfs:comment "A category of haircare product designed to clean hair without water, which has been the subject of market-moving events due to contamination concerns." ;
    rdfs:subClassOf ont:HaircareProduct .

ont:EarningsReport a owl:Class ;
    rdfs:comment "A formal public statement of a company's profitability for a specific period, which is a key market-moving event." ;
    rdfs:subClassOf ont:Report .

ont:EarningsResult a owl:Class ;
    rdfs:comment "A formal report of a company's financial performance over a specific period, which can act as a trigger for subsequent corporate actions." ;
    rdfs:subClassOf ont:Metric .

ont:EcommerceHub a owl:Class ;
    rdfs:comment "A central online platform for commercial transactions, where consumers can browse and purchase goods and services from various vendors." ;
    rdfs:subClassOf ont:Platform .

ont:EconomicConcept a owl:Class ;
    rdfs:comment "A fundamental idea or principle related to the economy, such as inflation or interest rates, that influences market and consumer behavior." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:DemographicGroup , ont:EconomicTrend , ont:Metric , ont:Role , ont:SpeechAct .

ont:EconomicIssue a owl:Class ;
    rdfs:comment "A widespread problem affecting the economy, such as a labor shortage in a key industrial sector." ;
    rdfs:subClassOf ont:Issue ;
    owl:disjointWith ont:SocialIssue , ont:WorkplaceIssue .

ont:EconomicPolicy a owl:Class ;
    rdfs:comment "A course of action adopted by a government to influence the economy, such as deregulation or liberalisation of markets." ;
    rdfs:subClassOf ont:GovernmentPolicy .

ont:EconomicRecovery a owl:Class ;
    rdfs:comment "A period of renewed economic growth following a recession, which can trigger new market dynamics and social challenges." ;
    rdfs:subClassOf ont:EconomicSituation .

ont:EconomicSituation a owl:Class ;
    rdfs:comment "The state of the economy in a country or region, changing over a period of time." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:EconomicTrend a owl:Class ;
    rdfs:comment "A discernible pattern or direction in economic activity, such as changes in consumer spending habits." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:DemographicGroup , ont:Metric , ont:Role , ont:SpeechAct .

ont:EducationalEvent a owl:Class ;
    rdfs:comment "An event designed for the purpose of teaching or learning." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Transaction .

ont:EducationalInstitution a owl:Class ;
    rdfs:comment "An organization providing educational services, such as a school or university." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:GovernmentAgency , ont:InvestmentFirm , ont:MarketResearchFirm , ont:MediaOutlet , ont:Publication , ont:ResearchInstitute , ont:SportsTeam , ont:UtilityCompany .

ont:EducationalOrganization a owl:Class ;
    rdfs:comment "An organization whose primary purpose is education." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:SportsTeam .

ont:ElectricVehicle a owl:Class ;
    rdfs:comment "A class of automobiles that are propelled by one or more electric motors, using energy stored in rechargeable batteries." ;
    rdfs:subClassOf ont:Vehicle .

ont:EliteAthlete a owl:Class ;
    rdfs:comment "A top-tier professional competitor in the sport of cycling." ;
    rdfs:subClassOf ont:Person .

ont:Email a owl:Class ;
    rdfs:comment "A message distributed by electronic means from one computer user to one or more recipients via a network." ;
    rdfs:subClassOf ont:Communication ;
    owl:disjointWith ont:SocialMediaPost , ont:Statement .

ont:EmployeeOverFifty a owl:Class ;
    rdfs:comment "An employee aged fifty years or older." ;
    rdfs:subClassOf ont:DemographicGroup .

ont:Employment a owl:Class ;
    rdfs:comment "A formal arrangement representing a person's professional history with a company, which can be a precursor to more impactful roles." ;
    rdfs:subClassOf ont:SituationOrProcess ;
    owl:disjointWith ont:Litigation , ont:Ownership .

ont:Energy a owl:Class ;
    rdfs:comment "The capacity for doing work, which may exist in potential, kinetic, thermal, electrical, chemical, nuclear, or other various forms." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:EnergyStorageTechnology a owl:Class ;
    rdfs:comment "Technology used to store energy for later use." ;
    rdfs:subClassOf ont:EnergyTechnology ;
    owl:disjointWith ont:RenewableEnergy .

ont:EnergyTechnology a owl:Class ;
    rdfs:comment "Technology specifically designed for the generation, storage, or transmission of energy." ;
    rdfs:subClassOf ont:Technology .

ont:Engineering a owl:Class ;
    rdfs:comment "The professional field concerned with designing, building, and using engines, machines, and structures." ;
    rdfs:subClassOf ont:AcademicDiscipline ;
    owl:disjointWith ont:PackageDesign .

ont:EnterpriseWorkload a owl:Class ;
    rdfs:comment "The total amount of processing that a company's computer systems are required to perform, a key asset in technology acquisitions." ;
    rdfs:subClassOf ont:Workload .

ont:EntityTypeRole a owl:Class ;
    rdfs:comment "A classification representing the function or category of an organization within the context of a legal or political event, such as a social media provider." ;
    rdfs:subClassOf ont:Role ;
    owl:disjointWith ont:PoliticalRole .

ont:EthicsAndCompliance a owl:Class ;
    rdfs:comment "The set of internal rules, policies, and procedures a company follows to ensure it operates within the law and maintains high standards of business conduct." ;
    rdfs:subClassOf ont:Compliance .

ont:Example a owl:Class ;
    rdfs:comment "A representative instance used to illustrate a concept, such as a fake domain name used to explain spoofing." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Budget , ont:Metric , ont:Problem , ont:Role , ont:Solution , ont:Technique .

ont:Executive a owl:Class ;
    rdfs:comment "A senior-level manager or director within a company who has significant decision-making authority." ;
    rdfs:subClassOf ont:Role .

ont:ExecutiveRole a owl:Class ;
    rdfs:comment "A high-level management position within an organization, responsible for strategy and leadership." ;
    rdfs:subClassOf ont:Role .

ont:ExecutiveSearchFirm a owl:Class ;
    rdfs:comment "A specialized consulting firm that advises on and recruits high-level executives for client organizations." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:SoftwareCompany , ont:UtilityCompany .

ont:Expat a owl:Class ;
    rdfs:comment "A person who lives outside their native country." ;
    rdfs:subClassOf ont:Person .

ont:Expert a owl:Class ;
    rdfs:comment "A person who has a comprehensive and authoritative knowledge of or skill in a particular area." ;
    rdfs:subClassOf ont:Role .

ont:ExpertAssessment a owl:Class ;
    rdfs:comment "A formal evaluation or analysis of a market event provided by a recognized authority or specialist in the field." ;
    rdfs:subClassOf ont:Assessment .

ont:ExternalCounsel a owl:Class ;
    rdfs:comment "Legal advisors from an outside law firm hired by a company to provide specialized legal advice or representation, often during investigations or litigation." ;
    rdfs:subClassOf ont:Expert .

ont:Extradition a owl:Class ;
    rdfs:comment "The formal legal process of surrendering an alleged criminal by one state or country to another for trial." ;
    rdfs:subClassOf ont:LegalEvent ;
    owl:disjointWith ont:Indictment .

ont:Facility a owl:Class ;
    rdfs:comment "A general term for a place, such as a power plant, built for a particular purpose in the energy infrastructure." ;
    rdfs:subClassOf ont:Building , ont:Infrastructure .

ont:Factory a owl:Class ;
    rdfs:comment "An industrial facility for manufacturing products, specifically energy storage systems in this context." ;
    rdfs:subClassOf ont:Facility ;
    owl:disjointWith ont:PowerPlant .

ont:Family a owl:Class ;
    rdfs:comment "A group of related individuals, particularly those with significant influence or investment in the cycling world." ;
    rdfs:subClassOf ont:Group ;
    owl:disjointWith ont:SportsTeam .

ont:FamilyLeave a owl:Class ;
    rdfs:comment "A leave of absence from work granted to an employee to care for a family member." ;
    rdfs:subClassOf ont:LeaveOfAbsence .

ont:Fan a owl:Class ;
    rdfs:comment "An individual consumer of live entertainment who purchases tickets and is affected by market practices." ;
    rdfs:subClassOf ont:Person .

ont:FashionHouse a owl:Class ;
    rdfs:comment "A company that designs, creates, and markets high-end clothing and accessories, particularly in the bridal industry." ;
    rdfs:subClassOf ont:Company .

ont:FastFoodRestaurantChain a owl:Class ;
    rdfs:comment "A type of company that operates quick-service restaurants, whose performance is an indicator of consumer spending on convenience and value." ;
    rdfs:subClassOf ont:Restaurant .

ont:FederalAgency a owl:Class ;
    rdfs:comment "An agency of a federal government." ;
    rdfs:subClassOf ont:GovernmentAgency .

ont:FederalLaw a owl:Class ;
    rdfs:comment "A body of law at the highest or national level of a federal government." ;
    rdfs:subClassOf ont:Law .

ont:Festival a owl:Class ;
    rdfs:comment "A period of celebration or a series of organized events, often centered around a specific theme." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:SportingEvent .

ont:FieldOfStudy a owl:Class ;
    rdfs:comment "A branch of knowledge or an academic discipline." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Metric , ont:Plan , ont:Role .

ont:FifthGenerationNetwork a owl:Class ;
    rdfs:comment "A type of advanced wireless network technology that is a key strategic asset in the telecommunications market." ;
    rdfs:subClassOf ont:Network .

ont:Film a owl:Class ;
    rdfs:comment "A motion picture, often a documentary, that chronicles the life or events related to an influential business figure." ;
    rdfs:subClassOf ont:CreativeWork .

ont:FilmFestival a owl:Class ;
    rdfs:comment "An organized event that showcases films, providing a platform for premieres and public exposure that can influence perception." ;
    rdfs:subClassOf ont:Festival .

ont:FinanceConcept a owl:Class ;
    rdfs:comment "An abstract concept related to the management of money, credit, and investments." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:FinancialConcept a owl:Class ;
    rdfs:comment "An abstract idea or plan related to finance, money, or capital." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:AcademicDiscipline , ont:Allegation , ont:Law , ont:Need , ont:Role .

ont:FinancialCrisis a owl:Class ;
    rdfs:comment "A major disruption in the financial system, often acting as a catalyst for subsequent economic policies and social changes." ;
    rdfs:subClassOf ont:Crisis .

ont:FinancialForecast a owl:Class ;
    rdfs:comment "An analyst's or company's projection of future financial performance, such as revenue or sales growth." ;
    rdfs:subClassOf ont:Forecast .

ont:FinancialFraud a owl:Class ;
    rdfs:comment "The act of intentional deception involving financial systems or reporting, often to mislead investors or inflate a company's value." ;
    rdfs:subClassOf ont:Crime .

ont:FinancialInstrument a owl:Class ;
    rdfs:comment "A tradable asset of any kind; either cash, evidence of an ownership interest in an entity, or a contractual right to receive or deliver cash or another financial instrument." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:FinancialInstitution a owl:Class ;
    rdfs:comment "An organization that deals with financial and monetary transactions such as deposits, loans, investments, and currency exchange." ;
    rdfs:subClassOf ont:Organization .

ont:FinancialMetric a owl:Class ;
    rdfs:comment "A quantifiable measure used to track, assess, and analyze the financial performance and valuation of companies involved in market events." ;
    rdfs:subClassOf ont:Metric ;
    owl:disjointWith ont:Measurement .

ont:FinancialRating a owl:Class ;
    rdfs:comment "A formal assessment of a company's creditworthiness and financial stability by a rating agency." ;
    rdfs:subClassOf ont:FinancialConcept ;
    owl:disjointWith ont:FinancialState , ont:Investment .

ont:FinancialReport a owl:Class ;
    rdfs:comment "A formal record of the financial activities and position of a business, person, or other entity, used for performance analysis." ;
    rdfs:subClassOf ont:Report .

ont:FinancialState a owl:Class ;
    rdfs:comment "The overall condition of a company's financial health, such as achieving consistent profitability." ;
    rdfs:subClassOf ont:FinancialConcept ;
    owl:disjointWith ont:Investment .

ont:FinancialStatement a owl:Class ;
    rdfs:comment "Formal records of a company's financial activities, such as balance sheets and income statements, which are subject to audit and regulatory scrutiny." ;
    rdfs:subClassOf ont:Document .

ont:FinancialTransaction a owl:Class ;
    rdfs:comment "A specific financial action, such as the repayment of a large amount of debt." ;
    rdfs:subClassOf ont:Transaction .

ont:Financing a owl:Class ;
    rdfs:comment "A financial event representing a round of capital investment raised by a company to fund its operations and growth." ;
    rdfs:subClassOf ont:FinancialInstrument ;
    owl:disjointWith ont:Grant , ont:Incentive .

ont:FintechCompany a owl:Class ;
    rdfs:comment "An enterprise that uses technology to improve, automate, or innovate financial services, often partnering with or competing against traditional banks." ;
    rdfs:subClassOf ont:FinancialInstitution .

ont:FiringEvent a owl:Class ;
    rdfs:comment "A consequential action following a corporate takeover where key executives are dismissed from their roles." ;
    rdfs:subClassOf ont:PersonnelEvent .

ont:Food a owl:Class ;
    rdfs:comment "Any nutritious substance that people or animals eat or drink, or that plants absorb, in order to maintain life and growth." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:ConsumerProduct , ont:Medication , ont:Service .

ont:Forecast a owl:Class ;
    rdfs:comment "A prediction or estimate of future events, especially coming trends or a financial calculation." ;
    rdfs:subClassOf ont:Metric .

ont:ForeignInvestment a owl:Class ;
    rdfs:comment "The flow of capital from one country to another, a key driver of economic recovery and real estate market changes." ;
    rdfs:subClassOf ont:EconomicSituation .

ont:FormerEmployee a owl:Class ;
    rdfs:comment "An individual who was previously employed by a company and may be involved in subsequent legal action against it." ;
    rdfs:subClassOf ont:DemographicGroup .

ont:FortuneFiveHundredCompany a owl:Class ;
    rdfs:comment "A classification for one of the largest U.S. companies, indicating significant market presence and influence." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:RetailCompany .

ont:Founding a owl:Class ;
    rdfs:comment "The event marking the creation and launch of a company, often involving key individuals and initial funding." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:FreshProduce a owl:Class ;
    rdfs:comment "A category of food items, including fruits and vegetables, that are unprocessed and not preserved, central to concerns about food access." ;
    rdfs:subClassOf ont:Food .

ont:FullServiceDining a owl:Class ;
    rdfs:comment "A category of restaurants providing seated table service, representing a higher-cost dining option that consumers may trade down from." ;
    rdfs:subClassOf ont:DiningEstablishment .

ont:FundingRound a owl:Class ;
    rdfs:comment "An event where a company seeks to raise capital from investors, often categorized into distinct stages (e.g., Series A, B, C)." ;
    rdfs:subClassOf ont:CorporateEvent , ont:Transaction .

ont:Gathering a owl:Class ;
    rdfs:comment "An assembly or meeting of people." ;
    rdfs:subClassOf ont:Event .

ont:GeneralCounsel a owl:Class ;
    rdfs:comment "The chief lawyer of a legal department, whose compensation is analyzed as part of broader C-suite pay trends." ;
    rdfs:subClassOf ont:CLevelExecutive ;
    owl:disjointWith ont:ItHead , ont:ManagementStar .

ont:GenerativeArtificialIntelligence a owl:Class ;
    rdfs:comment "A subset of AI focused on creating new content, analyzed as a transformative technology and a major area of market investment and competition." ;
    rdfs:subClassOf ont:ArtificialIntelligence .

ont:GeopoliticalEntity a owl:Class ;
    rdfs:comment "A politically defined geographical area, such as a state, country, or city." ;
    rdfs:subClassOf ont:Place ;
    owl:disjointWith ont:Infrastructure , ont:Location , ont:RuralArea , ont:Workplace .

ont:GiftRegistry a owl:Class ;
    rdfs:comment "A service that assists a person or couple in communicating gift preferences to gift-givers." ;
    rdfs:subClassOf ont:Platform .

ont:Goal a owl:Class ;
    rdfs:comment "A strategic objective or target set by a government or organization, such as achieving a certain level of clean electricity." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Market , ont:Metric , ont:Role .

ont:Good a owl:Class ;
    rdfs:comment "A category of tangible products or merchandise that can be exchanged within a digital marketplace." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Platform , ont:Service , ont:Technology .

ont:GoverningBody a owl:Class ;
    rdfs:comment "An organization that has the function of administering and regulating a particular activity or sphere." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:Nonprofit .

ont:Government a owl:Class ;
    rdfs:comment "The national governing body of a country, responsible for creating and implementing nationwide policies." ;
    rdfs:subClassOf ont:Organization .

ont:GovernmentAgency a owl:Class ;
    rdfs:comment "An official administrative unit of a government responsible for law enforcement, prosecution and specific regulatory or oversight functions." ;
    rdfs:subClassOf ont:GovernmentBody , ont:GovernmentOrganization .

ont:GovernmentBody a owl:Class ;
    rdfs:comment "An organization that is part of a government's structure and is responsible for public administration and services." ;
    rdfs:subClassOf ont:GovernmentOrganization ;
    owl:disjointWith ont:Company , ont:MediaOrganization , ont:NewsOrganization .

ont:GovernmentClient a owl:Class ;
    rdfs:comment "A government or public sector entity that purchases satellite or telecom services." ;
    rdfs:subClassOf ont:Client ;
    owl:disjointWith ont:RetailClient .

ont:GovernmentFiling a owl:Class ;
    rdfs:comment "A document filed with a government agency." ;
    rdfs:subClassOf ont:Document .

ont:GovernmentHearing a owl:Class ;
    rdfs:comment "A formal meeting or session held by a governmental body to gather information, hear testimony, and investigate a specific issue of public concern." ;
    rdfs:subClassOf ont:LegalProceeding ;
    owl:disjointWith ont:Investigation , ont:Lawsuit , ont:LegalSettlement , ont:Merger .

ont:GovernmentOrganization a owl:Class ;
    rdfs:comment "An organization that is part of the structure of a national, state, or local government." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company .

ont:GovernmentPolicy a owl:Class ;
    rdfs:comment "A policy enacted and enforced by a government." ;
    rdfs:subClassOf ont:Policy .

ont:GovernmentProgram a owl:Class ;
    rdfs:comment "A formal initiative established by a government, such as a visa waiver program, that can be impacted by criminal activities or international relations." ;
    rdfs:subClassOf ont:Scheme .

ont:Grant a owl:Class ;
    rdfs:comment "A sum of money awarded by a government or other organization for a specific purpose, such as technology research, that does not need to be repaid." ;
    rdfs:subClassOf ont:FinancialInstrument ;
    owl:disjointWith ont:Incentive .

ont:GreenEnergy a owl:Class ;
    rdfs:comment "A category of energy sources that are considered environmentally friendly and sustainable, often associated with electric vehicles." ;
    rdfs:subClassOf ont:Energy .

ont:GroceryStore a owl:Class ;
    rdfs:comment "A retail outlet that primarily sells food and household supplies, representing a key area of non-discretionary consumer spending." ;
    rdfs:subClassOf ont:Retailer .

ont:Group a owl:Class ;
    rdfs:comment "A number of people or things that are located, gathered, or classed together." ;
    rdfs:subClassOf ont:Agent ;
    owl:disjointWith ont:Organization , ont:Person .

ont:GroupOfPeople a owl:Class ;
    rdfs:comment "A collective of individuals, such as a family unit, affected by housing policies or events." ;
    rdfs:subClassOf ont:Group ;
    owl:disjointWith ont:OnlineCommunity .

ont:GrowthMetric a owl:Class ;
    rdfs:comment "A quantifiable indicator used to measure the expansion or increase in participation within the sport, such as membership or event days." ;
    rdfs:subClassOf ont:Metric .

ont:GuidanceIssuance a owl:Class ;
    rdfs:comment "A formal event where one or more regulatory bodies release official advice or rules to clarify policies and expectations for the institutions they oversee." ;
    rdfs:subClassOf ont:PublicationEvent ;
    owl:disjointWith ont:ReportPublication .

ont:HaircareProduct a owl:Class ;
    rdfs:comment "A category of consumer goods designed for the care and styling of hair, central to the business operations of companies in this market." ;
    rdfs:subClassOf ont:ConsumerProduct .

ont:Harassment a owl:Class ;
    rdfs:comment "Unwelcome conduct that is based on protected characteristics like gender." ;
    rdfs:subClassOf ont:Challenge ;
    owl:disjointWith ont:Issue .

ont:Hazard a owl:Class ;
    rdfs:comment "A potential source of harm or adverse effect, such as a chemical fire associated with a specific technology." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:NaturalPhenomenon .

ont:HealthyFood a owl:Class ;
    rdfs:comment "A category of food items considered beneficial to health, the availability of which is a central concern in the context of food deserts." ;
    rdfs:subClassOf ont:Food .

ont:HeatWave a owl:Class ;
    rdfs:comment "An uninstantiated concept representing a period of excessively hot weather that can strain energy grids and drive demand for storage." ;
    rdfs:subClassOf ont:NaturalPhenomenon .

ont:HoldingCompany a owl:Class ;
    rdfs:comment "A parent corporation that owns a controlling interest in other companies, often formed through a major corporate reorganization." ;
    rdfs:subClassOf ont:Company ;
    owl:disjointWith ont:TechnologyFirm .

ont:HorrorMovie a owl:Class ;
    rdfs:comment "A genre of film intended to frighten or disgust, representing a potential future creative project for an individual." ;
    rdfs:subClassOf ont:Film .

ont:Hotel a owl:Class ;
    rdfs:comment "A commercial establishment providing lodging, often competing with or replacing long-term residential housing." ;
    rdfs:subClassOf ont:BusinessPremises .

ont:HouseholdGood a owl:Class ;
    rdfs:comment "A category of consumer products for home use, relevant in analyzing spending patterns at discount and general retailers." ;
    rdfs:subClassOf ont:Product .

ont:HousingCooperative a owl:Class ;
    rdfs:comment "A form of housing ownership where residents collectively own and manage the property." ;
    rdfs:subClassOf ont:Organization .

ont:HousingCrisis a owl:Class ;
    rdfs:comment "A widespread societal problem characterized by a lack of affordable and adequate housing." ;
    rdfs:subClassOf ont:Crisis .

ont:HousingDevelopment a owl:Class ;
    rdfs:comment "A residential area, often comprising multiple buildings, that can be the subject of urban planning and social conflict." ;
    rdfs:subClassOf ont:Residence .

ont:HousingPlan a owl:Class ;
    rdfs:comment "A strategic initiative by a government body to address housing issues, often involving budget allocations and specific targets." ;
    rdfs:subClassOf ont:Plan .

ont:HousingPolicy a owl:Class ;
    rdfs:comment "A government plan or course of action intended to influence the availability, affordability, and quality of housing in a specific area." ;
    rdfs:subClassOf ont:GovernmentPolicy .

ont:HumanResourcesJob a owl:Class ;
    rdfs:comment "A professional role focused on managing a company's employees, representing a type of employment sought by residents." ;
    rdfs:subClassOf ont:Professional .

ont:HyperscaleCloud a owl:Class ;
    rdfs:comment "A massive-scale cloud computing environment, representing a major competitive force in the enterprise technology market." ;
    rdfs:subClassOf ont:CloudComputingService .

ont:IPAddress a owl:Class ;
    rdfs:comment "A unique numerical label assigned to each device connected to a computer network, used in identifying and tracking ad traffic." ;
    rdfs:subClassOf ont:Identifier ;
    owl:disjointWith ont:UserAgent .

ont:Idea a owl:Class ;
    rdfs:comment "A category representing concepts, thoughts, and opinions intended to be exchanged within a global digital marketplace." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Opportunity , ont:Plan , ont:Rule , ont:Term .

ont:Identifier a owl:Class ;
    rdfs:comment "A string of characters used to identify a user, device, or resource." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Immigrant a owl:Class ;
    rdfs:comment "A person who has moved to a new country to live permanently, often facing unique challenges in the housing market." ;
    rdfs:subClassOf ont:Person .

ont:ImmigrationPolicy a owl:Class ;
    rdfs:comment "A government strategy or program related to the entry and residency of foreign nationals." ;
    rdfs:subClassOf ont:GovernmentPolicy .

ont:Incentive a owl:Class ;
    rdfs:comment "A financial or policy package offered by a government entity to encourage specific economic activities, like building a factory." ;
    rdfs:subClassOf ont:FinancialInstrument .

ont:Incident a owl:Class ;
    rdfs:comment "An individual occurrence or event, often one that is unexpected, problematic, or significant." ;
    rdfs:subClassOf ont:Event .

ont:Indicator a owl:Class ;
    rdfs:comment "A measure or signal that provides information about a particular state or trend." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:CausalFactor , ont:Metric , ont:Role , ont:StockAward , ont:Trend .

ont:Indictment a owl:Class ;
    rdfs:comment "A formal legal document accusing one or more persons of a crime, issued by a grand jury." ;
    rdfs:subClassOf ont:LegalEvent .

ont:Information a owl:Class ;
    rdfs:comment "Facts provided or learned about something or someone, often communicated." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:InformationBearingObject a owl:Class ;
    rdfs:comment "An object, physical or digital, whose primary purpose is to contain and convey information." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:InformationEntity a owl:Class ;
    rdfs:comment "A unit of information or data, such as a logo, audio, or video." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:InformationObject a owl:Class ;
    rdfs:comment "A piece of content or data, such as a document, report, or media broadcast." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Infrastructure a owl:Class ;
    rdfs:comment "The basic physical and organizational structures and facilities needed for the operation of a society or enterprise." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:InitialPublicOffering a owl:Class ;
    rdfs:comment "An Initial Public Offering, the market event where a private company first sells shares of stock to the public." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:Insider a owl:Class ;
    rdfs:comment "An individual with access to confidential information about a company, such as an employee or executive." ;
    rdfs:subClassOf ont:Person .

ont:InstitutionalInvestor a owl:Class ;
    rdfs:comment "A non-bank entity that invests on behalf of its members, such as a pension fund, whose decisions can be influenced by advisory firms." ;
    rdfs:subClassOf ont:Organization .

ont:IntellectualProperty a owl:Class ;
    rdfs:comment "A category of corporate assets, including inventions, literary and artistic works, designs, and symbols, names and images used in commerce, managed by the legal team." ;
    rdfs:subClassOf ont:Domain .

ont:InteractiveProductDesignTool a owl:Class ;
    rdfs:comment "A category of software focused on collaborative design and prototyping of user interfaces and experiences." ;
    rdfs:subClassOf ont:SoftwareTool .

ont:InternalCounsel a owl:Class ;
    rdfs:comment "A company's in-house legal team responsible for managing legal affairs and compliance." ;
    rdfs:subClassOf ont:Role .

ont:InternalSystem a owl:Class ;
    rdfs:comment "A company's proprietary software and databases used for internal operations, such as managing customer data or ad performance." ;
    rdfs:subClassOf ont:Platform .

ont:Investigation a owl:Class ;
    rdfs:comment "A formal inquiry or systematic examination into an event or action to uncover facts, specifically regarding the legality and community impact of an event." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:CorporateEvent , ont:Communication , ont:GovernmentHearing , ont:Lawsuit , ont:LegalSettlement , ont:LifeMilestone , ont:ListeningSession , ont:Merger .

ont:Investment a owl:Class ;
    rdfs:comment "The allocation of capital with the expectation of generating income or profit." ;
    rdfs:subClassOf ont:FinancialConcept ;
    owl:disjointWith ont:FinancialState .

ont:InvestmentBank a owl:Class ;
    rdfs:comment "A financial services company that engages in advisory-based financial transactions on behalf of individuals, corporations, and governments." ;
    rdfs:subClassOf ont:Bank .

ont:InvestmentFirm a owl:Class ;
    rdfs:comment "A company that invests capital in other businesses, often focusing on specific sectors like technology or energy." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:GovernmentAgency , ont:MarketResearchFirm , ont:Publication , ont:ResearchInstitute , ont:UtilityCompany .

ont:Investor a owl:Class ;
    rdfs:comment "An individual or institution that commits capital to a company with the expectation of financial return, and whose interests are affected by market events." ;
    rdfs:subClassOf ont:Role .

ont:IsraeliCitizen a owl:Class ;
    rdfs:comment "A person holding nationality of the state of Israel, identified as a target group in a criminal scheme." ;
    rdfs:subClassOf ont:CitizenshipStatus ;
    owl:disjointWith ont:Noncitizen .

ont:Issue a owl:Class ;
    rdfs:comment "An important topic or problem for debate or discussion." ;
    rdfs:subClassOf ont:Challenge .

ont:ItHead a owl:Class ;
    rdfs:comment "The senior executive responsible for a company's information technology strategy and infrastructure." ;
    rdfs:subClassOf ont:ExecutiveRole ;
    owl:disjointWith ont:ManagementStar .

ont:JudicialDistrict a owl:Class ;
    rdfs:comment "A specific federal court's geographical jurisdiction where legal proceedings, such as a trial, are held." ;
    rdfs:subClassOf ont:AdministrativeDivision ;
    owl:disjointWith ont:State .

ont:KiranaStore a owl:Class ;
    rdfs:comment "A small, local, neighborhood retail shop in India, representing a key customer segment for B2B wholesale platforms." ;
    rdfs:subClassOf ont:Retailer .

ont:Kubernetes a owl:Class ;
    rdfs:comment "An open-source system for automating the deployment, scaling, and management of containerized applications, relevant to cloud technology analysis." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:Law a owl:Class ;
    rdfs:comment "A system of rules recognized by a country or community as regulating the actions of its members." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:FinancialConcept , ont:Metric , ont:Role .

ont:Lawsuit a owl:Class ;
    rdfs:comment "A formal legal action initiated by one party against another in a court of law to resolve a dispute." ;
    rdfs:subClassOf ont:LegalAction , ont:LegalProceeding ;
    owl:disjointWith ont:Communication , ont:CourtHearing , ont:Investigation , ont:LegalSettlement , ont:LifeMilestone , ont:Merger .

ont:LawsuitFiling a owl:Class ;
    rdfs:comment "The formal initiation of a legal case by one party against another, often related to corporate actions like layoffs or workplace conditions." ;
    rdfs:subClassOf ont:LegalAction , ont:LegalEvent .

ont:Layoff a owl:Class ;
    rdfs:comment "A corporate action involving the permanent or temporary termination of employees, often due to economic pressures or strategic changes." ;
    rdfs:subClassOf ont:PersonnelEvent .

ont:LeadershipDevelopmentOpportunity a owl:Class ;
    rdfs:comment "A chance for an individual to acquire and develop the skills and qualities required for leadership positions." ;
    rdfs:subClassOf ont:Plan ;
    owl:disjointWith ont:MentorshipProgram , ont:ProposedSolution .

ont:LeaveOfAbsence a owl:Class ;
    rdfs:comment "A period of time that one is permitted to be absent from work or duty." ;
    rdfs:subClassOf ont:Event .

ont:LegalAction a owl:Class ;
    rdfs:comment "An action or process within the legal system." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:ListeningSession , ont:Merger .

ont:LegalChallenge a owl:Class ;
    rdfs:comment "A formal action taken in a court of law to dispute a decision or policy, such as a demolition order." ;
    rdfs:subClassOf ont:LegalAction .

ont:LegalConcept a owl:Class ;
    rdfs:comment "A concept or principle that is part of a legal system." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role , ont:Scheme .

ont:LegalDispute a owl:DeprecatedClass ;
    rdfs:comment "This class has been removed and its usage merged into the 'Lawsuit' class for consolidation." ;
    rdfs:subClassOf ont:Event .

ont:LegalDocument a owl:Class ;
    rdfs:comment "An official paper or filing that states some contractual relationship or grants some right." ;
    rdfs:subClassOf ont:Document ;
    owl:disjointWith ont:Notification .

ont:LegalEvent a owl:Class ;
    rdfs:comment "An event occurring within a legal or judicial process." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:CorporateEvent , ont:ProductRecall .

ont:LegalExpert a owl:Class ;
    rdfs:comment "A professional with specialized knowledge of the law, who can provide analysis on corporate liability, regulatory compliance, and legal proceedings." ;
    rdfs:subClassOf ont:Expert .

ont:LegalHearing a owl:Class ;
    rdfs:comment "A formal proceeding before a court, such as one to grant final approval for a class action settlement." ;
    rdfs:subClassOf ont:LegalEvent ;
    owl:disjointWith ont:LegalSettlement .

ont:LegalProceeding a owl:Class ;
    rdfs:comment "A formal action, hearing, or trial in a court of law or before a government body." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:LegalRuling , ont:SocialEvent .

ont:LegalRuling a owl:Class ;
    rdfs:comment "A formal decision, order, or judgment made by a court or judge that resolves a legal issue." ;
    rdfs:subClassOf ont:LegalEvent .

ont:LegalSettlement a owl:Class ;
    rdfs:comment "A formal resolution of a legal dispute between opposing parties, reached either before or after court action begins, often involving specific terms and conditions." ;
    rdfs:subClassOf ont:LegalEvent , ont:LegalProceeding ;
    owl:disjointWith ont:ClassActionLawsuit , ont:Investigation , ont:Lawsuit , ont:Merger .

ont:LifeMilestone a owl:Class ;
    rdfs:comment "A significant event in a person's life, such as a wedding, which creates a market for related goods and services." ;
    rdfs:subClassOf ont:Event .

ont:ListeningSession a owl:Class ;
    rdfs:comment "A public meeting organized to gather feedback, concerns, and testimony from community members about a specific issue, such as a proposed merger." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Merger .

ont:Litigation a owl:Class ;
    rdfs:comment "The process of taking legal action, a key area of responsibility within a corporate legal department." ;
    rdfs:subClassOf ont:Event .

ont:Location a owl:Class ;
    rdfs:comment "A specific geographical place where a sporting event or a segment of it occurs." ;
    rdfs:subClassOf ont:Place .

ont:Logo a owl:Class ;
    rdfs:comment "A graphic mark or emblem used to identify a company or product, the alteration of which can be a significant market event." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Video .

ont:ManagedNetworkService a owl:Class ;
    rdfs:comment "A category of outsourced IT services where a third-party provider remotely manages a company's network infrastructure." ;
    rdfs:subClassOf ont:Service .

ont:ManagementStar a owl:Class ;
    rdfs:comment "A high-performing, highly valued executive within a company's leadership team, often seen as a potential successor or key talent to retain." ;
    rdfs:subClassOf ont:ExecutiveRole .

ont:Manufacturer a owl:Class ;
    rdfs:comment "A company that produces finished goods from raw materials, serving as a supplier to wholesale and retail platforms." ;
    rdfs:subClassOf ont:Company .

ont:Market a owl:Class ;
    rdfs:comment "A specific economic sector, such as the global energy storage industry, defined by the buying and selling of related goods and services." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:Metric , ont:Plan , ont:Program , ont:Role , ont:Sport .

ont:MarketConcept a owl:Class ;
    rdfs:comment "An abstract concept related to commercial markets and business positioning." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:FinancialConcept , ont:Role , ont:Strategy .

ont:MarketCondition a owl:Class ;
    rdfs:comment "A state of the financial markets, such as heightened uncertainty, often triggered by significant corporate events." ;
    rdfs:subClassOf ont:MarketConcept ;
    owl:disjointWith ont:MarketPosition .

ont:MarketMovement a owl:Class ;
    rdfs:comment "The overall change in value and direction of a financial market or a segment thereof." ;
    rdfs:subClassOf ont:Movement ;
    owl:disjointWith ont:StockPriceMovement .

ont:MarketPosition a owl:Class ;
    rdfs:comment "The standing or rank of a company relative to its competitors in a specific industry." ;
    rdfs:subClassOf ont:MarketConcept .

ont:MarketResearchFirm a owl:Class ;
    rdfs:comment "A company that gathers and analyzes data about markets to provide insights, forecasts, and business intelligence." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:InvestmentFirm , ont:Publication , ont:ResearchInstitute , ont:UtilityCompany .

ont:Marketer a owl:Class ;
    rdfs:comment "A professional or entity responsible for planning and executing advertising campaigns, who is a primary victim of ad fraud." ;
    rdfs:subClassOf ont:Role ;
    owl:disjointWith ont:MediaOwner .

ont:Marketing a owl:Class ;
    rdfs:comment "The business practice of promoting and selling products or services, analyzed in the context of company strategy and market positioning." ;
    rdfs:subClassOf ont:Plan .

ont:MarketingBudget a owl:Class ;
    rdfs:comment "The total amount of money allocated for promotional activities, which is wasted when spent on fraudulent ad impressions or clicks." ;
    rdfs:subClassOf ont:Budget .

ont:MarketingConsultant a owl:Class ;
    rdfs:comment "A professional who advises on marketing strategies, representing a type of skilled worker in the urban economy." ;
    rdfs:subClassOf ont:Professional .

ont:MarketingEmail a owl:Class ;
    rdfs:comment "A type of communication used by a company to promote its products or services to a target audience." ;
    rdfs:subClassOf ont:Email .

ont:MarketingDollar a owl:Class ;
    rdfs:comment "A unit of currency representing a company's budget for advertising and promotion, for which different platforms and media compete." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:Material a owl:Class ;
    rdfs:comment "A physical substance or mixture of substances that constitutes an object." ;
    rdfs:subClassOf ont:ConcreteEntity ;
    owl:disjointWith ont:Product .

ont:Measurement a owl:Class ;
    rdfs:comment "A quantified assessment of a physical or operational capacity within the energy sector, such as total grid storage." ;
    rdfs:subClassOf ont:Metric .

ont:MediaOrganization a owl:Class ;
    rdfs:comment "An entity engaged in the business of gathering and disseminating news and information to the public." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:GovernmentAgency .

ont:MediaOutlet a owl:Class ;
    rdfs:comment "An organization that reports on and disseminates information about market-moving events and expert opinions." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:EducationalInstitution .

ont:MediaOwner a owl:Class ;
    rdfs:comment "An entity that owns and operates a platform where ads are displayed, such as a website or app publisher." ;
    rdfs:subClassOf ont:Role .

ont:MediaProduct a owl:Class ;
    rdfs:comment "A product created for mass communication, such as a book, podcast, or publication." ;
    rdfs:subClassOf ont:Product .

ont:MedicalCondition a owl:Class ;
    rdfs:comment "A health-related state or issue that can influence personal decisions and subsequent business ventures." ;
    rdfs:subClassOf ont:Event .

ont:MedicalLeave a owl:Class ;
    rdfs:comment "A leave of absence from work to address health concerns." ;
    rdfs:subClassOf ont:LeaveOfAbsence .

ont:Medication a owl:Class ;
    rdfs:comment "A substance used for medical treatment, the accessibility of which is a key concern related to pharmacy closures." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:Service .

ont:MentorshipProgram a owl:Class ;
    rdfs:comment "A structured initiative designed to foster supportive relationships where experienced individuals guide less experienced ones." ;
    rdfs:subClassOf ont:Plan ;
    owl:disjointWith ont:ProposedSolution .

ont:Merger a owl:Class ;
    rdfs:comment "The corporate action or legal consolidation of combining two or more companies into a single entity, subject to regulatory review." ;
    rdfs:subClassOf ont:CorporateEvent ;
    owl:disjointWith ont:Investigation , ont:LegalSettlement , ont:Spinoff .

ont:MergerApproval a owl:Class ;
    rdfs:comment "A formal, legally binding authorization from a regulatory body that permits two or more companies to combine into a single entity." ;
    rdfs:subClassOf ont:Approval .

ont:Messaging a owl:Class ;
    rdfs:comment "A category of digital communication services, such as text or direct messages, forming a core component of an interactive platform." ;
    rdfs:subClassOf ont:Service ;
    owl:disjointWith ont:Payment .

ont:MetallicIronAnode a owl:Class ;
    rdfs:comment "An uninstantiated concept for the negative electrode in a battery, specifically one made of metallic iron." ;
    rdfs:subClassOf ont:BatteryComponent ;
    owl:disjointWith ont:AirCathode .

ont:Metric a owl:Class ;
    rdfs:comment "A standard of measurement or a quantitative assessment of a particular characteristic." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:BusinessPlan , ont:DemographicGroup , ont:EconomicTrend , ont:FinancialConcept , ont:Indicator , ont:Law , ont:Market , ont:Plan , ont:Problem , ont:Program , ont:Role , ont:Solution , ont:SpeechAct , ont:Sport , ont:StockAward , ont:Technique , ont:Trend .

ont:MicroservicesContainer a owl:Class ;
    rdfs:comment "A lightweight, standalone, executable package of software that includes everything needed to run an application, a key component of modern cloud architecture." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:MinorityDepositoryInstitution a owl:Class ;
    rdfs:comment "A federally insured depository institution where the majority of voting stock is owned by minority individuals, or a majority of the board of directors is minority and the community it serves is predominantly minority." ;
    rdfs:subClassOf ont:Bank .

ont:MobileApplication a owl:Class ;
    rdfs:comment "A software application designed to run on a mobile device such as a phone, tablet, or watch." ;
    rdfs:subClassOf ont:Software .

ont:MobileTelecomService a owl:Class ;
    rdfs:comment "A category of service providing wireless voice and data communication to consumers, a key business area for major US carriers." ;
    rdfs:subClassOf ont:TelecommunicationService .

ont:Movement a owl:Class ;
    rdfs:comment "A change or development in a value, price, or trend." ;
    rdfs:subClassOf ont:Event .

ont:NationalGoverningBody a owl:Class ;
    rdfs:comment "The primary organization responsible for managing and promoting a specific sport, like cycling, within a nation." ;
    rdfs:subClassOf ont:GoverningBody .

ont:NationalAdvertising a owl:Class ;
    rdfs:comment "Large-scale promotional campaigns run by major brands across a country, representing a significant source of revenue for media and platform companies." ;
    rdfs:subClassOf ont:Platform .

ont:NaturalPhenomenon a owl:Class ;
    rdfs:comment "An observable event or effect not caused by humans." ;
    rdfs:subClassOf ont:Event .

ont:Need a owl:Class ;
    rdfs:comment "A requirement for something essential or very important." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:FinancialConcept , ont:Role .

ont:Network a owl:Class ;
    rdfs:comment "A system of interconnected lines, channels, or nodes, especially for communication." ;
    rdfs:subClassOf ont:Infrastructure ;
    owl:disjointWith ont:SatelliteInfrastructure .

ont:NetworkingEvent a owl:Class ;
    rdfs:comment "A professional gathering designed to facilitate connections and discussions among individuals in a specific industry or with shared interests." ;
    rdfs:subClassOf ont:Gathering ;
    owl:disjointWith ont:TradeShow .

ont:NewsOrganization a owl:Class ;
    rdfs:comment "An entity that gathers, writes, and distributes news and information to the public, potentially triggering market-moving events." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:GovernmentBody .

ont:NonBatteryTechnology a owl:Class ;
    rdfs:comment "A category for energy storage methods that do not rely on electrochemical battery principles, such as pumped hydro or compressed air." ;
    rdfs:subClassOf ont:EnergyStorageTechnology .

ont:Noncitizen a owl:Class ;
    rdfs:comment "An individual who is not a citizen of the country they are entering or residing in, often the subject of immigration-related schemes." ;
    rdfs:subClassOf ont:CitizenshipStatus .

ont:NonEngineeringRole a owl:Class ;
    rdfs:comment "A job function within a company that is not primarily focused on technical development or engineering, often subject to restructuring after an acquisition." ;
    rdfs:subClassOf ont:Role .

ont:Nonprofit a owl:Class ;
    rdfs:comment "An organization that is not run for profit." ;
    rdfs:subClassOf ont:Organization .

ont:NonprofitOrganization a owl:Class ;
    rdfs:comment "An organization that operates for a collective, public, or social benefit, rather than for profit, such as the Better Business Bureau." ;
    rdfs:subClassOf ont:Organization .

ont:Notification a owl:Class ;
    rdfs:comment "A formal communication sent by a company to its users to inform them of changes or updates." ;
    rdfs:subClassOf ont:Document .

ont:Observation a owl:Class ;
    rdfs:comment "A statement or comment made by an influential party, such as a CEO, that provides insight into market conditions or company performance." ;
    rdfs:subClassOf ont:SpeechAct ;
    owl:disjointWith ont:Reaffirmation .

ont:Obstacle a owl:Class ;
    rdfs:comment "A barrier or impediment that hinders progress or advancement, particularly for women in the workplace." ;
    rdfs:subClassOf ont:Problem .

ont:OfflineStore a owl:Class ;
    rdfs:comment "A physical, brick-and-mortar retail location where customers can purchase goods in person." ;
    rdfs:subClassOf ont:Retailer .

ont:OlympicSport a owl:Class ;
    rdfs:comment "A sport that is competed at the Olympic Games." ;
    rdfs:subClassOf ont:Sport .

ont:OnlineBikeRetailer a owl:Class ;
    rdfs:comment "An online retailer of bikes." ;
    rdfs:subClassOf ont:Retailer .

ont:OnlineCommunity a owl:Class ;
    rdfs:comment "A web-based platform where individuals with shared interests, like digital nomads, connect and share information." ;
    rdfs:subClassOf ont:Group .

ont:OnlineDestination a owl:Class ;
    rdfs:comment "An online space for a specific purpose." ;
    rdfs:subClassOf ont:Platform .

ont:OpenSource a owl:Class ;
    rdfs:comment "A model of software development where source code is made publicly available, analyzed as a trend influencing the technology market." ;
    rdfs:subClassOf ont:Technology .

ont:Opportunity a owl:Class ;
    rdfs:comment "A category representing chances for advancement, employment, or other favorable circumstances intended to be exchanged in a digital marketplace." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Plan , ont:Rule , ont:Term .

ont:OrganicKiwi a owl:Class ;
    rdfs:comment "A category of fruit grown without synthetic pesticides or fertilizers, which can be the subject of a product recall." ;
    rdfs:subClassOf ont:Food .

ont:Organism a owl:Class ;
    rdfs:comment "An individual animal, plant, or single-celled life form." ;
    rdfs:subClassOf ont:Substance ;
    owl:disjointWith ont:ChemicalSubstance .

ont:Organization a owl:Class ;
    rdfs:comment "A formally constituted group or body of people with a particular purpose, such as a company, institution, or association." ;
    rdfs:subClassOf ont:Agent ;
    owl:disjointWith ont:Person , ont:RivalProvider , ont:SoftwareAgent .

ont:OrganizationalBody a owl:Class ;
    rdfs:comment "A formal group or committee within a larger organization, such as an executive committee, that has specific governance responsibilities." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:Company , ont:OrganizationalUnit .

ont:OrganizationalChange a owl:Class ;
    rdfs:comment "A significant event that alters a company's structure, strategy, or location of key functions, such as relocating a major executive role." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:PersonnelChange .

ont:OrganizationalEvent a owl:Class ;
    rdfs:comment "A significant internal occurrence within an organization, such as a reduction in workforce." ;
    rdfs:subClassOf ont:Event .

ont:OrganizationalState a owl:Class ;
    rdfs:comment "A condition or period affecting an organization's stability and operations, such as leadership turmoil." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:OrganizationalUnit a owl:Class ;
    rdfs:comment "A distinct part or division within a company's structure, such as a department." ;
    rdfs:subClassOf ont:Organization .

ont:OrganizedCrime a owl:Class ;
    rdfs:comment "Criminal activities that are planned and controlled by powerful groups and carried out on a large scale, which is often funded by ad fraud." ;
    rdfs:subClassOf ont:CriminalOrganization .

ont:Ownership a owl:Class ;
    rdfs:comment "The state or event of possessing a significant asset, like a company or sports team, which has market implications." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:PackageDesign a owl:Class ;
    rdfs:comment "The professional discipline of creating the container, graphics, and visible outer presence of a product." ;
    rdfs:subClassOf ont:FieldOfStudy .

ont:Pandemic a owl:Class ;
    rdfs:comment "A widespread global public health crisis that has a significant impact on sporting events and organizations." ;
    rdfs:subClassOf ont:Event .

ont:PartnershipAgreement a owl:Class ;
    rdfs:comment "A formal arrangement between two or more parties to manage and operate a business and share its profits, particularly between banks and fintech companies." ;
    rdfs:subClassOf ont:Agreement .

ont:PayTvBusiness a owl:Class ;
    rdfs:comment "A type of business focused on providing subscription-based television services, a core market for companies like Dish Network." ;
    rdfs:subClassOf ont:TelevisionService ;
    owl:disjointWith ont:StreamingTvService .

ont:Payment a owl:Class ;
    rdfs:comment "A category of services facilitating the transfer of funds, forming a core component of a future integrated digital platform." ;
    rdfs:subClassOf ont:FinancialConcept , ont:Service .

ont:PerformanceMetric a owl:Class ;
    rdfs:comment "A quantifiable measure used to track and assess the state or performance of a business process or operational goal." ;
    rdfs:subClassOf ont:Metric .

ont:Person a owl:Class ;
    rdfs:comment "An individual human being involved in or affected by market-moving events, such as an executive, founder, analyst, or consumer." ;
    rdfs:subClassOf ont:Agent ;
    owl:disjointWith ont:SoftwareAgent .

ont:PersonnelChange a owl:Class ;
    rdfs:comment "An event related to a person's employment status or position within an organization." ;
    rdfs:subClassOf ont:Event .

ont:PersonnelEvent a owl:Class ;
    rdfs:comment "An event related to the employment, status, or roles of individuals within an organization." ;
    rdfs:subClassOf ont:Event .

ont:PharmaceuticalNeed a owl:Class ;
    rdfs:comment "The requirement for prescription drugs or other pharmacy services by a population." ;
    rdfs:subClassOf ont:Need .

ont:Pharmacy a owl:Class ;
    rdfs:comment "A facility where medicinal drugs are dispensed, often located within a larger retail store." ;
    rdfs:subClassOf ont:RetailEstablishment ;
    owl:disjointWith ont:GroceryStore .

ont:PhysicalObject a owl:Class ;
    rdfs:comment "A tangible object that exists in the physical world." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:Place a owl:Class ;
    rdfs:comment "A particular position, point, or area in space; a location." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:Plan a owl:Class ;
    rdfs:comment "A detailed proposal for doing or achieving something." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:Market , ont:Metric , ont:Program , ont:Role , ont:Sport .

ont:PlantFloorOperation a owl:Class ;
    rdfs:comment "The activities and processes that occur on the production floor of a manufacturing facility." ;
    rdfs:subClassOf ont:Workplace .

ont:Platform a owl:Class ;
    rdfs:comment "A digital or physical environment in which a service is delivered or a product is used." ;
    rdfs:subClassOf ont:DigitalProduct ;
    owl:disjointWith ont:Service , ont:Technology .

ont:PlatformRule a owl:Class ;
    rdfs:comment "A guideline or constraint imposed by a digital distribution platform that governs the apps it hosts." ;
    rdfs:subClassOf ont:Rule .

ont:Podcast a owl:Class ;
    rdfs:comment "A digital audio program, serving as a medium for industry analysis and discussion of market-moving events." ;
    rdfs:subClassOf ont:MediaProduct .

ont:Policy a owl:Class ;
    rdfs:comment "A course or principle of action adopted or proposed by a government, party, business, or individual." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:PolicyChange a owl:Class ;
    rdfs:comment "A modification or reversal of a government policy, such as stopping a visa scheme or placing a moratorium on licenses." ;
    rdfs:subClassOf ont:Event .

ont:PoliticalRole a owl:Class ;
    rdfs:comment "A position or title held within a political system, such as a president appointed by a specific party." ;
    rdfs:subClassOf ont:Role .

ont:Post a owl:Class ;
    rdfs:comment "A piece of user-generated content published on a social media platform." ;
    rdfs:subClassOf ont:UserGeneratedContent .


ont:PowerPlant a owl:Class ;
    rdfs:comment "An industrial facility for the generation of electric power." ;
    rdfs:subClassOf ont:Facility .

ont:PrivateBankStock a owl:Class ;
    rdfs:comment "A classification for the equity shares of a banking institution that is not state-owned." ;
    rdfs:subClassOf ont:Stock .

ont:PrivateCloudEnvironment a owl:Class ;
    rdfs:comment "A type of cloud computing infrastructure operated exclusively for a single organization." ;
    rdfs:subClassOf ont:CloudEnvironment ;
    owl:disjointWith ont:PublicCloudEnvironment .

ont:PrivateEquityFirm a owl:Class ;
    rdfs:comment "An investment management company that provides capital and acquires stakes in private or public companies, often taking them private." ;
    rdfs:subClassOf ont:Company .

ont:PrivateLabelBrand a owl:Class ;
    rdfs:comment "A brand owned and sold by a retailer or supplier, as opposed to a manufacturer's brand." ;
    rdfs:subClassOf ont:Brand .

ont:Problem a owl:Class ;
    rdfs:comment "A harmful or undesirable situation that requires a solution." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:Metric , ont:Role , ont:Solution , ont:Technique .

ont:Product a owl:Class ;
    rdfs:comment "A specific, manufactured item or service offered for sale." ;
    rdfs:subClassOf ont:ConcreteEntity ;
    owl:disjointWith ont:UserGeneratedContent .

ont:ProductChange a owl:Class ;
    rdfs:comment "A significant alteration to a company's service or offering, often implemented as a direct consequence of a new strategic direction." ;
    rdfs:subClassOf ont:CorporateEvent ;
    owl:disjointWith ont:BrandingChange , ont:CorporateTakeover .


ont:ProductRecall a owl:Class ;
    rdfs:comment "The action of requesting the return of a batch or an entire production run of a product, typically due to safety concerns or defects." ;
    rdfs:subClassOf ont:Event .

ont:ProductSuite a owl:Class ;
    rdfs:comment "A collection of related software applications bundled and sold together by a single company." ;
    rdfs:subClassOf ont:Software ;
    owl:disjointWith ont:SoftwareTool .

ont:ProductionEvent a owl:Class ;
    rdfs:comment "A significant milestone related to the manufacturing of a product, such as the start of mass production." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Transaction .

ont:Professional a owl:Class ;
    rdfs:comment "A person engaged in a specified activity as one's main paid occupation rather than as a pastime." ;
    rdfs:subClassOf ont:Person .

ont:ProfessionalOrganization a owl:Class ;
    rdfs:comment "An association that seeks to further a particular profession and the interests of individuals engaged in that profession." ;
    rdfs:subClassOf ont:Organization .

ont:Program a owl:Class ;
    rdfs:comment "A planned series of future events or activities." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:Market , ont:Metric , ont:Plan , ont:Role , ont:Sport .

ont:Project a owl:Class ;
    rdfs:comment "A planned piece of work that is designed to achieve a particular aim within a company." ;
    rdfs:subClassOf ont:Event .

ont:Promotion a owl:Class ;
    rdfs:comment "An event where an employee is advanced to a higher-level position within an organization, often impacting leadership structure." ;
    rdfs:subClassOf ont:PersonnelChange ;
    owl:disjointWith ont:Resignation .

ont:Property a owl:Class ;
    rdfs:comment "A building or area of land, or both together." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:ProposedSolution a owl:Class ;
    rdfs:comment "A recommended action or strategy intended to address a specific problem, such as gender disparity in the workplace." ;
    rdfs:subClassOf ont:Plan .

ont:Protest a owl:Class ;
    rdfs:comment "A public event where people gather to express their opposition to a policy or situation, such as the housing crisis." ;
    rdfs:subClassOf ont:Incident ;
    owl:disjointWith ont:ThreatIncident .

ont:Proxy a owl:Class ;
    rdfs:comment "A formal document filed by a public company with regulators, providing shareholders with information ahead of a vote on major corporate actions like a merger or sale." ;
    rdfs:subClassOf ont:Document .

ont:PublicCloudEnvironment a owl:Class ;
    rdfs:comment "A type of cloud computing infrastructure where services are delivered over the public internet and shared across organizations." ;
    rdfs:subClassOf ont:CloudEnvironment .

ont:PublicCompany a owl:Class ;
    rdfs:comment "A company whose shares are traded on a public stock exchange and is subject to regulatory disclosure requirements." ;
    rdfs:subClassOf ont:Company .

ont:PublicHousingPolicy a owl:Class ;
    rdfs:comment "A government strategy aimed at providing affordable housing to low-income residents." ;
    rdfs:subClassOf ont:HousingPolicy .

ont:PublicRecord a owl:Class ;
    rdfs:comment "Official documents and filings available to the public, such as court records or government reports, that can substantiate claims or events." ;
    rdfs:subClassOf ont:Document .

ont:PublicRelations a owl:Class ;
    rdfs:comment "The professional maintenance of a favorable public image by a company or organization, impacting market perception." ;
    rdfs:subClassOf ont:Marketing .

ont:PublicTransportation a owl:Class ;
    rdfs:comment "Shared passenger-transport services available for use by the general public, relevant to accessing essential services like grocery stores and pharmacies." ;
    rdfs:subClassOf ont:Service .

ont:Publication a owl:Class ;
    rdfs:comment "A written work, such as a playbook or handbook, made available to the public to provide guidance and information on a topic." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Company , ont:GovernmentAgency , ont:InvestmentFirm , ont:MarketResearchFirm , ont:ResearchInstitute , ont:Service , ont:Software , ont:UtilityCompany , ont:Website .

ont:PublicationEvent a owl:Class ;
    rdfs:comment "An event where information is made available to the public." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:RegulatoryEvent .

ont:QualityFood a owl:Class ;
    rdfs:comment "Food items that meet certain standards of freshness, nutritional value, and safety, the availability of which is a community concern." ;
    rdfs:subClassOf ont:Food .

ont:RacingProgram a owl:Class ;
    rdfs:comment "A program for racing." ;
    rdfs:subClassOf ont:Program .

ont:RacistAbuse a owl:Class ;
    rdfs:comment "Abuse directed at a person on the basis of their race or ethnicity." ;
    rdfs:subClassOf ont:Type .

ont:RealEstateActivity a owl:Class ;
    rdfs:comment "An action related to the property market, such as converting residential units into tourist accommodations." ;
    rdfs:subClassOf ont:Event .

ont:RealEstateServicesFirm a owl:Class ;
    rdfs:comment "A company specializing in commercial real estate services and investment, the primary entity being analyzed." ;
    rdfs:subClassOf ont:Company .

ont:Reaffirmation a owl:Class ;
    rdfs:comment "An act of confirming or restating a previously made observation or statement, reinforcing its significance." ;
    rdfs:subClassOf ont:SpeechAct .

ont:Rebranding a owl:Class ;
    rdfs:comment "A significant market event where a company changes its corporate image, including its name, logo, and strategic direction." ;
    rdfs:subClassOf ont:Event .

ont:RecreationalMarket a owl:Class ;
    rdfs:comment "A market for recreational products and services." ;
    rdfs:subClassOf ont:Market .

ont:Region a owl:Class ;
    rdfs:comment "A spatial or abstract area that may have defined boundaries or extents. Typically a subclass of ConcreteEntity representing a portion of space or territory."@en ;
    rdfs:subClassOf ont:GeopoliticalEntity .

ont:RegulatoryAgency a owl:Class ;
    rdfs:comment "A governmental authority that is responsible for exercising autonomous authority over some area of human activity in a regulatory or supervisory capacity." ;
    rdfs:subClassOf ont:GovernmentAgency .

ont:RegulatoryApproval a owl:Class ;
    rdfs:comment "A formal decision by a regulatory body granting permission for a specific activity, which can be a significant market-moving event." ;
    rdfs:subClassOf ont:Approval , ont:RegulatoryEvent .

ont:RegulatoryBody a owl:Class ;
    rdfs:comment "A government agency or other official entity responsible for exercising autonomous authority over some area of corporate or economic activity." ;
    rdfs:subClassOf ont:GovernmentBody .

ont:RegulatoryEvent a owl:Class ;
    rdfs:comment "An event related to the activities of a regulatory body." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:Deliberation , ont:PublicationEvent .

ont:RehousingProgram a owl:Class ;
    rdfs:comment "A government-led initiative to provide new homes for individuals or families displaced by demolition or other events." ;
    rdfs:subClassOf ont:Plan .

ont:RenewableEnergy a owl:Class ;
    rdfs:comment "An uninstantiated concept for energy derived from naturally replenishing resources, such as solar or wind." ;
    rdfs:subClassOf ont:EnergyTechnology .

ont:RentPayment a owl:Class ;
    rdfs:comment "The recurring fee paid by a tenant to a landlord for the use of a property." ;
    rdfs:subClassOf ont:Payment .

ont:RentSubsidy a owl:Class ;
    rdfs:comment "Financial assistance provided by the government to help low-income individuals afford rent." ;
    rdfs:subClassOf ont:Subsidy .

ont:Report a owl:Class ;
    rdfs:comment "A formal written account or article, often containing data or analysis, that can act as a market-moving event." ;
    rdfs:subClassOf ont:Publication .

ont:ReportPublication a owl:Class ;
    rdfs:comment "An event where a formal document containing analysis and findings on a particular subject is made public, influencing market sentiment or policy discussion." ;
    rdfs:subClassOf ont:PublicationEvent .

ont:ResalePolicy a owl:Class ;
    rdfs:comment "The set of rules and conditions governing the secondary sale of tickets for an event." ;
    rdfs:subClassOf ont:LegalDocument .

ont:ResearchAndDevelopment a owl:Class ;
    rdfs:comment "Work directed towards the innovation, introduction, and improvement of products and processes." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:ResearchInstitute a owl:Class ;
    rdfs:comment "An establishment endowed for doing research, particularly in scientific or technological fields like energy." ;
    rdfs:subClassOf ont:Organization ;
    owl:disjointWith ont:UtilityCompany .

ont:Residence a owl:Class ;
    rdfs:comment "A place where someone lives, such as a flat or house." ;
    rdfs:subClassOf ont:Property .

ont:ResidencePermit a owl:Class ;
    rdfs:comment "An official document granting a foreign national permission to live in a country for a specified period." ;
    rdfs:subClassOf ont:LegalDocument .

ont:Resident a owl:Class ;
    rdfs:comment "A person who lives somewhere permanently or on a long-term basis." ;
    rdfs:subClassOf ont:Person .

ont:Resignation a owl:Class ;
    rdfs:comment "The formal act of an executive stepping down from their position, which can be a significant market-moving event." ;
    rdfs:subClassOf ont:CareerEvent , ont:PersonnelChange .

ont:Restaurant a owl:Class ;
    rdfs:comment "A place where people pay to sit and eat meals that are cooked and served on the premises." ;
    rdfs:subClassOf ont:BusinessPremises ;
    owl:disjointWith ont:Retailer .

ont:RetailClient a owl:Class ;
    rdfs:comment "An individual consumer who purchases satellite or telecom services." ;
    rdfs:subClassOf ont:Client .

ont:RetailCompany a owl:Class ;
    rdfs:comment "A business entity primarily focused on selling goods directly to consumers, whose performance is a key indicator of market trends." ;
    rdfs:subClassOf ont:Company .

ont:RetailEstablishment a owl:Class ;
    rdfs:comment "A business that sells goods or services directly to consumers." ;
    rdfs:subClassOf ont:Company .

ont:Retailer a owl:Class ;
    rdfs:comment "A business or person that sells goods directly to consumers, either online or through physical stores." ;
    rdfs:subClassOf ont:Company .

ont:ReturnOnInvestment a owl:Class ;
    rdfs:comment "A performance measure used to evaluate the efficiency or profitability of an investment." ;
    rdfs:subClassOf ont:Metric .

ont:Revenue a owl:Class ;
    rdfs:comment "The total income generated by a company from its business operations." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:RideHailingService a owl:Class ;
    rdfs:comment "A type of on-demand transportation service whose business model and market performance are subjects of analysis." ;
    rdfs:subClassOf ont:Service .

ont:RiderAppInstall a owl:Class ;
    rdfs:comment "The event of a user successfully downloading and installing a ride-sharing application, used as a key performance indicator for advertisers like Uber." ;
    rdfs:subClassOf ont:Event .

ont:RivalProvider a owl:Class ;
    rdfs:comment "A category of companies that offer competing products or services within the same market." ;
    rdfs:subClassOf ont:Agent .

ont:Role a owl:Class ;
    rdfs:comment "A specific function, title, or position held by a person or party within an organization or in a particular context, defining their responsibilities and influence." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:DemographicGroup , ont:Energy , ont:FinancialConcept , ont:Indicator , ont:Law , ont:Market , ont:Metric , ont:Plan , ont:Problem , ont:Program , ont:Scheme , ont:Solution , ont:SpeechAct , ont:Sport , ont:StockAward , ont:Strategy , ont:Technique , ont:Trend , ont:Type , ont:WealthCreation .

ont:Rule a owl:Class ;
    rdfs:comment "A principle or regulation governing conduct or procedure within a particular area of activity." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Term .

ont:RuralArea a owl:Class ;
    rdfs:comment "A geographic area located outside towns and cities, often characterized by limited access to services like grocery stores and pharmacies." ;
    rdfs:subClassOf ont:Place .

ont:Salary a owl:Class ;
    rdfs:comment "A fixed regular payment earned by an individual for their employment." ;
    rdfs:subClassOf ont:Payment .

ont:Salesforce a owl:Class ;
    rdfs:comment "A customer relationship management (CRM) platform used by companies to manage sales, service, and marketing data." ;
    rdfs:subClassOf ont:Platform .

ont:SatelliteInfrastructure a owl:Class ;
    rdfs:comment "The physical and technological assets, such as satellites and ground stations, used to provide communication services." ;
    rdfs:subClassOf ont:Infrastructure .

ont:SatelliteOperator a owl:Class ;
    rdfs:comment "A company that owns and manages satellite infrastructure to provide communication services." ;
    rdfs:subClassOf ont:TelecommunicationsCompany ;
    owl:disjointWith ont:UsCarrier .

ont:Scheme a owl:Class ;
    rdfs:comment "A large-scale systematic plan or arrangement for attaining a particular object or putting a particular idea into effect." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:SeedFunding a owl:Class ;
    rdfs:comment "The initial capital used to start a business, often provided by investors in exchange for an equity stake." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:Seminar a owl:Class ;
    rdfs:comment "An educational event or conference where knowledge and insights, often related to business, are shared." ;
    rdfs:subClassOf ont:EducationalEvent .

ont:SeniorLeadershipTalentIdentification a owl:Class ;
    rdfs:comment "The strategic process of finding and cultivating individuals with the potential to become future leaders of the organization." ;
    rdfs:subClassOf ont:TalentManagement ;
    owl:disjointWith ont:SuccessionPlanning .

ont:SeniorManagement a owl:Class ;
    rdfs:comment "The highest level of executives within an organization, responsible for overall strategy and governance." ;
    rdfs:subClassOf ont:Role .

ont:Service a owl:Class ;
    rdfs:comment "A system supplying a public need or a commercial transaction involving labor with no physical goods." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Software , ont:Technology .

ont:Settlement a owl:Class ;
    rdfs:comment "An officially recognized populated place, such as a city or town." ;
    rdfs:subClassOf ont:GeopoliticalEntity ;
    owl:disjointWith ont:Region .

ont:ShortTermRental a owl:Class ;
    rdfs:comment "A furnished property rented out for a brief period, typically to tourists, as an alternative to a hotel." ;
    rdfs:subClassOf ont:Residence .

ont:Situation a owl:Class ;
    rdfs:comment "A set of circumstances or a state of affairs, often involving relationships between entities over a period of time." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:SmallBusiness a owl:Class ;
    rdfs:comment "A privately owned and operated enterprise with a small number of employees and relatively low volume of sales, considered in the context of market competition." ;
    rdfs:subClassOf ont:Organization .

ont:SocialEvent a owl:Class ;
    rdfs:comment "A planned public or social occasion." ;
    rdfs:subClassOf ont:Event .

ont:SocialHousing a owl:Class ;
    rdfs:comment "Housing provided by the state or non-profit organizations for people with low incomes." ;
    rdfs:subClassOf ont:Residence .

ont:SocialIssue a owl:Class ;
    rdfs:comment "A problem that influences a considerable number of individuals within a society, such as systemic bias." ;
    rdfs:subClassOf ont:Issue ;
    owl:disjointWith ont:WorkplaceIssue .

ont:SocialMediaCompany a owl:Class ;
    rdfs:comment "A type of company that operates an online platform for public communication and is the subject of a market-moving takeover." ;
    rdfs:subClassOf ont:Company .

ont:SocialMediaPlatform a owl:Class ;
    rdfs:comment "A digital service, website or application that facilitates the creation and sharing of information and content among users." ;
    rdfs:subClassOf ont:WebPlatform .

ont:SocialMediaPost a owl:Class ;
    rdfs:comment "A user-generated content item shared on a social media platform." ;
    rdfs:subClassOf ont:Communication .

ont:SocialNetwork a owl:Class ;
    rdfs:comment "An online platform that people use to build social relationships with others, which can also serve as a forum for community discussion and information sharing." ;
    rdfs:subClassOf ont:Platform .

ont:SodiumBasedBattery a owl:Class ;
    rdfs:comment "An uninstantiated concept for a class of battery technologies that use sodium as a key chemical component." ;
    rdfs:subClassOf ont:Battery ;
    owl:disjointWith ont:ZincBasedBattery .

ont:Software a owl:Class ;
    rdfs:comment "A set of instructions, data, or programs used to operate computers and execute specific tasks." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:TicketingAsset .

ont:SoftwareAgent a owl:Class ;
    rdfs:comment "An autonomous computer program that carries out tasks on behalf of a user or another program." ;
    rdfs:subClassOf ont:Agent .

ont:SoftwareAsAService a owl:Class ;
    rdfs:comment "A software licensing and delivery model in which software is licensed on a subscription basis and is centrally hosted, a key part of the cloud market." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:SoftwareCompany a owl:Class ;
    rdfs:comment "A company that primarily creates and sells software." ;
    rdfs:subClassOf ont:Company .

ont:SoftwareDevelopment a owl:Class ;
    rdfs:comment "The process of creating and maintaining applications and systems, a core activity for technology companies." ;
    rdfs:subClassOf ont:Technology .

ont:SoftwareTool a owl:Class ;
    rdfs:comment "A specific application or program designed for a particular purpose." ;
    rdfs:subClassOf ont:Software .

ont:SolarPowerFacility a owl:Class ;
    rdfs:comment "An uninstantiated concept for a power plant that generates electricity from sunlight, often paired with energy storage." ;
    rdfs:subClassOf ont:PowerPlant .

ont:Solution a owl:Class ;
    rdfs:comment "A product, standard, or methodology designed to solve or mitigate a problem, such as technologies developed to combat ad fraud." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Metric , ont:Problem , ont:Role , ont:Technique .

ont:SpeechAct a owl:Class ;
    rdfs:comment "An utterance considered as an action, particularly with regard to its intention, purpose, or effect." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:DemographicGroup , ont:EconomicConcept , ont:EconomicTrend , ont:Metric , ont:Role .

ont:Spider a owl:Class ;
    rdfs:comment "An automated program that systematically browses the internet, which can be a source of invalid traffic." ;
    rdfs:subClassOf ont:SoftwareAgent .

ont:Spinoff a owl:Class ;
    rdfs:comment "A type of corporate reorganization where a company creates a new, independent entity from a part of its existing business." ;
    rdfs:subClassOf ont:CorporateEvent .

ont:Sport a owl:Class ;
    rdfs:comment "An activity involving physical exertion and skill in which an individual or team competes against another or others for entertainment." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Brand , ont:Market , ont:Metric , ont:Plan , ont:Program , ont:Role .

ont:SportingEvent a owl:Class ;
    rdfs:comment "A major organized competition, such as a championship, whose outcome can be a major milestone for an owned asset like a sports team." ;
    rdfs:subClassOf ont:Event .

ont:SportsTeam a owl:Class ;
    rdfs:comment "A professional athletic organization or national selection of athletes that is treated as a significant business asset." ;
    rdfs:subClassOf ont:Group , ont:Organization .

ont:StapleProduct a owl:Class ;
    rdfs:comment "A basic, essential good, such as flour or rice, that is a core offering in the grocery and B2B wholesale market." ;
    rdfs:subClassOf ont:Product .

ont:Startup a owl:Class ;
    rdfs:comment "A young company founded to develop a unique product or service, typically in a high-growth sector like new energy technology." ;
    rdfs:subClassOf ont:Company .

ont:State a owl:Class ;
    rdfs:comment "A constituent political entity of a federal government, such as one of the United States." ;
    rdfs:subClassOf ont:AdministrativeDivision .

ont:Statement a owl:Class ;
    rdfs:comment "An official public communication, declaration or expression made by a party involved in a market event." ;
    rdfs:subClassOf ont:Communication ;
    owl:disjointWith ont:SocialMediaPost .

ont:StatisticalMetric a owl:Class ;
    rdfs:comment "A quantifiable measure used to track, analyze, and report on a specific issue or trend, such as gender gaps." ;
    rdfs:subClassOf ont:Metric .

ont:Stock a owl:Class ;
    rdfs:comment "The capital raised by a business or corporation through the issue and subscription of shares." ;
    rdfs:subClassOf ont:FinancialInstrument ;
    owl:disjointWith ont:StockIndex .

ont:StockAward a owl:Class ;
    rdfs:comment "A form of non-cash compensation granting an executive ownership of company stock, often unvested and tied to performance or tenure." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:CausalFactor , ont:Indicator , ont:Metric , ont:Role , ont:Trend .

ont:StockExchange a owl:Class ;
    rdfs:comment "A marketplace where securities like stocks and bonds are bought and sold, such as NASDAQ." ;
    rdfs:subClassOf ont:Organization .

ont:StockIndex a owl:Class ;
    rdfs:comment "A statistical measure that tracks the performance of a specific group of stocks, representing a particular market or sector." ;
    rdfs:subClassOf ont:FinancialInstrument .

ont:StockPrice a owl:Class ;
    rdfs:comment "The market value of a single share of a publicly traded company's stock, which is directly impacted by market-moving events." ;
    rdfs:subClassOf ont:Metric .

ont:StockPriceMovement a owl:Class ;
    rdfs:comment "The change in the market price of a specific company's stock over a defined period, often in reaction to a market-moving event." ;
    rdfs:subClassOf ont:Movement .

ont:Strategy a owl:Class ;
    rdfs:comment "A plan of action or policy designed to achieve a major or overall aim." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:MarketConcept , ont:Role .

ont:StreamingTvService a owl:Class ;
    rdfs:comment "A category of service providing television content over the internet, representing a modern evolution of the pay-TV business." ;
    rdfs:subClassOf ont:TelevisionService .

ont:Street a owl:Class ;
    rdfs:comment "A public road in a city, used as a specific address detail for a corporate location." ;
    rdfs:subClassOf ont:Infrastructure .

ont:StrategicPlan a owl:Class ;
    rdfs:comment "A formal document outlining an organization's long-term goals and priorities, particularly for athlete development and competitive success." ;
    rdfs:subClassOf ont:Plan .

ont:Substance a owl:Class ;
    rdfs:comment "Physical matter which has a uniform and definite composition." ;
    rdfs:subClassOf ont:ConcreteEntity .

ont:SubstanceClassification a owl:Class ;
    rdfs:comment "A scientific or regulatory grouping for a chemical based on its known effects, such as its potential to cause disease." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:Subsidy a owl:Class ;
    rdfs:comment "Financial aid supplied by a government to support a specific group or industry, such as rent support for tenants." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:SuccessionPlanning a owl:Class ;
    rdfs:comment "The corporate strategy for identifying and developing internal talent to fill key leadership positions in the future." ;
    rdfs:subClassOf ont:TalentManagement .

ont:SustainabilityFocusedRole a owl:Class ;
    rdfs:comment "A professional position primarily concerned with environmental responsibility and long-term ecological balance." ;
    rdfs:subClassOf ont:Role .

ont:TalentManagement a owl:Class ;
    rdfs:comment "The strategic management of the flow of talent through an organization, including recruitment, development, and retention." ;
    rdfs:subClassOf ont:Strategy .

ont:TangibleCrime a owl:Class ;
    rdfs:comment "Criminal acts that occur in the physical world, such as drug trafficking or terrorism, which can be financed by profits from cybercrime like ad fraud." ;
    rdfs:subClassOf ont:Crime .

ont:TaxPolicy a owl:Class ;
    rdfs:comment "A government strategy related to taxation, which can be used to attract foreign residents and investment." ;
    rdfs:subClassOf ont:GovernmentPolicy .

ont:TaxWriteoff a owl:Class ;
    rdfs:comment "A reduction in taxable income for a given year." ;
    rdfs:subClassOf ont:FinancialConcept .

ont:Teacher a owl:Class ;
    rdfs:comment "An educator, representing a class of essential workers who may be priced out of urban housing markets." ;
    rdfs:subClassOf ont:Role .

ont:TechGlitch a owl:Class ;
    rdfs:comment "A malfunction or error in a technology system, which can be presented as a reason for data discrepancies or service failures." ;
    rdfs:subClassOf ont:TechnicalIssue .

ont:TechnicalIssue a owl:Class ;
    rdfs:comment "A problem or fault within a technological system." ;
    rdfs:subClassOf ont:Event .

ont:Technique a owl:Class ;
    rdfs:comment "A way of carrying out a particular task, especially the execution or performance of an artistic work or a scientific procedure." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Budget , ont:Metric , ont:Problem , ont:Role , ont:Solution .

ont:Technology a owl:Class ;
    rdfs:comment "The application of scientific knowledge for practical purposes, especially in industry; includes machinery, equipment, and systems." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:WindTurbine .

ont:TechnologyFirm a owl:Class ;
    rdfs:comment "A commercial enterprise focused on developing, manufacturing, or selling technology products and services." ;
    rdfs:subClassOf ont:Company .

ont:TelecommunicationService a owl:Class ;
    rdfs:comment "A service that provides communication at a distance by technological means, particularly through electronic signals or electromagnetic waves." ;
    rdfs:subClassOf ont:Service ;
    owl:disjointWith ont:TelevisionService .

ont:TelecommunicationsCompany a owl:Class ;
    rdfs:comment "A company that provides telecommunication services." ;
    rdfs:subClassOf ont:Company .

ont:TelevisionService a owl:Class ;
    rdfs:comment "A service for broadcasting or distributing television programs." ;
    rdfs:subClassOf ont:Service .

ont:Term a owl:Class ;
    rdfs:comment "A word or phrase with a specific meaning within the context of a platform, which can be altered during a rebranding." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:TermsOfService a owl:Class ;
    rdfs:comment "The rules and conditions that users must agree to in order to use a company's service, which may be altered following a corporate event." ;
    rdfs:subClassOf ont:LegalDocument .

ont:TextMessage a owl:Class ;
    rdfs:comment "A message sent via a Short Message Service (SMS)." ;
    rdfs:subClassOf ont:Communication .

ont:ThreatIncident a owl:Class ;
    rdfs:comment "A specific event where a statement or action expresses an intention to inflict harm, pain, or damage on an executive." ;
    rdfs:subClassOf ont:Incident .

ont:TicketingAsset a owl:Class ;
    rdfs:comment "A valuable resource or component related to the sale and distribution of event tickets." ;
    rdfs:subClassOf ont:Product .

ont:TicketingSoftware a owl:Class ;
    rdfs:comment "The computer programs and systems used to manage the sale, distribution, and validation of event tickets." ;
    rdfs:subClassOf ont:Software .

ont:Town a owl:Class ;
    rdfs:comment "A populated area with fixed boundaries and a local government, smaller than a city, often facing unique challenges regarding access to essential services." ;
    rdfs:subClassOf ont:Settlement .

ont:TradeGroup a owl:Class ;
    rdfs:comment "An organization founded and funded by businesses that operate in a specific industry to provide research, advocacy, and data." ;
    rdfs:subClassOf ont:Organization .

ont:TradeShow a owl:Class ;
    rdfs:comment "A large-scale industry exhibition where companies showcase and demonstrate their latest products and services." ;
    rdfs:subClassOf ont:Gathering .

ont:Transaction a owl:Class ;
    rdfs:comment "An instance of buying, selling, or exchanging something; a business deal or financial event." ;
    rdfs:subClassOf ont:Event ;
    owl:disjointWith ont:EducationalEvent .

ont:Trend a owl:Class ;
    rdfs:comment "A general direction in which something is developing or changing." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:CausalFactor , ont:Indicator , ont:Metric , ont:Role , ont:StockAward .

ont:Tweet a owl:Class ;
    rdfs:comment "A public message posted on the social media platform X (formerly Twitter), which can be cited as evidence or context in legal or corporate disputes." ;
    rdfs:subClassOf ont:SocialMediaPost .

ont:Type a owl:Class ;
    rdfs:comment "A category or kind, used to classify other entities." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:University a owl:Class ;
    rdfs:comment "An institution of higher education and research that can provide training, background, or expert analysis on market-relevant activities." ;
    rdfs:subClassOf ont:EducationalInstitution .

ont:Upstart a owl:Class ;
    rdfs:comment "A new, often smaller, company that challenges established competitors in a market." ;
    rdfs:subClassOf ont:Company .

ont:UsCarrier a owl:Class ;
    rdfs:comment "A major telecommunications company operating within the United States, often a competitor to companies involved in market-moving events." ;
    rdfs:subClassOf ont:TelecommunicationsCompany .

ont:UserAgent a owl:Class ;
    rdfs:comment "A string of text that a web browser or other client software sends to a web server, which can be manipulated in ad fraud schemes." ;
    rdfs:subClassOf ont:Identifier .

ont:UserEngagementMetric a owl:Class ;
    rdfs:comment "A key performance indicator used to measure the level of interaction and involvement users have with a digital product or service." ;
    rdfs:subClassOf ont:Metric .

ont:UserGeneratedContent a owl:Class ;
    rdfs:comment "Any form of content, such as images, videos, text, and audio, that has been posted by users on online platforms." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:UtilityCompany a owl:Class ;
    rdfs:comment "An organization that maintains the infrastructure for a public service and is a key customer for energy storage technologies." ;
    rdfs:subClassOf ont:Company .

ont:Vehicle a owl:Class ;
    rdfs:comment "A machine used for transporting people or goods, especially on land, such as a car, truck, or cart." ;
    rdfs:subClassOf ont:Product ;
    owl:disjointWith ont:WebPlatform .

ont:VehicleModel a owl:Class ;
    rdfs:comment "A specific design or version of a vehicle produced by a manufacturer, such as the Model S or Roadster." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Vendor a owl:Class ;
    rdfs:comment "An organization that sells goods or services." ;
    rdfs:subClassOf ont:Organization .

ont:VentureCapitalist a owl:Class ;
    rdfs:comment "An investor who provides capital to firms that exhibit high growth potential in exchange for an equity stake." ;
    rdfs:subClassOf ont:Role .

ont:Venue a owl:Class ;
    rdfs:comment "A physical place, such as a stadium or theater, where live entertainment events are held." ;
    rdfs:subClassOf ont:Place .

ont:Video a owl:Class ;
    rdfs:comment "A category of digital content or interaction based on moving images, forming a core component of a multifaceted platform." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Visa a owl:Class ;
    rdfs:comment "An official document or endorsement in a passport permitting the holder to enter, leave, or stay for a specified period of time in a country." ;
    rdfs:subClassOf ont:LegalConcept .

ont:VirtualMachine a owl:Class ;
    rdfs:comment "A software-based emulation of a computer system, a foundational element of cloud computing technology." ;
    rdfs:subClassOf ont:CloudTechnology .

ont:Visitor a owl:Class ;
    rdfs:comment "A person temporarily visiting a place for leisure or business, contributing to the demand for short-term rentals." ;
    rdfs:subClassOf ont:Person .

ont:WallStreet a owl:Class ;
    rdfs:comment "A street in Lower Manhattan that is the original home of the New York Stock Exchange; used to refer to the financial markets of the United States as a whole." ;
    rdfs:subClassOf ont:Infrastructure .

ont:Warning a owl:Class ;
    rdfs:comment "An official statement or advisory cautioning about a potential negative outcome or crisis." ;
    rdfs:subClassOf ont:Communication .

ont:Weapon a owl:Class ;
    rdfs:comment "An object designed or used for inflicting bodily harm or physical damage." ;
    rdfs:subClassOf ont:Product .

ont:WealthCreation a owl:Class ;
    rdfs:comment "The process of generating significant financial assets, representing a major subsequent impact of a successful market event like an acquisition." ;
    rdfs:subClassOf ont:AbstractConcept ;
    owl:disjointWith ont:Role .

ont:WebPlatform a owl:Class ;
    rdfs:comment "A software-based platform accessible via the internet." ;
    rdfs:subClassOf ont:DigitalPlatform .

ont:Website a owl:Class ;
    rdfs:comment "An online destination, typically a collection of related web pages under a single domain name." ;
    rdfs:subClassOf ont:DigitalProduct .

ont:Wedding a owl:Class ;
    rdfs:comment "The ceremony and celebration of a marriage, which forms the core of a multi-billion dollar industry." ;
    rdfs:subClassOf ont:LifeMilestone .

ont:WeddingGown a owl:Class ;
    rdfs:comment "A dress worn by a bride during a wedding ceremony, a key product category in the bridal market." ;
    rdfs:subClassOf ont:Clothing .

ont:WeddingPlanningGiant a owl:Class ;
    rdfs:comment "A very large and dominant company in the business of providing wedding-related services and media." ;
    rdfs:subClassOf ont:Company .

ont:Whistleblower a owl:Class ;
    rdfs:comment "An insider who exposes misconduct, allegations of fraud, or illicit activity occurring within an organization to the public or a regulatory authority." ;
    rdfs:subClassOf ont:Role .

ont:WindTurbine a owl:Class ;
    rdfs:comment "An uninstantiated concept for a device that converts wind's kinetic energy into electrical energy, often paired with storage." ;
    rdfs:subClassOf ont:Product .

ont:Woman a owl:Class ;
    rdfs:comment "An adult female human being." ;
    rdfs:subClassOf ont:DemographicGroup .

ont:WorkCulture a owl:Class ;
    rdfs:comment "The collective attitudes, beliefs, and behaviors that constitute the normative environment within a workplace or industry region." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:WorkLifeBalance a owl:Class ;
    rdfs:comment "The state of equilibrium where a person equally prioritizes the demands of one's career and personal life." ;
    rdfs:subClassOf ont:SituationOrProcess .

ont:WorkModel a owl:Class ;
    rdfs:comment "A framework defining how and where work is performed, such as remote, hybrid, or in-office." ;
    rdfs:subClassOf ont:AbstractConcept .

ont:Workload a owl:Class ;
    rdfs:comment "The amount of processing that a computer has been given to do at a particular time." ;
    rdfs:subClassOf ont:Product .

ont:Workplace a owl:Class ;
    rdfs:comment "The environment or setting in which people perform their jobs." ;
    rdfs:subClassOf ont:Place .

ont:WorkplaceIssue a owl:Class ;
    rdfs:comment "A problem or challenge that affects employees' well-being, satisfaction, or performance within their work environment." ;
    rdfs:subClassOf ont:Issue .

ont:YoungProfessional a owl:Class ;
    rdfs:comment "A person in the early stages of their career, often facing challenges in finding affordable housing in major cities." ;
    rdfs:subClassOf ont:Professional .

ont:ZincBasedBattery a owl:Class ;
    rdfs:comment "An uninstantiated concept for a class of battery technologies that use zinc as a key chemical component." ;
    rdfs:subClassOf ont:Battery .

#################################################################
#    General Axioms
#################################################################

[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:AbstractConcept
        ont:Agent
        ont:ConcreteEntity
        ont:Event
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Brand
        ont:Software
        ont:StapleProduct
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:BusinessExpert
        ont:ExternalCounsel
        ont:LegalExpert
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:BusinessModel
        ont:Metric
        ont:Role
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:BusinessUnit
        ont:Company
        ont:GovernmentBody
        ont:Publication
        ont:Retailer
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:ChiefMarketingOfficer
        ont:Executive
        ont:Expert
        ont:InternalCounsel
        ont:SeniorManagement
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:City
        ont:State
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Communication
        ont:FinancialConcept
        ont:Plan
        ont:Policy
        ont:Role
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Company
        ont:EducationalOrganization
        ont:GovernmentAgency
        ont:MediaOrganization
        ont:NonprofitOrganization
        ont:StockExchange
        ont:TradeGroup
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Contract
        ont:FinancialStatement
        ont:GovernmentFiling
        ont:Proxy
        ont:PublicRecord
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:CorporateGovernanceIssue
        ont:Layoff
        ont:Lawsuit
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:CourtHearing
        ont:Lawsuit
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:DigitalWallet
        ont:MobileApplication
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:EconomicPolicy
        ont:HousingPolicy
        ont:ImmigrationPolicy
        ont:TaxPolicy
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:EntityTypeRole
        ont:PoliticalRole
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:FamilyLeave
        ont:MedicalLeave
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:GeopoliticalEntity
        ont:Infrastructure
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Group
        ont:Organization
        ont:Person
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:GroupOfPeople
        ont:OnlineCommunity
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:KiranaStore
        ont:OfflineStore
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:LegalAction
        ont:PolicyChange
        ont:Protest
        ont:RealEstateActivity
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:LegalProceeding
        ont:LegalRuling
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Organization
        ont:Person
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:PerformanceMetric
        ont:UserEngagementMetric
    )
] .
[
    a owl:AllDisjointClasses ;
    owl:members (
        ont:Role
        ont:Type
    )
] .

ont:Court owl:disjointWith ont:GovernmentAgency .
ont:Product owl:disjointWith ont:Service .